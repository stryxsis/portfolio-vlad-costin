# Modulo di /contatti (api/contatti.ts). Su Vercel: Settings → Environment Variables.
# Obbligatoria: la chiave API di Resend.
RESEND_API_KEY=
# Facoltative.
# Dove arrivano i messaggi (default: info@vladcostin-developer.com).
CONTACT_TO=
# Mittente. Finché il dominio non è verificato su Resend lasciala vuota
# (vale onboarding@resend.dev, che scrive SOLO all'email dell'account Resend).
# Dopo la verifica, es.: Sito Vlad Costin <modulo@vladcostin-developer.com>
CONTACT_FROM=
# 1 = manda anche una conferma a chi scrive (richiede il dominio verificato).
CONTACT_CONFIRM=
