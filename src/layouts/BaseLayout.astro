---
/**
 * Lo scheletro di ogni pagina. Contiene l'unico <head> del sito e l'unico
 * punto in cui il CSS globale viene importato.
 */
import '../styles/global.css';

import Seo from '../components/head/Seo.astro';
import Fonts from '../components/head/Fonts.astro';
import Navbar from '../components/chrome/Navbar.astro';
import AnnouncementBanner from '../components/chrome/AnnouncementBanner.astro';
import Loader from '../components/chrome/Loader.astro';
import Footer from '../components/chrome/Footer.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import { SITE } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  jsonLd?: unknown;
  /** Classe extra sul <body>, per le pagine che partono su fondo diverso. */
  bodyClass?: string;
  /**
   * Il velo di prima visita (vedi Loader.astro). Solo la Home lo chiede: è
   * l'unica pagina con un ritratto a tutto schermo e una coreografia
   * d'ingresso da proteggere. Altrove sarebbe attesa costruita davanti a una
   * pagina che si dipinge già bene.
   */
  loader?: boolean;
}

const { bodyClass, loader = false, ...seo } = Astro.props;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <Seo {...seo} />
    <Fonts />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/*
      GATE DEL PRE-HIDING — inline, prima del paint.
      Le animazioni di ingresso nascondono il contenuto in CSS, ma SOLO sotto
      `html.js-anim`. Se il JS non gira (crawler, JS disattivato, errore di
      rete) o se l'utente ha chiesto meno movimento, la classe non viene
      aggiunta e il contenuto è visibile e completo dal primo frame.
      Deve stare qui e non in un modulo: un modulo è `defer` e il testo
      sfarfallerebbe.

      Il watchdog è l'assicurazione contro il caso peggiore: se il bundle non
      arriva o va in errore, `animReady` non viene mai impostato e la classe
      cade da sola, rendendo visibile tutto. Senza questo, un errore JS
      lascerebbe la pagina con il testo invisibile.
    */}
    <script is:inline>
      if (matchMedia('(prefers-reduced-motion: no-preference)').matches) {
        var r = document.documentElement;
        r.classList.add('js-anim');
        setTimeout(function () {
          if (r.dataset.animReady !== '1') r.classList.remove('js-anim');
        }, 2500);
      }
    </script>

    {/*
      GATE DELLA DENSITÀ DEL CAMPO BINARIO (/chi-sono) — inline e sincrono come
      i due qui sopra, e per lo stesso motivo: se il verdetto c'è già, va
      applicato PRIMA del primo paint. Applicarlo dopo vorrebbe dire disegnare
      mille cifre e poi vederne sparire tre quarti sotto gli occhi.

      ⚠ QUI NON SI DECIDE NIENTE: SI RILEGGE SOLTANTO. La prima stesura
      decideva proprio qui, guardando `hardwareConcurrency` e `deviceMemory`,
      e ha sbagliato sul primo PC vero — quello di Vlad, potente, si è
      ritrovato il fondale rado. Il difetto non era la soglia ma il metodo:
      quei due numeri non dicono quanto è veloce una macchina (4 core del 2013
      e 4 core di un Apple Silicon sono lo stesso valore, `deviceMemory` è
      tagliato a 8 e quindi cieco proprio in alto, e i browser attenti alla
      privacy li dichiarano FINTI e bassi apposta). A decidere è ora
      `campoBinario.ts`, che MISURA i fotogrammi mentre si scorre la hero —
      vedi lì il ragionamento per esteso.

      ⚠ Conseguenza voluta: alla PRIMA visita nessuna classe, cioè densità
      piena per tutti. Un dispositivo lento la tiene per il primo secondo di
      scroll e poi si alleggerisce da solo; un dispositivo veloce non viene
      declassato mai, il che è tutto il punto.
    */}
    <script is:inline>
      try {
        if (localStorage.getItem('vc:bf') === 'rado') {
          document.documentElement.classList.add('bf-rado');
        }
      } catch (e) {}
    </script>

    {/*
      PREFETCH AL PASSAGGIO DEL MOUSE, nativo (2026-10-12). Prende il posto del
      prefetch di Astro (vedi astro.config.mjs per il perché): `moderate` vuol
      dire «dopo ~200ms di hover, o al tocco», cioè la stessa strategia di
      prima. Solo prefetch, MAI prerender: una pagina pre-renderizzata
      eseguirebbe in sottofondo i suoi script (WebGL compreso). Chi non
      supporta le speculation rules (Firefox, Safari) semplicemente ignora il
      blocco e naviga come sempre. Non tocca la SEO: i crawler non la leggono.
    */}
    <script type="speculationrules" is:inline>
      {
        "prefetch": [
          {
            "where": { "and": [{ "href_matches": "/*" }, { "not": { "href_matches": "/api/*" } }] },
            "eagerness": "moderate"
          }
        ]
      }
    </script>

    {/*
      LA FINE DEL CAMBIO PAGINA (2026-10-12). Il lavoro pesante (oggi: lo
      shader del fondale di /portfolio) deve partire DOPO la transizione fra
      documenti, non durante. Misurato: compilare lo shader mentre la pagina
      nuova si sta rivelando faceva SALTARE la transizione verso /portfolio —
      sembrava un ricaricamento, mentre verso /chi-sono no. Bastava togliere
      WebGL perché tornasse.

      Inline e in <head> perché `pagereveal` scatta al primo fotogramma, e il
      bundle (`defer`) può arrivare dopo: ascoltarlo da lì vorrebbe dire
      perderlo. La promessa si risolve quando la transizione è FINITA; dove non
      c'è transizione (prima visita, Firefox, movimento ridotto) al secondo
      fotogramma. Chi la usa: `initLightfall()` in lightfall.ts.
    */}
    <script is:inline>
      /* `__rivelata`: subito dopo il primo fotogramma della pagina, quando la
         foto della pagina vecchia è già stata presa. La usa il caricamento del
         bundle, più sotto. */
      window.__rivelata = new Promise(function (fatto) {
        var una = false;
        function fine() {
          if (!una) {
            una = true;
            fatto();
          }
        }
        addEventListener(
          'pagereveal',
          function () {
            setTimeout(fine, 0);
          },
          { once: true }
        );
        requestAnimationFrame(function () {
          requestAnimationFrame(fine);
        });
      });
      window.__dopoRivelazione = new Promise(function (fatto) {
        var una = false;
        function fine(p) {
          if (!una) {
            una = true;
            fatto(p);
          }
        }
        addEventListener(
          'pagereveal',
          function (e) {
            fine(e.viewTransition ? e.viewTransition.finished.catch(function () {}) : null);
          },
          { once: true }
        );
        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            fine(null);
          });
        });
      });
    </script>

    {
      loader && (
        <script is:inline>
          {/*
            GATE DEL VELO DI PRIMA VISITA — inline e SINCRONO, come quello del
            pre-hiding qui sopra e per lo stesso identico motivo: la decisione
            deve essere presa prima del primo paint. Delegarla al bundle (che è
            `defer`) vorrebbe dire dipingere la pagina e POI coprirla, cioè
            esattamente il lampo che il velo esiste per evitare.

            Tre condizioni, tutte necessarie: movimento consentito, storage
            leggibile, e non essere già stati qui. `localStorage` in modalità
            privata può LANCIARE al solo accesso, non restituire null: senza il
            try/catch un'eccezione qui dentro fermerebbe lo script inline.

            ⚠ IL WATCHDOG NON È PRUDENZA. `ld-on` rende visibile un velo a
            schermo intero che solo il JS sa togliere: se il bundle non arriva
            (rete che cade, errore di parsing, estensione che lo blocca) la
            pagina resterebbe coperta PER SEMPRE. Stessa assicurazione del
            watchdog di `js-anim`, con un tetto più alto del MAX_WAIT di
            loader.ts (4s) così scatta solo se quel modulo è davvero assente.
            ⚠ La chiave è la stessa di `KEY` in loader.ts: cambiarne una sola
            significa mostrare il velo a ogni visita, per sempre.
          */}
          try {
            if (
              matchMedia('(prefers-reduced-motion: no-preference)').matches &&
              !localStorage.getItem('vc:seen')
            ) {
              var lr = document.documentElement;
              lr.classList.add('ld-on');
              setTimeout(function () {
                lr.classList.remove('ld-on');
              }, 6000);
            }
          } catch (e) {}
        </script>
      )
    }

    {/*
      L'UNICO SCRIPT DI ANIMAZIONE/INTERAZIONE del sito. Astro lo processa:
      TypeScript compilato, import npm risolti, bundle unico e deduplicato fra
      le pagine. Non è `is:inline` (che rinuncerebbe a bundling e TS) e non è
      un'isola (non c'è alcun framework da idratare).

      ⚠ "Unico" riguarda QUESTA categoria — non è più l'unico <script> del
      documento in senso letterale da quando sono arrivati Analytics/
      SpeedInsights qui sotto, ed è la distinzione che conta: quello resta il
      solo punto in cui vive la logica del sito (scroll, reveal, navbar…),
      loro sono telemetria di piattaforma, un'altra categoria.
    */}
    {/*
      ⚠ DAL 2026-10-12 IL BUNDLE SI CARICA DOPO CHE LA PAGINA SI È RIVELATA,
      non durante, ed è ciò che tiene in piedi il cambio pagina. Misurato via
      CDP: la pagina vecchia e la nuova sono dello stesso sito, quindi Chrome
      le fa girare nello STESSO processo, con un solo thread principale. Su una
      pagina leggera (/portfolio 54 KB, /contatti 32 KB) l'HTML finisce subito
      e i 240 KB di questo bundle si caricavano ed eseguivano proprio mentre il
      browser doveva fotografare la pagina vecchia: la foto arrivava tardi, la
      transizione veniva abortita («Document hidden») e il cambio sembrava un
      ricaricamento. Su /chi-sono no, solo perché i suoi 225 KB di HTML
      ritardavano il bundle quanto bastava. Prove ripetute: 2 su 6 riuscite
      prima, 5 su 6 dopo (le pagine minime di confronto fanno 5 su 5).
      `__rivelata` è la promessa dello script inline più sopra. Il bundle
      arriva comunque nel primo fotogramma utile, e nulla di ciò che il primo
      paint mostra dipende da lui: gli ingressi sopra la piega sono CSS.
    */}
    <script>
      const w = window as { __rivelata?: Promise<void> };
      (w.__rivelata ?? Promise.resolve()).then(() => import('../scripts/boot'));
    </script>

    {/*
      TELEMETRIA VERCEL, chiesta da Vlad dopo il primo deploy. Entrambi i
      pacchetti espongono un componente Astro dedicato (`/astro`, non
      `/react`): un web component vanilla che registra sé stesso via
      `customElements.define` e ordina al browser di caricare in modo
      differito lo script REALE da un endpoint del progetto Vercel
      (`/_vercel/insights/script.js`, `/_vercel/speed-insights/script.js`) —
      niente da idratare, stessa categoria di `cobe`: una libreria vanilla
      con una funzione sola, non un framework.
      ⚠ Fuori da Vercel (dev locale, un altro host) quell'endpoint non esiste
      e la richiesta fallisce in silenzio in console: innocuo, non blocca
      niente, ma è il motivo per cui in `npm run dev`/`preview` non si vedrà
      mai traffico verso quei percorsi.
      Un'istanza sola, qui in BaseLayout: ogni pagina la eredita, come Seo e
      Fonts. */}
    <Analytics />
    <SpeedInsights />
  </head>

  <body class={bodyClass}>
    {loader && <Loader />}

    <a href="#contenuto" class="skip-link">Vai al contenuto</a>

    {/* ⚠ LA CHROME È UN CONTENITORE SOLO, ed è ciò che fa funzionare la spinta
        dell'avviso senza sincronizzare due transform.
        Prima era la `.nav` stessa a essere `position: fixed`. Ora il fisso è
        questo wrapper e i suoi due figli stanno in FLUSSO NORMALE: quando la
        banda dell'avviso compare sopra, la navbar scende perché sopra di lei
        c'è un blocco alto — geometria vera, non due animazioni che si devono
        dare appuntamento sullo stesso fotogramma. Il vantaggio che conta di
        più: senza JS non c'è niente da misurare né da coordinare, la banda è
        già lì e la navbar è già più in basso.
        ⚠ NIENTE `overflow` né `contain` qui, per la stessa ragione scritta in
        testa a Handoff.astro: renderebbero il wrapper un contenitore di scroll
        o di paint, e il pannello mobile del menu (che esce da questo box) ne
        verrebbe ritagliato. */}
    <div class="chrome">
      <AnnouncementBanner />
      <Navbar />
    </div>

    <main id="contenuto">
      <slot />
    </main>

    <Footer />
  </body>
</html>

<style>
  /* Vedi la nota nel markup: il fisso è QUI, non più sulla navbar. */
  .chrome {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: var(--z-nav);
  }

  /* Il link di salto è invisibile finché non riceve il focus da tastiera.
     Non usare display:none: lo rimuoverebbe dall'ordine di tabulazione. */
  .skip-link {
    position: absolute;
    top: 0;
    left: var(--spacing-gutter, 1.25rem);
    z-index: var(--z-overlay);
    padding: 0.75rem 1.25rem;
    background-color: var(--color-accent);
    color: var(--color-canvas);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: 0.09em;
    border-radius: 0 0 0.5rem 0.5rem;
    /* -110% e non -100%: a -100% un arrotondamento subpixel lascia uno
       spiraglio del bordo visibile in cima alla pagina. */
    transform: translateY(-110%);
    transition: transform 180ms var(--ease-out-expo);
  }

  .skip-link:focus-visible {
    transform: translateY(0);
  }
</style>