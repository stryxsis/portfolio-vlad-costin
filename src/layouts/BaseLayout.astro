---
/**
 * Lo scheletro di ogni pagina. Contiene l'unico <head> del sito e l'unico
 * punto in cui il CSS globale viene importato.
 */
import '../styles/global.css';

import Seo from '../components/head/Seo.astro';
import Fonts from '../components/head/Fonts.astro';
import Navbar from '../components/chrome/Navbar.astro';
import AnnouncementBanner from '../components/chrome/AnnouncementBanner.astro';
import Loader from '../components/chrome/Loader.astro';
import Footer from '../components/chrome/Footer.astro';
import { SITE } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  jsonLd?: unknown;
  /** Classe extra sul <body>, per le pagine che partono su fondo diverso. */
  bodyClass?: string;
  /**
   * Il velo di prima visita (vedi Loader.astro). Solo la Home lo chiede: è
   * l'unica pagina con un ritratto a tutto schermo e una coreografia
   * d'ingresso da proteggere. Altrove sarebbe attesa costruita davanti a una
   * pagina che si dipinge già bene.
   */
  loader?: boolean;
}

const { bodyClass, loader = false, ...seo } = Astro.props;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <Seo {...seo} />
    <Fonts />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/*
      GATE DEL PRE-HIDING — inline, prima del paint.
      Le animazioni di ingresso nascondono il contenuto in CSS, ma SOLO sotto
      `html.js-anim`. Se il JS non gira (crawler, JS disattivato, errore di
      rete) o se l'utente ha chiesto meno movimento, la classe non viene
      aggiunta e il contenuto è visibile e completo dal primo frame.
      Deve stare qui e non in un modulo: un modulo è `defer` e il testo
      sfarfallerebbe.

      Il watchdog è l'assicurazione contro il caso peggiore: se il bundle non
      arriva o va in errore, `animReady` non viene mai impostato e la classe
      cade da sola, rendendo visibile tutto. Senza questo, un errore JS
      lascerebbe la pagina con il testo invisibile.
    */}
    <script is:inline>
      if (matchMedia('(prefers-reduced-motion: no-preference)').matches) {
        var r = document.documentElement;
        r.classList.add('js-anim');
        setTimeout(function () {
          if (r.dataset.animReady !== '1') r.classList.remove('js-anim');
        }, 2500);
      }
    </script>

    {
      loader && (
        <script is:inline>
          {/*
            GATE DEL VELO DI PRIMA VISITA — inline e SINCRONO, come quello del
            pre-hiding qui sopra e per lo stesso identico motivo: la decisione
            deve essere presa prima del primo paint. Delegarla al bundle (che è
            `defer`) vorrebbe dire dipingere la pagina e POI coprirla, cioè
            esattamente il lampo che il velo esiste per evitare.

            Tre condizioni, tutte necessarie: movimento consentito, storage
            leggibile, e non essere già stati qui. `localStorage` in modalità
            privata può LANCIARE al solo accesso, non restituire null: senza il
            try/catch un'eccezione qui dentro fermerebbe lo script inline.

            ⚠ IL WATCHDOG NON È PRUDENZA. `ld-on` rende visibile un velo a
            schermo intero che solo il JS sa togliere: se il bundle non arriva
            (rete che cade, errore di parsing, estensione che lo blocca) la
            pagina resterebbe coperta PER SEMPRE. Stessa assicurazione del
            watchdog di `js-anim`, con un tetto più alto del MAX_WAIT di
            loader.ts (4s) così scatta solo se quel modulo è davvero assente.
            ⚠ La chiave è la stessa di `KEY` in loader.ts: cambiarne una sola
            significa mostrare il velo a ogni visita, per sempre.
          */}
          try {
            if (
              matchMedia('(prefers-reduced-motion: no-preference)').matches &&
              !localStorage.getItem('vc:seen')
            ) {
              var lr = document.documentElement;
              lr.classList.add('ld-on');
              setTimeout(function () {
                lr.classList.remove('ld-on');
              }, 6000);
            }
          } catch (e) {}
        </script>
      )
    }

    {/*
      L'UNICO <script> del sito. Astro lo processa: TypeScript compilato,
      import npm risolti, bundle unico e deduplicato fra le pagine.
      Non è `is:inline` (che rinuncerebbe a bundling e TS) e non è un'isola
      (non c'è alcun framework da idratare).
    */}
    <script>
      import '../scripts/boot';
    </script>
  </head>

  <body class={bodyClass}>
    {loader && <Loader />}

    <a href="#contenuto" class="skip-link">Vai al contenuto</a>

    {/* ⚠ LA CHROME È UN CONTENITORE SOLO, ed è ciò che fa funzionare la spinta
        dell'avviso senza sincronizzare due transform.
        Prima era la `.nav` stessa a essere `position: fixed`. Ora il fisso è
        questo wrapper e i suoi due figli stanno in FLUSSO NORMALE: quando la
        banda dell'avviso compare sopra, la navbar scende perché sopra di lei
        c'è un blocco alto — geometria vera, non due animazioni che si devono
        dare appuntamento sullo stesso fotogramma. Il vantaggio che conta di
        più: senza JS non c'è niente da misurare né da coordinare, la banda è
        già lì e la navbar è già più in basso.
        ⚠ NIENTE `overflow` né `contain` qui, per la stessa ragione scritta in
        testa a Handoff.astro: renderebbero il wrapper un contenitore di scroll
        o di paint, e il pannello mobile del menu (che esce da questo box) ne
        verrebbe ritagliato. */}
    <div class="chrome">
      <AnnouncementBanner />
      <Navbar />
    </div>

    <main id="contenuto">
      <slot />
    </main>

    <Footer />
  </body>
</html>

<style>
  /* Vedi la nota nel markup: il fisso è QUI, non più sulla navbar. */
  .chrome {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: var(--z-nav);
  }

  /* Il link di salto è invisibile finché non riceve il focus da tastiera.
     Non usare display:none: lo rimuoverebbe dall'ordine di tabulazione. */
  .skip-link {
    position: absolute;
    top: 0;
    left: var(--spacing-gutter, 1.25rem);
    z-index: var(--z-overlay);
    padding: 0.75rem 1.25rem;
    background-color: var(--color-accent);
    color: var(--color-canvas);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: 0.09em;
    border-radius: 0 0 0.5rem 0.5rem;
    /* -110% e non -100%: a -100% un arrotondamento subpixel lascia uno
       spiraglio del bordo visibile in cima alla pagina. */
    transform: translateY(-110%);
    transition: transform 180ms var(--ease-out-expo);
  }

  .skip-link:focus-visible {
    transform: translateY(0);
  }
</style>