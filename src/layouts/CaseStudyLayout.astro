---
/**
 * Il layout di un case study: il PALCO (primo schermo, con il selettore dei
 * progetti) e sotto l'ARTICOLO, un documento normale da leggere in verticale.
 *
 * ⚠ IL CAMBIO DI PROGETTO È UNA NAVIGAZIONE, NON UN CAROSELLO. Ogni case study
 * è una pagina statica al proprio URL; il palco lega le pagine fra loro con
 * una View Transition FRA DOCUMENTI (`@view-transition`, qui sotto): nessun
 * router client, nessun link intercettato, nessuno stato da tenere in sync con
 * l'URL — l'URL è lo stato. Dove l'API non esiste (o con meno movimento)
 * restano link che portano alla pagina giusta, cioè la versione completa.
 *
 * ⚠ LA PALETTE È LOCALE. Le variabili `--cs-*` stanno sull'<article>, non su
 * :root: nav, footer e le altre pagine non ne sanno niente. Dentro l'articolo
 * ridefinisce anche `--color-accent`, così i richiami del corpo (numeri dei
 * capitoli, filetti delle citazioni, sottolineature dei link) prendono il
 * colore del progetto senza che nessun componente lo sappia. Il contrasto di
 * ogni coppia è verificato a build time (src/lib/palette.ts).
 *
 * Contiene il GUARD di build: se il corpo MDX non ha tutti i capitoli
 * obbligatori, la build FALLISCE con un messaggio che dice cosa fare. È
 * deliberato: preferisco una build rotta a un case study pubblicato a metà.
 */
import BaseLayout from './BaseLayout.astro';
import FactList, { type Fact } from '../components/primitives/FactList.astro';
import Button from '../components/primitives/Button.astro';
import ProjectStage from '../components/case-study/ProjectStage.astro';
import MetricList from '../components/case-study/MetricList.astro';
import { REQUIRED_CHAPTERS, chaptersIn, chapterNumber } from '../lib/chapters';
import { fullDate, isoDate } from '../lib/format';
import { paletteStyle } from '../lib/palette';
import { stagePreload } from '../lib/stage-media';
import type { Project } from '../lib/collections';

interface Props {
  project: Project;
  all: Project[];
  index: number;
  prev: Project | null;
  next: Project | null;
}

const { project, all, index, prev, next } = Astro.props;
const d = project.data;

/* ---- Guard di build ------------------------------------------------------
   Il corpo è già stato letto in memoria: cercare i capitoli è gratuito, e
   intercetta gli errori di authoring realistici (un <Chapter> cancellato, un
   id sbagliato, lo stesso capitolo due volte). */
const chapters = chaptersIn(project.body ?? '', `case study: ${project.id}`);
const missing = REQUIRED_CHAPTERS.filter((id) => !chapters.some((c) => c.id === id));
if (missing.length > 0) {
  throw new Error(
    `[case study: ${project.id}] capitoli mancanti nel corpo: ${missing.join(', ')}.\n` +
      `Duplica src/content/progetti/_template.mdx: contiene già i quattro <Chapter> e gli import.`
  );
}

/* La scheda tecnica in testa all'articolo. Anno, ruolo e cliente stanno già
   nel palco: qui ciò che serve a chi legge il dettaglio. */
const facts: Fact[] = [
  ...(d.stack.length ? [{ label: 'Stack', value: d.stack.join(' · ') }] : []),
  ...(d.liveUrl ? [{ label: 'Online', value: new URL(d.liveUrl).host, href: d.liveUrl }] : []),
  ...(d.repoUrl ? [{ label: 'Codice', value: 'Repository', href: d.repoUrl }] : []),
];

/* Anche i link in fondo preparano l'immagine della destinazione su intento. */
const preloadOf = async (p: Project | null) => (p ? await stagePreload(p.data.cover) : undefined);
const [prevPreload, nextPreload] = await Promise.all([preloadOf(prev), preloadOf(next)]);

const style = [
  paletteStyle(d.palette),
  /* Solo con una palette: ridichiarare l'accento del sito uguale a sé stesso
     non servirebbe a niente, e `--color-accent: var(--color-accent)` sarebbe
     un ciclo (cioè un valore non valido). */
  d.palette && `--color-accent: ${d.palette.accent}`,
  /* L'anello di focus del sito è `--color-accent-hi`: lo si lega all'accento
     principale, l'unico con il contrasto verificato sul fondo. L'accento
     secondario non è verificato perché colora solo aloni decorativi. */
  d.palette && `--color-accent-hi: ${d.palette.accent}`,
]
  .filter(Boolean)
  .join('; ');
---

<BaseLayout
  title={d.title}
  description={d.description}
  ogType="article"
  ogImage={(d.ogImage ?? d.cover).src}
  ogImageAlt={d.coverAlt}
>
  {/* `pagereveal` scatta PRIMA del primo fotogramma della pagina nuova, cioè
      prima che il bundle (che è `defer`) esista: per non perdere la View
      Transition in arrivo la si mette da parte qui, sincrona, e la raccoglie
      case-switch.ts. Serve a non perdere i clic durante la transizione. */}
  <script is:inline slot="head">
    /* ⚠ L'ULTIMA RICHIESTA VINCE, ANCHE QUANDO IL BROWSER LA PERDE. C'è una
       finestra di poche decine di millisecondi — la pagina vecchia ha già
       ceduto il passo, quella nuova non è ancora visibile — in cui un clic
       attiva il link ma la navigazione viene scartata. Misurato: otto clic
       rapidi finivano sul penultimo. case-switch.ts annota ogni scelta con il
       suo orario; se questa pagina è stata superata da una scelta fatta DOPO
       che era partita la sua navigazione, si va subito a quella. Sincrono e
       prima del paint, così la pagina superata non si vede. `replace` perché
       quella pagina nessuno l'ha davvero voluta: non deve restare in
       cronologia. */
    try {
      var want = JSON.parse(sessionStorage.getItem('vc:cs-intent') || 'null');
      if (
        want &&
        want.href !== location.pathname &&
        want.t > performance.timeOrigin &&
        /^\/portfolio\/[\w-]+$/.test(want.href)
      ) {
        location.replace(want.href);
      }
    } catch (e) {}
    /* Interrotta da un'altra navigazione, una transizione rifiuta le sue
       promesse: è il comportamento previsto (succede a ogni clic rapido), non
       un errore da mostrare. Qui e non nel bundle: un clic che arriva prima
       del bundle farebbe partire un `pageswap` che nessuno ascolta. */
    function csQuiet(vt) {
      if (vt) [vt.ready, vt.updateCallbackDone, vt.finished].forEach(function (p) { p && p.catch(function () {}); });
    }
    addEventListener('pageswap', function (e) {
      csQuiet(e.viewTransition);
    });
    /* Alcune transizioni interrotte vengono rifiutate dal browser PRIMA che
       qualunque gestore di pagina possa agganciarsi (misurato: succede anche
       con i tre `catch` qui sopra al loro posto). Sono attese e innocue; il
       filtro è stretto apposta — solo questo errore, con questo messaggio —
       così nessun altro rifiuto viene nascosto. */
    addEventListener('unhandledrejection', function (e) {
      var r = e.reason;
      if (r && r.name === 'InvalidStateError' && /^Transition was aborted/.test(r.message)) e.preventDefault();
    });
    addEventListener('pagereveal', function (e) {
      csQuiet(e.viewTransition);
      window.__csVT = e.viewTransition || null;
    });
  </script>

  <article class="cs" style={style || undefined} data-cs>
    <ProjectStage
      project={project}
      all={all}
      index={index}
      prev={prev}
      next={next}
      firstChapter={chapters[0]!.id}
    />

    <div class="cs__wrap cs__main">
      {/* Indice dei capitoli PRESENTI, generato dal corpo: un modulo che il
          progetto non ha non compare. Sticky puro, nessuno ScrollTrigger, solo
          ≥1200px — sotto diventa un indice in flusso prima del testo. */}
      <nav class="cs__rail" aria-label="Capitoli del case study">
        <ol>
          {
            chapters.map((c, i) => (
              <li>
                <a href={`#${c.id}`}>
                  <span class="cs__rail-n">{chapterNumber(i)}</span>
                  {c.title}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="cs__body">
        <div class="cs__sheet">
          {facts.length > 0 && <FactList items={facts} />}
          <p class="cs__date">
            Pubblicato il <time datetime={isoDate(d.pubDate)}>{fullDate(d.pubDate)}</time>
            {
              d.updatedDate && (
                <>
                  {' · aggiornato il '}
                  <time datetime={isoDate(d.updatedDate)}>{fullDate(d.updatedDate)}</time>
                </>
              )
            }
          </p>
        </div>

        <MetricList metrics={d.metrics} />

        <div class="cs__chapters">
          <slot />
        </div>
      </div>
    </div>

    {/* ---- La chiusura: parlarne, tornare ai lavori, o andare avanti ---- */}
    <footer class="cs__end">
      <div class="cs__wrap">
        <div class="cs__cta">
          <p class="cs__cta-title">Parliamo del tuo progetto</p>
          <div class="cs__cta-actions">
            <Button href="/contatti" variant="filled">Scrivimi</Button>
            <Button href="/portfolio#lavori" variant="outline">Tutti i lavori</Button>
          </div>
        </div>

        {
          (prev || next) && (
            <nav class="cs__pn" aria-label="Altri case study">
              {prev ? (
                <a class="cs__pn-link" href={`/portfolio/${prev.id}`} rel="prev" data-cs-link data-cs-preload={prevPreload}>
                  <span class="cs__pn-label">
                    <span aria-hidden="true">← </span>Progetto precedente
                  </span>
                  <span class="cs__pn-title">{prev.data.title}</span>
                </a>
              ) : (
                <span />
              )}
              {next && (
                <a
                  class="cs__pn-link cs__pn-link--next"
                  href={`/portfolio/${next.id}`}
                  rel="next"
                  data-cs-link
                  data-cs-preload={nextPreload}
                >
                  <span class="cs__pn-label">
                    Progetto successivo<span aria-hidden="true"> →</span>
                  </span>
                  <span class="cs__pn-title">{next.data.title}</span>
                </a>
              )}
            </nav>
          )
        }
      </div>
    </footer>
  </article>
</BaseLayout>

<style>
  .cs__wrap {
    max-width: 84rem;
    margin-inline: auto;
    padding-inline: var(--spacing-gutter);
  }

  .cs__main {
    display: grid;
    gap: 0;
    padding-top: clamp(3rem, 6vw, 5rem);
    padding-bottom: var(--spacing-section);
  }

  /* Il reset del contatore dei capitoli (vedi Chapter.astro): sta sul
     contenitore dei soli capitoli, così nient'altro lo incrementa. */
  .cs__chapters {
    counter-reset: cs-chapter;
  }

  .cs__sheet {
    display: grid;
    gap: 1.5rem;
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .cs__date {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    /* text-2: text-3 sul canvas nero è sotto AA per una mono da 12px. */
    color: var(--color-text-2);
  }

  /* ---- L'indice -----------------------------------------------------------
     Sotto i 1200px: in flusso, prima del testo, compatto. Da 1200px: colonna
     sticky a destra. `max-height` + scroll proprio: con tanti moduli un
     indice sticky più alto della viewport lascerebbe capitoli irraggiungibili. */
  .cs__rail {
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }

  @media (min-width: 75rem) {
    .cs__main {
      grid-template-columns: minmax(0, 1fr) 15rem;
      gap: 0 4rem;
    }
    .cs__body {
      grid-column: 1;
      grid-row: 1;
    }
    .cs__rail {
      grid-column: 2;
      grid-row: 1;
      align-self: start;
      position: sticky;
      top: calc(var(--nav-h) + 2rem);
      max-height: calc(100svh - var(--nav-h) - 4rem);
      overflow-y: auto;
      padding-bottom: 0;
    }
  }

  .cs__rail ol {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.25rem;
    border-left: 1px solid var(--cs-border, var(--color-hairline));
  }
  @media (max-width: 74.99rem) {
    .cs__rail ol {
      grid-template-columns: repeat(auto-fill, minmax(min(15rem, 100%), 1fr));
      border-left: 0;
      border-top: 1px solid var(--cs-border, var(--color-hairline));
      padding-top: 0.5rem;
    }
  }

  /* 44px di altezza: è un elenco di link da toccare, non una didascalia. */
  .cs__rail a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    padding-left: 1rem;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-text-2);
    text-decoration: none;
    transition: color 200ms var(--ease-snappy);
  }
  @media (max-width: 74.99rem) {
    .cs__rail a {
      padding-left: 0;
    }
  }
  .cs__rail a:hover {
    color: var(--color-text-1);
  }
  .cs__rail-n {
    color: var(--color-accent);
  }

  /* ---- La chiusura --------------------------------------------------------- */
  .cs__end {
    border-top: 1px solid var(--cs-border, var(--color-hairline));
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }

  .cs__cta {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }
  .cs__cta-title {
    max-width: min(14ch, 100%);
    font-size: var(--text-h1);
    line-height: 0.98;
    letter-spacing: -0.032em;
    text-wrap: balance;
  }
  .cs__cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .cs__pn {
    display: grid;
    gap: 1.5rem;
    margin-top: clamp(3.5rem, 7vw, 6rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--cs-border, var(--color-hairline));
  }
  @media (min-width: 37.5rem) {
    .cs__pn {
      grid-template-columns: 1fr 1fr;
    }
  }

  .cs__pn-link {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    min-height: 2.75rem;
    text-decoration: none;
    color: var(--color-text-1);
  }
  .cs__pn-link--next {
    text-align: right;
    justify-items: end;
  }
  @media (max-width: 37.49rem) {
    .cs__pn-link--next {
      text-align: left;
      justify-items: start;
    }
  }
  .cs__pn-label {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-2);
  }
  .cs__pn-title {
    font-size: var(--text-h3);
    line-height: 1.15;
    letter-spacing: -0.015em;
    transition: color 220ms var(--ease-snappy);
  }
  @media (hover: hover) and (pointer: fine) {
    .cs__pn-link:hover .cs__pn-title {
      color: var(--color-accent);
    }
  }
</style>

{/*
  ═══════════════════════════════════════════════════════════════════════════
  LA COREOGRAFIA DEL CAMBIO DI PROGETTO — View Transition fra documenti.

  Globale di proposito ma confinata: questo foglio esiste SOLO nelle pagine di
  case study, e `@view-transition` si attiva solo se ENTRAMBI i documenti lo
  dichiarano. Quindi la transizione c'è fra un case study e l'altro, e da
  nessun'altra parte: il resto del sito naviga come sempre.

  ⚠ DENTRO `prefers-reduced-motion: no-preference`: con meno movimento la
  transizione non esiste affatto, la pagina nuova compare subito. Non "più
  breve": assente, e senza ritardare di un millisecondo focus e contenuto.

  I tempi sono token (qui sotto) e non misure del filmato: sono la specifica
  per questo sito. Cambio standard ~800ms, con le azioni sovrapposte:
    0–150      il testo uscente si spegne e sale di 12px
    50–650     la miniatura scelta diventa il visual (`cs-visual`)
    0–700      il fondale vecchio si dissolve nel nuovo (`cs-sky`)
    250–650    il titolo nuovo sale dentro la propria maschera
    +50/+100   sottotitolo e metadati, sfalsati
  ═══════════════════════════════════════════════════════════════════════════
*/}
<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    @view-transition {
      navigation: auto;
    }
  }

  :root {
    --cs-ease: cubic-bezier(0.22, 1, 0.36, 1);
    --cs-t-out: 150ms;
    --cs-t-visual: 600ms;
    --cs-t-visual-delay: 50ms;
    --cs-t-sky: 700ms;
    --cs-t-in: 400ms;
    --cs-t-in-delay: 250ms;
    --cs-t-stagger: 50ms;
    --cs-t-root: 180ms;
  }

  [data-cs-sky] {
    view-transition-name: cs-sky;
  }
  /* ⚠ PERCHÉ QUESTI QUATTRO HANNO UN NOME. Il fondale ha un gruppo suo, e i
     gruppi con nome si dipingono SOPRA la radice: tutto ciò che nel palco non
     ha un nome resterebbe sotto il fondale per l'intera transizione. Misurato
     sui fotogrammi rallentati: per ~800ms spariva la navbar, il breadcrumb, il
     bottone e l'intera striscia delle miniature. Mettere il fondale SOTTO la
     radice non si può: lo snapshot della radice è opaco (contiene il fondo del
     body) e lo coprirebbe per intero. Quindi sono loro a salire sopra.
     `.chrome` è della chrome globale, ma questo foglio esiste solo nei case
     study: sulle altre pagine la regola non c'è. */
  .chrome {
    view-transition-name: cs-chrome;
  }
  [data-cs-keep='crumbs'] {
    view-transition-name: cs-crumbs;
  }
  [data-cs-keep='actions'] {
    view-transition-name: cs-actions;
  }
  [data-cs-keep='switch'] {
    view-transition-name: cs-switch;
  }
  [data-cs-frame] {
    view-transition-name: cs-frame;
  }
  /* Il nome lo porta lo SCHERMO e non la cornice: è lo schermo che la
     miniatura diventa (vedi case-switch.ts, che al momento del clic sposta
     questo nome sulla miniatura scelta). */
  [data-cs-screen] {
    view-transition-name: cs-visual;
  }
  [data-cs-idx] {
    view-transition-name: cs-idx;
  }
  [data-cs-title] {
    view-transition-name: cs-title;
  }
  [data-cs-sub] {
    view-transition-name: cs-sub;
  }
  [data-cs-meta] {
    view-transition-name: cs-meta;
  }

  /* ⚠ `pointer-events: none` qui NON basta a far passare i clic: misurato,
     durante la transizione Chrome manda il puntatore alla radice comunque
     (`elementFromPoint` restituisce <html> per tutti i ~950ms). La soluzione
     vera è in case-switch.ts: un clic durante la transizione la salta e
     raggiunge il link sotto il puntatore. La riga resta perché è corretta
     dove il browser la rispetta, e non costa niente. */
  ::view-transition {
    pointer-events: none;
  }

  /* Il resto della pagina (nav, striscia, corpo): una dissolvenza brevissima.
     Contatore e stato attivo della striscia stanno qui, e non devono
     aspettare nessuna animazione decorativa. */
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation-duration: var(--cs-t-root);
  }

  ::view-transition-group(cs-sky) {
    animation-duration: var(--cs-t-sky);
    animation-timing-function: linear;
  }

  /* Navbar, breadcrumb, azioni e striscia: dissolvenza breve, come la radice.
     La navbar sta prima dell'articolo nel DOM, quindi il suo gruppo verrebbe
     dipinto sotto il fondale: `z-index` la riporta in cima, dove sta sempre. */
  ::view-transition-group(cs-chrome) {
    z-index: 3;
  }
  ::view-transition-group(cs-chrome),
  ::view-transition-group(cs-crumbs),
  ::view-transition-group(cs-actions),
  ::view-transition-group(cs-switch) {
    animation-duration: var(--cs-t-root);
  }

  ::view-transition-group(cs-frame) {
    animation-duration: var(--cs-t-visual);
    animation-timing-function: var(--cs-ease);
  }

  /* LA CARD CHE DIVENTA LA SCENA. Il gruppo interpola posizione e misura
     dalla miniatura allo schermo; le due immagini lo RIEMPIONO con
     `object-fit: cover`, così nessuna delle due si stira durante il volo
     anche se i due rettangoli non hanno lo stesso rapporto. */
  ::view-transition-group(cs-visual) {
    z-index: 2;
    animation-duration: var(--cs-t-visual);
    animation-delay: var(--cs-t-visual-delay);
    animation-timing-function: var(--cs-ease);
  }
  ::view-transition-old(cs-visual),
  ::view-transition-new(cs-visual) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation-duration: var(--cs-t-visual);
    animation-delay: var(--cs-t-visual-delay);
  }

  /* Lo schermo del progetto USCENTE, quando la miniatura prende il suo posto
     (il nome glielo dà case-switch.ts). Si fa da parte e si spegne. */
  ::view-transition-old(cs-visual-out) {
    animation: cs-recede 320ms var(--cs-ease) both;
  }

  /* Il testo: il vecchio esce subito, il nuovo entra dopo. I gruppi NON
     interpolano la misura (si stirerebbe il testo): prendono subito quella
     nuova, e ogni immagine tiene la propria larghezza naturale. */
  ::view-transition-group(cs-title),
  ::view-transition-group(cs-sub),
  ::view-transition-group(cs-meta),
  ::view-transition-group(cs-idx) {
    animation: none;
  }
  ::view-transition-old(cs-title),
  ::view-transition-old(cs-sub),
  ::view-transition-old(cs-meta),
  ::view-transition-old(cs-idx),
  ::view-transition-new(cs-title),
  ::view-transition-new(cs-sub),
  ::view-transition-new(cs-meta),
  ::view-transition-new(cs-idx) {
    width: auto;
    height: auto;
  }
  ::view-transition-old(cs-title),
  ::view-transition-old(cs-sub),
  ::view-transition-old(cs-meta),
  ::view-transition-old(cs-idx) {
    animation: cs-out var(--cs-t-out) var(--cs-ease) both;
  }

  /* La maschera del titolo: il gruppo ritaglia, l'immagine nuova sale da
     sotto il proprio bordo — l'ingresso verticale mascherato del filmato. */
  ::view-transition-group(cs-title) {
    overflow: clip;
  }
  ::view-transition-new(cs-title) {
    animation: cs-rise var(--cs-t-in) var(--cs-ease) var(--cs-t-in-delay) both;
  }
  ::view-transition-new(cs-sub) {
    animation: cs-fade-up var(--cs-t-in) var(--cs-ease)
      calc(var(--cs-t-in-delay) + var(--cs-t-stagger)) both;
  }
  ::view-transition-new(cs-meta) {
    animation: cs-fade-up var(--cs-t-in) var(--cs-ease)
      calc(var(--cs-t-in-delay) + 2 * var(--cs-t-stagger)) both;
  }
  ::view-transition-new(cs-idx) {
    animation: cs-fade-up var(--cs-t-in) var(--cs-ease) var(--cs-t-in-delay) both;
  }

