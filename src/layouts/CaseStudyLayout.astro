---
/**
 * Il layout di un case study.
 *
 * Contiene il GUARD di build: se il corpo MDX non ha tutti i capitoli
 * obbligatori, la build FALLISCE con un messaggio che dice cosa fare. È
 * deliberato: preferisco una build rotta a un case study pubblicato a metà.
 */
import { Picture } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/chrome/Breadcrumbs.astro';
import FactList, { type Fact } from '../components/primitives/FactList.astro';
import { NAV_CHAPTERS, REQUIRED_CHAPTERS, CHAPTERS } from '../lib/chapters';
import { fullDate, isoDate } from '../lib/format';
import type { Project } from '../lib/collections';

interface Props {
  project: Project;
  next: Project | null;
}

const { project, next } = Astro.props;
const d = project.data;

/* ---- Guard di build ------------------------------------------------------
   Il corpo è già stato letto in memoria: cercare gli id dei capitoli è
   gratuito, e intercetta l'unico errore di authoring realistico (aver
   cancellato un <Chapter> o un import). */
const body = project.body ?? '';
const missing = REQUIRED_CHAPTERS.filter((id) => !body.includes(`id="${id}"`));
if (missing.length > 0) {
  throw new Error(
    `[case study: ${project.id}] capitoli mancanti nel corpo: ${missing.join(', ')}.\n` +
      `Duplica src/content/progetti/_template.mdx: contiene già i quattro <Chapter> e gli import.`
  );
}

const facts: Fact[] = [
  { label: 'Anno', value: String(d.year) },
  { label: 'Ruolo', value: d.role },
  ...(d.client ? [{ label: 'Cliente', value: d.client }] : []),
  ...(d.stack.length ? [{ label: 'Stack', value: d.stack.join(' · ') }] : []),
  ...(d.liveUrl ? [{ label: 'Online', value: 'Vedi il sito', href: d.liveUrl }] : []),
  ...(d.repoUrl ? [{ label: 'Codice', value: 'Repository', href: d.repoUrl }] : []),
];
---

<BaseLayout
  title={d.title}
  description={d.description}
  ogType="article"
  ogImage={(d.ogImage ?? d.cover).src}
  ogImageAlt={d.coverAlt}
>
  <article class="cs">
    {/* ---- Hero: il titolo NON si anima, è il candidato LCP di questa pagina ---- */}
    <header class="cs__hero">
      <div class="cs__wrap">
        <Breadcrumbs
          items={[
            { label: 'Home', href: '/' },
            { label: 'Portfolio', href: '/portfolio' },
            { label: d.title },
          ]}
        />

        <h1 class="cs__title">{d.title}</h1>
        <p class="cs__subtitle">{d.subtitle}</p>

        {/*
          Il margine sta su un wrapper e non passato come `class` a FactList:
          uno stile scoped di Astro non raggiunge l'elemento radice di un
          componente figlio (l'attributo di scoping non combacia), quindi la
          classe arriverebbe ma la regola no.
        */}
        <div class="cs__facts">
          <FactList items={facts} />
        </div>

        <p class="cs__date">
          Pubblicato il <time datetime={isoDate(d.pubDate)}>{fullDate(d.pubDate)}</time>
          {
            d.updatedDate && (
              <>
                {' · aggiornato il '}
                <time datetime={isoDate(d.updatedDate)}>{fullDate(d.updatedDate)}</time>
              </>
            )
          }
        </p>
      </div>
    </header>

    {/* ---- Cover: sconfina in alto con margine negativo, così cuce hero e corpo ---- */}
    <div class="cs__cover clip-frame">
      <Picture
        src={d.cover}
        alt={d.coverAlt}
        widths={[640, 1000, 1400, 2000]}
        sizes="(min-width: 90rem) 84rem, 100vw"
        formats={['avif', 'webp']}
        loading="eager"
        decoding="async"
        class="cs__cover-img"
      />
    </div>

    <div class="cs__wrap cs__main">
      {/* Rail dei capitoli: sticky puro, nessuno ScrollTrigger. Solo ≥1200px. */}
      <nav class="cs__rail" aria-label="Capitoli del case study">
        <ol>
          {
            NAV_CHAPTERS.map((id) => (
              <li>
                <a href={`#${id}`}>
                  <span class="cs__rail-n">{CHAPTERS[id].n}</span>
                  {CHAPTERS[id].title}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="cs__body">
        {
          d.metrics.length > 0 && (
            <div class="cs__metrics" data-reveal>
              {d.metrics.map((m) => (
                <div class="cs__metric">
                  <span class="cs__metric-value">{m.value}</span>
                  <span class="cs__metric-label">{m.label}</span>
                </div>
              ))}
            </div>
          )
        }

        <slot />
      </div>
    </div>

    {/* ---- Prossimo lavoro ---- */}
    {
      next && (
        <a class="cs__next" href={`/portfolio/${next.id}`}>
          <span class="cs__next-label">Prossimo lavoro</span>
          <span class="cs__next-title">{next.data.title}</span>
          <span class="cs__next-arrow" aria-hidden="true">→</span>
        </a>
      )
    }
  </article>
</BaseLayout>

<style>
  .cs__wrap {
    max-width: 84rem;
    margin-inline: auto;
    padding-inline: var(--spacing-gutter);
  }

  .cs__hero {
    padding-top: calc(var(--nav-h) + clamp(3rem, 8vh, 6rem));
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .cs__title {
    margin-top: 1.5rem;
    max-width: min(18ch, 100%);
    font-size: var(--text-h1);
    line-height: 0.98;
    letter-spacing: -0.032em;
  }

  .cs__subtitle {
    margin-top: 1rem;
    max-width: min(44ch, 100%);
    font-size: var(--text-lede);
    color: var(--color-text-2);
  }

  .cs__facts {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .cs__date {
    margin-top: 2rem;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-3);
  }

  /* La cover esce dal contenitore ed è l'elemento che unisce hero e corpo. */
  .cs__cover {
    width: min(100%, 84rem);
    margin-inline: auto;
    padding-inline: var(--spacing-gutter);
  }
  .cs__cover-img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--radius-card);
    border: 1px solid var(--color-hairline);
  }

  .cs__main {
    display: grid;
    gap: 0;
    padding-top: clamp(3rem, 6vw, 5rem);
    padding-bottom: var(--spacing-section);
  }

  @media (min-width: 75rem) {
    .cs__main {
      grid-template-columns: minmax(0, 1fr) 14rem;
      gap: 0 4rem;
    }
    .cs__body {
      grid-column: 1;
      grid-row: 1;
    }
    .cs__rail {
      grid-column: 2;
      grid-row: 1;
      align-self: start;
      position: sticky;
      top: calc(var(--nav-h) + 2rem);
    }
  }

  .cs__rail {
    display: none;
  }
  @media (min-width: 75rem) {
    .cs__rail {
      display: block;
    }
  }

  .cs__rail ol {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.85rem;
    border-left: 1px solid var(--color-hairline);
  }

  .cs__rail a {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding-left: 1rem;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-text-3);
    text-decoration: none;
    transition: color 200ms var(--ease-snappy);
  }
  .cs__rail a:hover {
    color: var(--color-text-1);
  }
  .cs__rail-n {
    color: var(--color-hairline-strong);
  }

  /* Riga di risultati misurati. */
  .cs__metrics {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }

  .cs__metric {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .cs__metric-value {
    font-size: var(--text-h2);
    line-height: 1;
    letter-spacing: -0.025em;
    color: var(--color-accent);
  }
  .cs__metric-label {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-3);
  }

  /* Prossimo lavoro: una sola riga, tutta cliccabile. */
  .cs__next {
    display: grid;
    gap: 0.75rem;
    max-width: 84rem;
    margin-inline: auto;
    padding: clamp(3rem, 6vw, 5rem) var(--spacing-gutter);
    border-top: 1px solid var(--color-hairline);
    text-decoration: none;
  }

  .cs__next-label {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-3);
  }

  .cs__next-title {
    font-size: var(--text-h1);
    line-height: 1;
    letter-spacing: -0.032em;
    color: var(--color-text-1);
    max-width: min(20ch, 100%);
    transition: color 260ms var(--ease-snappy);
  }
  .cs__next:hover .cs__next-title {
    color: var(--color-accent);
  }

  .cs__next-arrow {
    font-size: var(--text-h3);
    color: var(--color-accent);
    transition: transform 260ms var(--ease-snappy);
  }
  .cs__next:hover .cs__next-arrow {
    transform: translateX(6px);
  }
</style>