---
/**
 * Il selettore dei case study, in fondo al palco.
 *
 * ⚠ OGNI MINIATURA È UN LINK VERO A UN DOCUMENTO VERO, e non un tab. Cambiare
 * progetto qui è NAVIGARE: lo slug nell'URL è la fonte di verità, e da questo
 * discende gratis tutto ciò che un carosello a stato interno deve reinventare
 * e di solito sbaglia — apertura diretta, refresh, condivisione, Indietro/
 * Avanti, Cmd-click in una nuova scheda, cinque clic di fila che finiscono
 * sull'ultimo (il browser annulla da sé la navigazione precedente). Per lo
 * stesso motivo NIENTE `role="tab"`: si naviga fra documenti, e lo stato
 * attivo è `aria-current="page"`.
 *
 * L'effetto "la card diventa la scena" del riferimento lo dà la View
 * Transition fra documenti (vedi CaseStudyLayout e case-switch.ts), che è un
 * miglioramento progressivo: senza, questi restano link che funzionano.
 *
 * ⚠ L'ORDINE È QUELLO EDITORIALE E NON CAMBIA MAI. Nel filmato la fila
 * ruota; qui la miniatura attiva resta al suo posto e al caricamento la
 * striscia scorre (solo in orizzontale, dentro di sé) per metterla in vista.
 * Una navigazione che si riordina a ogni clic è una navigazione che non si può
 * imparare.
 *
 * ⚠ NESSUN TIMER. Il riferimento ha una sottile linea gialla in alto che dal
 * solo filmato potrebbe essere un conto alla rovescia; qui la linea di
 * posizione è STATICA — dice dove sei, non quanto manca.
 */
import { Picture } from 'astro:assets';
import type { Project } from '../../lib/collections';
import { STAGE_IMG, stagePreload } from '../../lib/stage-media';

interface Props {
  all: Project[];
  index: number;
  prev: Project | null;
  next: Project | null;
}

const { all, index, prev, next } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
const href = (p: Project) => `/portfolio/${p.id}`;

/* Lo srcset del visual di ogni destinazione, per prepararlo su INTENTO
   (hover o focus sulla miniatura). Mai tutti insieme al caricamento: sono le
   immagini più pesanti della pagina. */
const preload = new Map(
  await Promise.all(all.map(async (p) => [p.id, await stagePreload(p.data.cover)] as const))
);
---

<nav class="sw" aria-label="Case study" data-cs-switcher data-cs-sizes={STAGE_IMG.sizes}>
  <ol class="sw__list" data-cs-strip>
    {
      all.map((p, i) => (
        <li class="sw__item">
          <a
            class="sw__card"
            href={href(p)}
            aria-current={i === index ? 'page' : undefined}
            data-cs-link
            data-cs-thumb
            data-cs-preload={i === index ? undefined : preload.get(p.id)}
          >
            <span class="sw__thumb" data-cs-thumb-img>
              <Picture
                src={p.data.cover}
                alt=""
                widths={[240, 360, 480]}
                sizes="(min-width: 56.25rem) 11.5rem, 9.5rem"
                formats={['avif', 'webp']}
                loading="lazy"
                decoding="async"
                class="sw__img"
                style={`object-position: ${p.data.coverFocal.x}% ${p.data.coverFocal.y}%;`}
              />
            </span>
            <span class="sw__meta">
              <span class="sw__n">{pad(i + 1)}</span>
              {p.data.status === 'demo' && <span class="sw__demo">Esempio</span>}
            </span>
            <span class="sw__title">{p.data.title}</span>
          </a>
        </li>
      ))
    }
  </ol>
  {/* Porta in vista la miniatura attiva PRIMA del primo paint, così lo
      snapshot della View Transition la trova già al suo posto. Inline e
      sincrono per la stessa ragione dei gate in <head>. Tocca solo lo
      scroll ORIZZONTALE della striscia: niente `scrollIntoView`, che sposta
      anche la pagina in verticale. */}
  <script is:inline>
    (function () {
      var s = document.currentScript && document.currentScript.previousElementSibling;
      var a = s && s.querySelector('[aria-current="page"]');
      if (!a || s.scrollWidth <= s.clientWidth) return;
      var li = a.parentElement;
      s.scrollLeft = li.offsetLeft - (s.clientWidth - li.offsetWidth) / 2;
    })();
  </script>

  {/* Dopo la striscia nel DOM, e a destra sullo schermo: l'ordine di lettura
      coincide con quello visivo (prima i progetti, poi dove sei e le frecce). */}
  <div class="sw__bar">
    <p class="sw__count">
      <span class="sr-only">Progetto </span>
      <span class="sw__count-now">{pad(index + 1)}</span>
      <span class="sw__count-sep" aria-hidden="true">/</span>
      <span class="sr-only"> di </span>
      <span>{pad(all.length)}</span>
    </p>

    <span class="sw__line" aria-hidden="true">
      {all.map((_, i) => <span class:list={['sw__seg', { 'is-on': i === index }]} />)}
    </span>

    {/* Agli estremi il link non c'è, ma il suo posto sì: un segnaposto vuoto
        tiene ferma la freccia rimasta invece di farla slittare. */}
    <div class="sw__arrows">
      {
        prev ? (
          <a
            class="sw__arrow"
            href={href(prev)}
            rel="prev"
            data-cs-link
            data-cs-preload={preload.get(prev.id)}
            aria-label={`Progetto precedente: ${prev.data.title}`}
          >
            <span aria-hidden="true">←</span>
          </a>
        ) : (
          <span class="sw__arrow sw__arrow--void" aria-hidden="true" />
        )
      }
      {
        next ? (
          <a
            class="sw__arrow"
            href={href(next)}
            rel="next"
            data-cs-link
            data-cs-preload={preload.get(next.id)}
            aria-label={`Progetto successivo: ${next.data.title}`}
          >
            <span aria-hidden="true">→</span>
          </a>
        ) : (
          <span class="sw__arrow sw__arrow--void" aria-hidden="true" />
        )
      }
    </div>
  </div>
</nav>

<style>
  .sw {
    display: grid;
    gap: 1rem;
    min-width: 0;
  }

  .sw__bar {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .sw__count {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: 0.09em;
    color: var(--cs-text-2, var(--color-text-2));
  }
  .sw__count-now {
    color: var(--cs-accent, var(--color-accent));
  }

  /* La linea di posizione: un segmento per progetto, pieno quello attuale.
     Statica. Il colore non è l'unico segnale: il segmento attivo è anche più
     spesso. */
  .sw__line {
    display: flex;
    flex: 1;
    gap: 0.35rem;
    min-width: 3rem;
  }
  .sw__seg {
    flex: 1;
    height: 1px;
    align-self: center;
    background-color: var(--cs-border, var(--color-hairline-strong));
  }
  .sw__seg.is-on {
    height: 3px;
    border-radius: 2px;
    background-color: var(--cs-accent, var(--color-accent));
  }

  .sw__arrows {
    display: flex;
    gap: 0.5rem;
  }

  /* 44px: il bersaglio minimo. Cerchi come nel riferimento, filetto come nel
     resto del sito. */
  .sw__arrow {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--cs-border, var(--color-hairline-strong));
    border-radius: 50%;
    font-size: 1.05rem;
    color: var(--cs-text, var(--color-text-1));
    text-decoration: none;
    transition:
      border-color 180ms var(--ease-snappy),
      color 180ms var(--ease-snappy);
  }
  .sw__arrow--void {
    visibility: hidden;
  }
  @media (hover: hover) and (pointer: fine) {
    .sw__arrow:hover {
      border-color: var(--cs-accent, var(--color-accent));
      color: var(--cs-accent, var(--color-accent));
    }
  }

  /* ---- La striscia ------------------------------------------------------
     Scorre in ORIZZONTALE e nativamente, dentro di sé: nessun drag
     obbligatorio, nessuna rotella catturata. `overscroll-behavior-x` impedisce
     che arrivare in fondo alla striscia faccia partire il "torna indietro" dei
     trackpad; il gesto verticale passa alla pagina come sempre. */
  .sw__list {
    display: flex;
    gap: clamp(0.75rem, 1.4vw, 1.25rem);
    margin: 0;
    padding: 0.35rem 0.35rem 0.75rem;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
    scrollbar-color: var(--cs-border, var(--color-hairline-strong)) transparent;
  }

  .sw__item {
    flex: 0 0 clamp(9.5rem, 13vw, 11.5rem);
    scroll-snap-align: start;
  }

  .sw__card {
    display: grid;
    gap: 0.5rem;
    color: var(--cs-text, var(--color-text-1));
    text-decoration: none;
    border-radius: calc(var(--radius-card) + 0.2rem);
  }

  .sw__thumb {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: clip;
    border: 1px solid var(--cs-border, var(--color-hairline));
    border-radius: var(--radius-card);
    background-color: var(--cs-surface, var(--color-surface-1));
    transition:
      transform 180ms var(--cs-ease, cubic-bezier(0.22, 1, 0.36, 1)),
      border-color 180ms var(--ease-snappy);
  }
  .sw__thumb :global(picture),
  .sw__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* L'attiva si riconosce per TRE segnali, non per il solo colore: il bordo
     d'accento più spesso, il titolo a piena luce contro quello smorzato delle
     altre, e `aria-current` per chi non vede nessuno dei due. */
  .sw__card[aria-current='page'] .sw__thumb {
    border-color: var(--cs-accent, var(--color-accent));
    box-shadow: 0 0 0 1px var(--cs-accent, var(--color-accent));
  }
  .sw__card:not([aria-current]) .sw__title {
    color: var(--cs-text-2, var(--color-text-2));
  }

  /* Hover SOLO come miglioramento, e solo per puntatori precisi: 3px, 180ms.
     Nessuna informazione vive qui dentro. */
  @media (hover: hover) and (pointer: fine) {
    .sw__card:not([aria-current]):hover .sw__thumb {
      transform: translateY(-3px);
      border-color: var(--cs-border, var(--color-hairline-strong));
    }
    .sw__card:hover .sw__title {
      color: var(--cs-text, var(--color-text-1));
    }
  }

  .sw__meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--cs-text-2, var(--color-text-2));
  }
  .sw__card[aria-current='page'] .sw__n {
    color: var(--cs-accent, var(--color-accent));
  }
  .sw__demo {
    padding: 0.2rem 0.45rem;
    border: 1px solid var(--cs-border, var(--color-hairline-strong));
    border-radius: var(--radius-pill);
  }

  .sw__title {
    font-size: var(--text-sm);
    line-height: 1.3;
    text-wrap: balance;
  }

  /* In fondo al foglio: deve vincere sulle regole base qui sopra (stessa
     specificità, decide l'ordine — una media query non ne aggiunge). */
  @media (min-width: 56.25rem) {
    .sw {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: clamp(1.5rem, 3vw, 3rem);
    }
    .sw__bar {
      flex-direction: column;
      align-items: flex-end;
      gap: 1rem;
      padding-bottom: 0.75rem;
    }
    .sw__line {
      flex: none;
      width: 9rem;
    }
  }
</style>
