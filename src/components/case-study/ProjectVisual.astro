---
/**
 * Il visual del palco: lo screenshot (o l'illustrazione) del progetto in una
 * cornice da browser DISCRETA.
 *
 * ⚠ LA BITMAP NON SI DEFORMA MAI. La cornice ha un rapporto fisso (16/10) e
 * l'immagine ci sta dentro con `object-fit`: `contain` la lascia intera con del
 * margine, `cover` la ritaglia tenendo in vista `coverFocal`. Cambia la
 * cornice, mai le proporzioni dell'immagine — anche durante la transizione
 * fra progetti (vedi la nota su `cs-visual` in CaseStudyLayout).
 *
 * ⚠ I CONTROLLI DEL BROWSER SONO DECORATIVI: tre `<span>`, non bottoni, dentro
 * un blocco `aria-hidden`. Sembrare cliccabili sarebbe già un difetto; esserlo
 * per uno screen reader sarebbe peggio.
 *
 * ⚠ È IL CANDIDATO LCP DELLA PAGINA insieme all'h1: `loading="eager"`,
 * `fetchpriority="high"`, e NESSUNA animazione di `opacity` sull'elemento
 * (regola LCP del sito). La transizione fra progetti anima gli snapshot della
 * View Transition, non l'elemento.
 */
import { Picture } from 'astro:assets';
import type { Project } from '../../lib/collections';
import { STAGE_IMG } from '../../lib/stage-media';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const d = project.data;
const host = d.liveUrl ? new URL(d.liveUrl).host : undefined;
const kindLabel =
  d.coverKind === 'screenshot' ? 'Screenshot del progetto' : 'Illustrazione — non è uno screenshot';
---

<figure class="pv" data-cs-frame>
  <div class="pv__bar" aria-hidden="true">
    <span class="pv__dot"></span><span class="pv__dot"></span><span class="pv__dot"></span>
    {host && <span class="pv__url">{host}</span>}
  </div>

  {/* Il fondo della schermata è la superficie della palette: se l'immagine
      arriva lenta, o non arriva, si vede una superficie coerente invece di un
      buco — e il browser mostra l'alt al suo posto. */}
  <div class="pv__screen" data-cs-screen>
    <Picture
      src={d.cover}
      alt={d.coverAlt}
      widths={[...STAGE_IMG.widths]}
      sizes={STAGE_IMG.sizes}
      formats={[...STAGE_IMG.formats]}
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="pv__img"
      style={`object-fit: ${d.coverFit}; object-position: ${d.coverFocal.x}% ${d.coverFocal.y}%;`}
    />
  </div>

  {
    d.coverMobile && d.coverMobileAlt && (
      <div class="pv__phone">
        <Picture
          src={d.coverMobile}
          alt={d.coverMobileAlt}
          widths={[160, 240, 320]}
          sizes="10rem"
          formats={['avif', 'webp']}
          loading="lazy"
          decoding="async"
          class="pv__phone-img"
        />
      </div>
    )
  }

  <figcaption class="pv__cap">{kindLabel}</figcaption>
</figure>

<style>
  .pv {
    position: relative;
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }

  /* La cornice è un filetto e una barra: stesso vocabolario dei device in CSS
     di §03 (riduttivi, non fotorealistici). Niente ombra da presentazione né
     prospettiva: il riferimento le aveva, qui sarebbero un oggetto incollato
     sopra la pagina. */
  .pv__bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    height: 2rem;
    padding-inline: 0.85rem;
    border: 1px solid var(--cs-border, var(--color-hairline));
    border-bottom: 0;
    border-radius: var(--radius-frame) var(--radius-frame) 0 0;
    background-color: color-mix(in oklab, var(--cs-surface, var(--color-surface-1)) 88%, transparent);
  }
  .pv__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background-color: var(--cs-border, var(--color-hairline-strong));
  }
  .pv__url {
    margin-left: 0.75rem;
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.04em;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: var(--cs-text-2, var(--color-text-2));
  }

  .pv__screen {
    aspect-ratio: 16 / 10;
    overflow: clip;
    border: 1px solid var(--cs-border, var(--color-hairline));
    border-radius: 0 0 var(--radius-frame) var(--radius-frame);
    background-color: var(--cs-surface, var(--color-surface-1));
  }
  /* La barra e lo schermo sono due scatole, ma la griglia della figure mette
     un gap fra tutti i figli: lo si annulla fra queste due. */
  .pv__bar + .pv__screen {
    margin-top: -0.75rem;
  }

  .pv__img {
    width: 100%;
    height: 100%;
  }
  /* `<Picture>` avvolge l'<img> in un <picture>: deve riempire anche lui. */
  .pv__screen :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Lo screenshot mobile, SOLO se esiste: sporge dal bordo in basso a sinistra
     e dà al palco la profondità del riferimento senza inventare un device. */
  .pv__phone {
    display: none;
  }
  @media (min-width: 56.25rem) {
    .pv__phone {
      display: block;
      position: absolute;
      left: -1.5rem;
      bottom: 1.25rem;
      width: clamp(6rem, 9vw, 9rem);
      aspect-ratio: 9 / 19.5;
      overflow: clip;
      border: 1px solid var(--cs-border, var(--color-hairline-strong));
      border-radius: 1.1rem;
      background-color: var(--cs-surface, var(--color-surface-1));
    }
    .pv__phone :global(picture),
    .pv__phone-img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 50% 0;
    }
  }

  .pv__cap {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cs-text-2, var(--color-text-2));
  }
</style>
