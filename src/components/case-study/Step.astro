---
/**
 * Un passo dentro <Steps>. Il corpo è markdown normale (lo slot).
 */
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<li class="step">
  <h3 class="step__title">{title}</h3>
  <div class="step__body"><slot /></div>
</li>

<style>
  .step {
    counter-increment: cs-step;
    display: grid;
    gap: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--cs-border, var(--color-hairline));
  }
  /* ⚠ Dentro `.prose` gli <ol> sono già numerati (prose.css: rientro, numero
     in `::before`, margine fra le voci). Senza queste tre righe ogni passo
     avrebbe DUE numeri. Lo scope di Astro alza la specificità quanto basta. */
  .step {
    padding-left: 0;
  }
  .step::before {
    content: none;
  }
  .step + .step {
    margin-top: 0;
  }

  .step__title {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    margin: 0;
    font-size: var(--text-h3);
    line-height: 1.15;
    letter-spacing: -0.015em;
  }
  .step__title::before {
    content: counter(cs-step, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: 0.09em;
    color: var(--color-accent);
  }

  /* Il primo e l'ultimo paragrafo del corpo non aggiungono margine al passo:
     la spaziatura la decide la lista. */
  .step__body :global(> :first-child) {
    margin-top: 0;
  }
  .step__body :global(> :last-child) {
    margin-bottom: 0;
  }
</style>
