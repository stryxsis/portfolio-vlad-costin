---
/**
 * §04 DICONO — sceglie l'impianto in base a QUANTE citazioni ci sono.
 *
 * È il solo file che le pagine importano: `index.astro` scrive
 * `<Testimonials slot="out" n="04" />` e non sa, né deve sapere, quale dei due
 * impianti verrà reso. Il giorno in cui Vlad aggiunge la sesta testimonianza la
 * Home cambia layout da sola.
 *
 * ⚠ PERCHÉ AUTOMATICO E NON UN IMPORT DA CAMBIARE A MANO. Perché il difetto che
 * si evita è SILENZIOSO: il muro con tre citazioni non si rompe, si limita a
 * ripetere le stesse tre frasi in loop in una colonna sola — sembra funzionare.
 * Un impianto sbagliato che sembra funzionare è peggio di uno rotto, perché
 * nessuno va a controllarlo. Qui la soglia è dichiarata in un posto solo e non
 * c'è niente da ricordarsi.
 *
 * ┌──────────┬───────────────────┬──────────────────────────────────────────┐
 * │ citazioni│ impianto          │ perché                                   │
 * ├──────────┼───────────────────┼──────────────────────────────────────────┤
 * │    0     │ niente            │ la sezione non esiste (vedi `show`)      │
 * │    1     │ Focus, reg. solo  │ la citazione prende la scena             │
 * │   2-5    │ Focus, reg. righe │ una riga per voce, il corpo scala        │
 * │    6+    │ Wall (2 colonne)  │ da qui in poi scorrere è l'unica         │
 * │    9+    │ Wall (3 colonne)  │ risposta onesta allo spazio              │
 * └──────────┴───────────────────┴──────────────────────────────────────────┘
 *
 * ⚠ LA SOGLIA È 6, E I DUE NUMERI CHE LA DECIDONO SONO GEOMETRICI, non di gusto.
 * Da sotto: le righe editoriali si dividono un viewport meno il titolo, cioè
 * ~615px a 900 di altezza; a sei righe sarebbero ~100px l'una, dove una
 * citazione di tre righe non ci sta più insieme al nome. Da sopra: il muro
 * riempie le colonne con almeno tre card ciascuna (o la traccia diventa più
 * corta della finestra e ad ogni giro passa un buco), quindi la prima
 * configurazione sensata è 2 colonne × 3 = 6. Le due condizioni si incontrano
 * esattamente lì: sotto 6 le righe reggono, da 6 il muro ha senso.
 *
 * ⚠ E PERCHÉ NON PROVARE A ESSERE PIÙ FINI DI COSÌ. Si potevano fare quattro o
 * cinque impianti, uno per numero. Sarebbero stati quattro o cinque percorsi di
 * codice di cui, in un dato momento, uno solo è visibile — cioè quattro modi di
 * rompersi in silenzio. Due impianti con un registro interno coprono ogni numero
 * da 1 a ∞ e sono entrambi guardabili in qualunque momento.
 */
import TestimonialsFocus from './TestimonialsFocus.astro';
import TestimonialsWall from './TestimonialsWall.astro';
import { TESTIMONIALS } from '../../data/testimonials';
import { SITE } from '../../lib/site';

interface Props {
  n?: string;
  /** Deve combaciare col `tone` dell'Handoff che la contiene, come in Statement. */
  tone?: 'paper' | 'canvas';
  /**
   * Forza un impianto invece di ricavarlo dal numero. ⚠ ESISTE PER GUARDARE, non
   * per decidere: serve alla pagina di anteprima che mostra tutti i registri
   * affiancati. In una pagina vera non va usato — scavalcare la soglia significa
   * scegliere a mano un impianto che poi non si aggiorna quando i dati cambiano,
   * cioè esattamente il difetto che questo file esiste per impedire.
   */
  force?: 'focus' | 'wall' | undefined;
  /** Anteprima: mostra solo le prime N citazioni. Stessa avvertenza di `force`. */
  limit?: number | undefined;
}
const { n = '04', tone = 'canvas', force, limit } = Astro.props;

/* Doppia condizione per accendersi: il flag in site.ts E almeno una voce nei
   dati. Due controlli e non uno perché sono due errori diversi: alzare il flag
   senza avere citazioni renderebbe una sezione vuota, e avere citazioni col flag
   basso le terrebbe nascoste senza dirlo.
   ⚠ Oggi le voci sono SEGNAPOSTO, accese su richiesta esplicita per lavorare
   sulla grafica — vedi l'avviso in testa a data/testimonials.ts. */
const items = limit ? TESTIMONIALS.slice(0, limit) : TESTIMONIALS;
const show = SITE.features.testimonials && items.length > 0;

/** La soglia. Un numero, un posto. */
const SOGLIA_MURO = 6;
const impianto = force ?? (items.length >= SOGLIA_MURO ? 'wall' : 'focus');
---

{
  show &&
    (impianto === 'wall' ? (
      <TestimonialsWall items={items} n={n} tone={tone} />
    ) : (
      <TestimonialsFocus items={items} n={n} tone={tone} />
    ))
}
