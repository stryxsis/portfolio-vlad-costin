---
/**
 * §30 INVENTARIO — le competenze.
 *
 * NON barre di percentuale. Una barra al 70% non significa niente (70% di cosa?
 * misurato da chi?) ed è il cliché più riconoscibile del portfolio da studente:
 * chi legge sa che il numero è stato scelto a occhio. Un elenco tipografico dice
 * la stessa cosa senza inventare dati, e costa zero pixel di grafica.
 *
 * La forma è quella di un inventario reale: riga per gruppo, etichetta mono a
 * sinistra, voci in colonne a destra. Le voci vanno a capo una per riga (CSS
 * `columns`) e non a nuvola di chip, perché una lista incolonnata si scorre con
 * l'occhio mentre una nuvola va letta tutta.
 *
 * ⚠ IL TITOLO GIOCA SU UN'AMBIGUITÀ, chiesto da Vlad (2026-08-14): "Le mie
 * altre lingue" può leggersi come linguaggi di programmazione (il gruppo
 * `Lingue` qui sotto è in realtà l'ULTIMO di una lista che comincia con
 * JavaScript/PHP/Python/…) o come lingue parlate (l'ultimo gruppo davvero lo
 * è). La lede sotto scioglie il gioco di parole per chi non l'ha colto.
 *
 * ⚠ QUESTO RIBALTA "nessun accento in questa sezione", nota che stava qui
 * prima: due parole della lede si accendono con lo STESSO gesto di `.jr__key`
 * in chi-sono.astro (§02 Percorso) — filetto che si tira sotto, non l'alone di
 * `.ap__key` in Approach.astro, perché a questo corpo (16-19px) un
 * text-shadow sfumato sarebbe solo una sbavatura, non luce. Vedi la nota
 * accanto a `.jr__key` per il perché estende. */
import SectionIndex from '../primitives/SectionIndex.astro';
import { SKILLS, LANGUAGES } from '../../data/skills';

interface Props {
  /** Numero d'indice della sezione nella pagina che la ospita. */
  n?: string;
  id?: string;
}
const { n = '03', id = 'competenze' } = Astro.props;
---

<section class="sk" data-section id={id}>
  <div class="sk__grid">
    <div class="sk__idx">
      <SectionIndex n={n} label="Inventario" />
    </div>

    <div class="sk__body">
      {/* `data-activate` sul contenitore, `data-split` sul titolo: mai sullo
          stesso elemento (vedi reveal.ts). Stesso schema di `.jr__head` in
          chi-sono.astro, da cui questo blocco riusa il gesto. */}
      <div class="sk__intro" data-activate>
        <h2 class="sk__title" data-split="lines">
          Le mie altre lingue
        </h2>
        <p class="sk__lede">
          Se ti interessa il <strong class="sk__key" style="--i: 0">lato puramente tecnico</strong> (o se sei un altro sviluppatore venuto qui per spulciare come lavoro), ecco le <strong class="sk__key" style="--i: 1">lingue che parlo correntemente</strong> quando non parlo italiano:
        </p>
      </div>

      <div class="sk__groups">
        {
          /* `data-reveal` sul GRUPPO e non sulle singole voci: sono ~36 voci, e
             una per elemento significherebbe sei o sette batch di ScrollTrigger
             solo per questa sezione. Il gruppo è comunque l'unità giusta —
             l'onda che si vuole vedere è quella delle righe. */
          SKILLS.map((g) => (
            <div class="sk__group" data-reveal>
              <div class="sk__head">
                <h3 class="sk__label">{g.label}</h3>
                {g.note && <p class="sk__note">{g.note}</p>}
              </div>
              <ul class="sk__items">
                {g.items.map((item) => (
                  <li class="sk__item">{item}</li>
                ))}
              </ul>
            </div>
          ))
        }

        {/* Le lingue chiudono l'inventario: stessa forma, valore accostato. */}
        <div class="sk__group" data-reveal>
          <div class="sk__head">
            <h3 class="sk__label">Lingue</h3>
          </div>
          <ul class="sk__items">
            {
              LANGUAGES.map((l) => (
                <li class="sk__item">
                  {l.name}
                  <span class="sk__level">{l.level}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .sk {
    padding-block: var(--spacing-section);
  }

  .sk__grid {
    display: grid;
    max-width: 90rem;
    margin-inline: auto;
    padding-inline: var(--spacing-gutter);
    gap: 2rem;
  }
  @media (min-width: 56.25rem) {
    .sk__grid {
      grid-template-columns: repeat(12, 1fr);
      gap: 0 clamp(1rem, 1.5vw, 2rem);
    }
    .sk__idx {
      grid-column: 11 / span 2;
      grid-row: 1;
      justify-self: end;
    }
    .sk__body {
      grid-column: 2 / span 8;
      grid-row: 1;
    }
  }

  .sk__title {
    max-width: 22ch;
    font-size: var(--text-h2);
    line-height: 1.05;
    letter-spacing: -0.025em;
  }

  /* La lede sotto il titolo: scioglie il gioco di parole per chi non l'ha
     colto al volo. Stessa misura e stesso colore di `.jr__lede`. */
  .sk__lede {
    margin-top: clamp(1.25rem, 2.5vw, 1.75rem);
    max-width: 62ch;
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--color-text-2);
  }
  :global(html.js-anim) .sk__lede {
    opacity: 0;
    transform: translateY(0.5rem);
    /* Entra DOPO il titolo: M1 spacca l'h2 in righe e le fa salire in ~1s
       (0,9s + stagger). 550ms la fa arrivare mentre il titolo si sta ancora
       posando, senza aspettare che finisca — stessi numeri di `.jr__lede`,
       stesso meccanismo sottostante (M1 non è cambiato). */
    transition:
      opacity 700ms var(--ease-out-expo) 550ms,
      transform 700ms var(--ease-out-expo) 550ms;
  }
  :global(html.js-anim) .sk__intro.is-in .sk__lede {
    opacity: 1;
    transform: none;
  }

  /* ---- Le parole chiave della lede ----------------------------------------
     ⚠ STESSO GESTO di `.jr__key` in chi-sono.astro (§02 Percorso): filetto
     che si tira sotto, non l'alone di `.ap__key` in Approach.astro — quel
     testo è a 42px, dove un text-shadow sfumato si legge come luce; qui il
     corpo è 16-19px e lo stesso alone sarebbe solo una sbavatura. */
  .sk__key {
    position: relative;
    font-weight: 500;
    /* Stato finale: è anche quello del ramo senza JS e di reduced-motion. */
    color: var(--color-accent);
  }
  .sk__key::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.15em;
    height: 1px;
    background-color: var(--color-accent);
    transform-origin: left;
  }

  /* Nel ramo animato partono spente — dello stesso grigio del testo intorno,
     mai invisibili: è l'invariante di M14 (la pausa trattiene colore, non
     informazione). */
  :global(html.js-anim) .sk__key {
    color: var(--color-text-2);
    transition: color 500ms var(--ease-out-expo);
  }
  :global(html.js-anim) .sk__key::after {
    transform: scaleX(0);
    transition: transform 600ms var(--ease-out-expo);
  }
  /* Ancorate a `is-in` con un RITARDO, non a `is-on`: due soglie di scroll
     vicine si sovrappongono per chi scorre veloce e restano separate per
     sempre per chi si ferma — vedi la stessa lezione in Approach.astro.
     1350ms = il reveal del titolo (~1s) più la lede che entra a 550ms, così
     le parole si accendono su una frase già arrivata e ferma. */
  :global(html.js-anim) .sk__intro.is-in .sk__key {
    color: var(--color-accent);
    transition-delay: calc(1350ms + var(--i, 0) * 180ms);
  }
  :global(html.js-anim) .sk__intro.is-in .sk__key::after {
    transform: scaleX(1);
    transition-delay: calc(1350ms + var(--i, 0) * 180ms);
  }

  /* Salto d'ancora o tasto Fine: stato finale senza attesa. Deve restare DOPO
     le regole di `is-in`, che hanno la stessa specificità. */
  :global(html.js-anim) .sk__intro.is-instant .sk__lede,
  :global(html.js-anim) .sk__intro.is-instant .sk__key,
  :global(html.js-anim) .sk__intro.is-instant .sk__key::after {
    transition-duration: 0s;
    transition-delay: 0s;
  }

  .sk__groups {
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  /* Il filetto superiore è il separatore: nessun bordo di card, nessuna
     superficie. Le righe sono tenute insieme dallo spazio. */
  .sk__group {
    display: grid;
    gap: 1rem;
    padding-block: clamp(1.5rem, 3vw, 2.25rem);
    border-top: 1px solid var(--color-hairline);
  }
  @media (min-width: 37.5rem) {
    .sk__group {
      grid-template-columns: minmax(0, 11rem) minmax(0, 1fr);
      gap: clamp(1.5rem, 3vw, 3rem);
    }
  }

  .sk__label {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-text-3);
  }

  .sk__note {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.1em;
    /* text-3 e non hairline-strong: a 11px serve 4.5:1, e hairline-strong è
       3.48:1. Il pavimento del contrasto per il testo è --color-text-3. */
    color: var(--color-text-3);
  }

  /* `columns` invece di flex-wrap: le voci restano una per riga e incolonnate,
     che è la differenza tra un inventario e una nuvola di tag. */
  .sk__items {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 2;
    column-gap: clamp(1.5rem, 3vw, 3rem);
  }
  @media (min-width: 75rem) {
    .sk__items {
      columns: 3;
    }
  }

  .sk__item {
    break-inside: avoid;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.9;
    color: var(--color-text-1);
  }

  /* `display: block` e non un inline accostato al nome: "Italiano madrelingua"
     è 19 caratteri e andava a capo dentro la colonna, mentre "Romeno
     madrelingua" (18) no. Un a capo che dipende da un carattere di differenza
     legge come un difetto; metterlo sempre sulla riga sotto lo rende una
     scelta, e a quel punto il livello può anche rimpicciolirsi. */
  .sk__level {
    display: block;
    font-size: var(--text-micro);
    line-height: 1.4;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-3);
  }
</style>