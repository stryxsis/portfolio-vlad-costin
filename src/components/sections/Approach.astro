---
/**
 * LA FASCIA DEL METODO — l'aside tipografico di /chi-sono, subito dopo la hero.
 *
 * Chiesta da Vlad (2026-08-13) come "Il Superpotere (La Filosofia e il
 * Mindset)". Fra le forme possibili ha scelto lui **la citazione pura**: «non
 * ci sono colonne o griglie, solo una frase a tutto schermo (ma non
 * altissima) che spezza il ritmo visivo», in grigio chiaro «per non urlare
 * troppo». Il testo è suo, parola per parola — non riscriverlo senza chiedere.
 *
 * ⚠ SECONDO GIRO, STESSO GIORNO: la prima stesura era solo la frase grigia,
 * e Vlad l'ha bocciata — «non mi piace lo stile della scritta, non il font
 * dico, proprio che è vuota, non ha personalità». Da qui i tre dispositivi
 * qui sotto (parole d'accento, accensione a scaglioni, alone che scalda la
 * fascia). **Il testo NON è cambiato**: a mancare non era cosa dice, era che
 * lo diceva tutto sullo stesso tono.
 *
 * ⚠ TERZO GIRO, STESSO GIORNO: l'alone di quel secondo giro era un
 * `radial-gradient` a tre stop, e Vlad l'ha bocciato ANCHE quello — «sembra
 * un bug del sito». Aveva ragione: uno screenshot ingrandito mostrava un
 * VIGNETTING simmetrico (angoli scuri, centro chiaro, nessuna sorgente
 * riconoscibile) — esattamente il pattern che si vede quando qualcuno
 * dimentica un overlay di debug, non quando lo si è disegnato apposta.
 * Sostituito con un BLOB SFOCATO (vedi `.ap::before` più sotto): `filter:
 * blur()` non ha mai uno stop geometrico definito, quindi non può produrre
 * un bordo — il difetto che il gradiente aveva per costruzione. Anche la
 * soglia d'accensione delle parole è cambiata nello stesso giro, vedi
 * `data-on` più sotto.
 *
 * ⚠ NIENTE NUMERO D'INDICE, ed è la regola del sito applicata, non una
 * dimenticanza: `SectionIndex.astro` dichiara che le sezioni statement non
 * sono numerate perché è **la numerazione stessa** a distinguere il contenuto
 * dalla pausa. Questa è una pausa: una frase sola, nessun titolo, nessun
 * elenco. Conseguenza da NON "correggere": su /chi-sono i numeri restano
 * 00 → 02 → 03 e questa fascia sta in mezzo senza uno suo.
 *
 * ⚠ È UN <h2> E NON UN <p>, per la stessa ragione di `Statement.astro`: la
 * frase È il titolo della sezione, quindi la semantica è corretta — e in più
 * l'`aria-label` che SplitText mette sul contenitore è PROIBITO sul ruolo
 * `paragraph`, mentre su un heading è legittimo. Senza heading la sezione
 * resterebbe anche senza nome accessibile.
 *
 * ⚠ NON RIUSA IL DISPOSITIVO DELLO STATEMENT della Home (parola-fantasma,
 * timbro editoriale, filetto cinetico sotto l'accento, tre registri di corpo).
 * Stessa famiglia — un aside tipografico con delle parole in evidenza — ma
 * gesto diverso: lì l'accento è una SOTTOLINEATURA che si tira, qui è una
 * ACCENSIONE a scaglioni, e non c'è nessun secondo piano tipografico.
 */
import { SITE } from '../../lib/site';

interface Props {
  id?: string;
}
const { id = 'metodo' } = Astro.props;

/**
 * Le parole che si accendono.
 *
 * ⚠ SONO TRE SOSTANTIVI, E NON UNA FRASE INTERA MARCATA. Sono i tre
 * ingredienti veri del metodo — quello che c'è al posto del "talento innato"
 * che la prima frase nega — quindi accenderli produce tre battute che si
 * leggono come un elenco senza esserlo. È anche il modo in cui questa sezione
 * rispetta il divieto di liste puntate: l'enumerazione è nel ritmo, non nei
 * pallini.
 *
 * ⚠ E SONO POCHE DI PROPOSITO: l'accento marca ciò che conta, e se conta
 * mezza frase non conta niente. Aggiungendone, verificare che restino una
 * minoranza netta del testo.
 */
const CHIAVI = ['caffè', 'nottate', 'ossessione'];

interface Frammento {
  testo: string;
  /** Indice progressivo della parola accesa, o null se è testo normale.
   *  ⚠ Serve a scaglionare l'accensione via `--i` invece che con
   *  `nth-of-type`: SplitText riparenta le parole dentro i wrapper di riga,
   *  quindi un `nth-of-type` ripartirebbe da 1 ad ogni riga e lo scaglione
   *  si vedrebbe ricominciare a metà frase. */
  i: number | null;
}

/**
 * Ritaglia le parole chiave dalla stringa, lasciandola testo puro nei dati.
 *
 * L'alternativa — scrivere gli <strong> dentro `SITE.credo` — costringerebbe
 * a `set:html`, cioè a rinunciare all'escaping su un testo che Vlad riscrive
 * a mano. Stessa scelta, e stessa ragione, di `Statement.astro`.
 */
let frammenti: Frammento[] = [{ testo: SITE.credo, i: null }];
CHIAVI.forEach((chiave, i) => {
  frammenti = frammenti.flatMap((f) => {
    if (f.i !== null) return [f];
    const at = f.testo.indexOf(chiave);
    if (at === -1) return [f];
    return [
      { testo: f.testo.slice(0, at), i: null },
      { testo: chiave, i },
      { testo: f.testo.slice(at + chiave.length), i: null },
    ];
  });
});
frammenti = frammenti.filter((f) => f.testo.length > 0);

/* Guardia di sviluppo: una parola chiave che non compare più nel testo (Vlad
   riscrive la frase, la parola sparisce) non romperebbe niente — la fascia
   tornerebbe semplicemente grigia e piatta, cioè esattamente il difetto che
   questi tre dispositivi esistono per chiudere. Silenzioso e invisibile è il
   modo peggiore di rompersi. Solo in dev: non fa fallire una build. */
if (import.meta.env.DEV) {
  const perse = CHIAVI.filter((c) => !SITE.credo.includes(c));
  if (perse.length > 0) {
    console.warn(`[Approach] parola chiave non trovata in SITE.credo: ${perse.join(', ')}`);
  }
}
---

{
  /* `.theme-slate` sul <section>: il tema ridichiara `--color-canvas` E si
     dipinge da solo (`background-color: var(--color-canvas)`), quindi la
     fascia è già a tutta larghezza senza nessun trucco full-bleed — la
     sezione è un blocco in flusso normale, larga quanto il body.
     ⚠ Slate e non paper: l'avorio è l'unico momento di luce della Home ed è
     un evento perché è isolato. Qui servirebbe anche il contrario di quello
     che Vlad ha chiesto — «grigio chiaro per non urlare» descrive testo
     smorzato su fondo scuro, non un'inversione a tutta pagina.

     ⚠ `data-activate` (M14) STA SULLA SEZIONE e non su un wrapper interno,
     al contrario di Statement.astro: qui le classi servono a DUE cose che
     stanno a livelli diversi dell'albero — l'alone, che è uno `::before`
     della sezione, e le parole, che stanno nell'h2. Marcando il wrapper
     servirebbe un `:has()` per risalire all'alone; marcando la sezione, sono
     entrambi discendenti e non serve niente.
     ⚠ E la sezione NON porta `data-reveal`: i due non vanno mai insieme
     (vedi reveal.ts), o il fade generico di M4 coprirebbe l'accensione.

     ⚠ `data-on="72"`: soglia PROPRIA per l'accensione, chiesta da Vlad il
     giorno stesso — «non quando la sezione si trova a metà schermo ma
     quando si trova a metà della parte bassa dello schermo». Metà della
     metà inferiore (50-100%) è 75%; 72 la anticipa di un soffio perché
     l'accensione a scaglioni impiega ~950ms (tre parole × 160ms + gli
     620ms della più tardiva) a risolversi, e deve poter FINIRE mentre la
     fascia è ancora comoda da leggere, non cominciare a fascia già quasi
     a mezzo schermo. Il default resta 40 per tutti gli altri consumer di
     M14 (`.wid__clauses`) — vedi `data-on` in reveal.ts. */
}
<section class="ap theme-slate" {id} data-activate data-on="72">
  <div class="ap__wrap">
    {
      /* `data-split="lines"` (M2) sull'h2 e `data-activate` sulla sezione:
         mai sullo stesso elemento. Le righe salgono da sole alla loro
         soglia; l'accensione delle parole arriva dopo, alla propria. */
    }
    <h2 class="ap__quote" data-split="lines">
      {
        frammenti.map((f) =>
          f.i === null ? (
            f.testo
          ) : (
            /* <strong> e non <em>: queste parole hanno IMPORTANZA, non
               enfasi di tono — e <em> renderebbe in corsivo, che con Geist
               caricato solo in tondo (vedi astro.config.mjs) sarebbe un
               obliquo sintetico. Il peso lo ridichiara il CSS a 500, o il
               `bolder` di default diventerebbe un finto 700.
               ⚠ TUTTO SU UNA RIGA, e non è formattazione: andando a capo
               dentro il tag, l'indentazione entra nel testo renderizzato
               come spazio vero. Si vedeva — "caffè , nottate" con lo spazio
               prima della virgola, perché la virgola sta nel frammento
               DOPO e non dentro la parola marcata. */
            <strong class="ap__key" style={`--i: ${f.i}`}>{f.testo}</strong>
          )
        )
      }
    </h2>
  </div>
</section>

<style>
  .ap {
    position: relative;
    /* L'alone sborda oltre la fascia: senza ritaglio finirebbe sul nero
       delle sezioni vicine e la banda perderebbe i suoi bordi netti. */
    overflow: clip;
    /* Non `100svh`: Vlad l'ha chiesta esplicitamente "non altissima". La
       fascia si dimensiona sul proprio contenuto più l'aria intorno, che è
       ciò che la fa leggere come una pausa e non come una tappa. */
    padding-block: clamp(5rem, 14vh, 9rem);
  }

  /* ---- L'alone che scalda la fascia ---------------------------------------
     ⚠ È LA RISPOSTA ALLA PARTE "VUOTA" DELLA CRITICA, non alla parte
     "tipografica": con la sola frase la banda era un rettangolo di colore
     piatto, e nessuna quantità di lavoro sul testo dà profondità a un fondo
     che non ne ha. Un solo alone d'accento, molto basso di alfa, dietro al
     testo.
     ⚠ NON è il cielo della CTA e non deve diventarlo: quello è un campo di
     onde CHE SI MUOVONO ed è l'evento di chiusura della Home. Questo è
     statico, entra una volta e resta — la fascia si scalda quando le parole
     si accendono, e quella è tutta la sua vita.

     ⚠ ERA UN `radial-gradient` A TRE STOP, bocciato da Vlad («sembra un bug
     del sito»). Aveva ragione: tre stop concentrici su un fondo scuro
     producono un VIGNETTING simmetrico — angoli scuri, centro chiaro,
     nessuna sorgente riconoscibile — che è esattamente il pattern di un
     overlay di debug dimenticato, non di una luce disegnata apposta.

     ⚠ ORA È UN BLOB SFOCATO, non un gradiente: `filter: blur()` non ha MAI
     uno stop geometrico definito (un gradiente finisce a un raggio preciso,
     una sfocatura degrada senza un bordo), quindi non può produrre il
     "vignetting" che il gradiente aveva per costruzione — è la stessa
     ragione per cui il velo della Home usa `blur()` invece di un overlay a
     opacità. Un rettangolo pieno, sfumato dalla sfocatura stessa, resta più
     stretto e più basso del testo (`min(38rem, 74%)` × `9rem` contro
     `.ap__quote` a 38ch su ~3 righe): legge come "la luce dietro le parole"
     invece che "un patch a caso nel riquadro".
     ⚠ L'opacità del colore è tarata sul contrasto, non a occhio: il testo
     grigio e le parole d'accento stanno SOPRA questo alone, quindi ogni
     punto guadagnato di luminanza del fondo è contrasto perso. Rimisurare
     con `npm run sample:px` toccandolo. */
  .ap::before {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    z-index: 0;
    width: min(30rem, 60%);
    height: 6rem;
    /* Ellisse e non rettangolo: sfocata, è la differenza fra "una luce" e
       "una macchia". Un bordo dritto sfumato resta leggibile come un
       rettangolo ammorbidito; un'ellisse sfumata non ha spigoli da smorzare. */
    border-radius: 50%;
    background: color-mix(in oklab, var(--color-accent) 16%, transparent);
    filter: blur(110px);
    pointer-events: none;
  }

  /* Senza JS l'alone è già lì: è un fondo, non un ingresso. Il gate lo
     spegne solo nel ramo animato, dove ha una soglia a cui accendersi. */
  :global(html.js-anim) .ap::before {
    opacity: 0;
    transition: opacity 1100ms var(--ease-out-expo);
  }
  :global(html.js-anim) .ap.is-in::before {
    opacity: 1;
  }

  .ap__wrap {
    position: relative;
    /* Sopra l'alone. Senza, il gradiente coprirebbe il testo. */
    z-index: 1;
    max-width: 90rem;
    margin-inline: auto;
    padding-inline: var(--spacing-gutter);
  }

  .ap__quote {
    /* ⚠ La misura è in `ch` e non in px: fissa i CARATTERI per riga, quindi
       il numero di RIGHE resta ~4 a qualunque corpo la scala fluida produca.
       Con una larghezza in px il testo si allungherebbe di una riga proprio
       sui viewport stretti, dove lo spazio manca di più. */
    max-width: 38ch;
    margin-inline: auto;
    text-align: center;
    text-wrap: balance;

    /* Un corpo intermedio, sotto i titoli di sezione: la frase deve occupare
       lo schermo senza competere con l'h1 della hero che le sta sopra. */
    font-size: clamp(1.5rem, 3vw, 2.625rem);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.02em;

    /* ⚠ `text-2` e MAI `text-3`: è il "grigio chiaro per non urlare" chiesto
       da Vlad, ma il pavimento di contrasto per il testo resta `text-2` —
       `text-3` è sotto AA (difetto noto di palette, vedi CLAUDE.md) e questa
       è la frase più importante della sezione, non un metadato. */
    color: var(--color-text-2);
  }

  /* ---- Le parole che si accendono ----------------------------------------
     ⚠ IL PESO È 500 SEMPRE, E NON È UN'ANIMAZIONE MANCATA: far passare la
     parola da 400 a 500 mentre si accende la farebbe diventare più LARGA, e
     una parola che si allarga dentro una riga già spezzata da SplitText
     sposta tutto ciò che le sta dopo — a occhio è uno scatto del testo, non
     un'accensione. Il peso è quindi struttura (queste parole contano da
     subito, anche spente) e a fare l'evento è il solo colore.
     ⚠ 500 e non 700: `astro.config.mjs` carica Geist a 400 e 500. Un `bold`
     vero non esiste in questo sito, e chiederlo produrrebbe un grassetto
     SINTETICO — le stesse aste ingrossate dal browser. */
  .ap__key {
    font-style: normal;
    font-weight: 500;
    /* Stato finale, che è anche quello del ramo senza JS e di
       reduced-motion: la parola è accesa e basta. */
    color: var(--color-accent);
    text-shadow: 0 0 0.6em color-mix(in oklab, var(--color-accent) 26%, transparent);
  }

  /* Nel ramo animato le parole partono SPENTE — cioè dello stesso grigio del
     testo intorno.
     ⚠ "Spento" qui non vuol dire invisibile né illeggibile, ed è l'invariante
     che regge tutta M14 (vedi reveal.ts): mentre aspetta la propria soglia la
     frase è già leggibile per intero, la pausa trattiene solo colore. */
  :global(html.js-anim) .ap__key {
    color: var(--color-text-2);
    text-shadow: 0 0 0.6em transparent;
  }

  :global(html.js-anim) .ap.is-on .ap__key {
    animation: ap-accendi 620ms var(--ease-out-expo) forwards;
    /* Lo scaglione. `--i` arriva dal markup (vedi il commento su Frammento):
       160ms sono quanto basta a leggere tre battute distinte senza che la
       terza arrivi quando lo sguardo è già andato oltre. */
    animation-delay: calc(var(--i, 0) * 160ms);
  }

  /* ⚠ L'accensione è un'ANIMAZIONE con un fotogramma intermedio e non una
     transizione, perché deve SCAVALCARE il valore finale: la parola arriva a
     `accent-hi` (il tono più luminoso della palette) e poi si posa su
     `accent`. Una transizione può solo avvicinarsi al bersaglio, e senza
     quello scarto l'accensione legge come un cambio di colore invece che
     come qualcosa che si accende. È la stessa tecnica del LED sui numeri
     01/02/03 di WhatIDo, qui su colore e alone insieme. */
  @keyframes ap-accendi {
    0% {
      color: var(--color-text-2);
      text-shadow: 0 0 0.6em transparent;
    }
    55% {
      color: var(--color-accent-hi);
      text-shadow: 0 0 0.85em color-mix(in oklab, var(--color-accent) 58%, transparent);
    }
    100% {
      color: var(--color-accent);
      text-shadow: 0 0 0.6em color-mix(in oklab, var(--color-accent) 26%, transparent);
    }
  }

  /* ⚠ `is-instant` azzera DURATA E RITARDO, non solo il ritardo: la lezione
     è già costata due volte (vedi M14 in CLAUDE.md). Chi arriva qui con un
     salto — un'ancora, il tasto Fine, il ripristino della posizione al
     reload — non ha visto cominciare niente, e un'accensione di cui nessuno
     ha visto l'inizio non è un'animazione, è solo un ritardo prima di poter
     leggere. */
  :global(html.js-anim) .ap.is-instant .ap__key {
    animation-duration: 0s;
    animation-delay: 0s;
  }
  :global(html.js-anim) .ap.is-instant::before {
    transition-duration: 0s;
  }
</style>
