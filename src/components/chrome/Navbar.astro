---
/**
 * Navbar a due stati.
 *
 * Stato A (top di pagina): barra trasparente a piena larghezza, nessun fondo.
 * Stato B (dopo 4px di scroll): pill piccolo e ravvicinato, con blur.
 *
 * UN SOLO nodo DOM, non due sovrapposti. Le differenze fra i due stati sono
 * tutte proprietà CSS dello stesso elemento (larghezza, gap, background,
 * bordo, raggio, backdrop-filter, altezza), quindi si transizionano in loco.
 * Due nodi cross-fadati avrebbero duplicato i link nell'albero di
 * accessibilità e richiesto un aria-hidden su elementi focusabili — che è
 * esattamente un errore di accessibilità, non un dettaglio.
 *
 * Il morph è TRIGGERATO, non legato allo scroll: una classe su <html>
 * (`nav-compact`) si accende al primo pixel di scroll (src/scripts/nav.ts) e
 * una transizione CSS a durata fissa la porta a termine da sola, sia dopo un
 * pixel di scroll sia dopo mille — mai a metà strada; tornando a top 0 va a
 * rovescio. Una versione precedente legava le stesse proprietà 1:1 allo
 * scroll (`scrub`): essendo proprietà di LAYOUT (larghezza, gap, padding, non
 * solo transform), ricalcolarle a ogni tick pesava più di quanto un singolo
 * passaggio di transizione pesi qui. Durata e curva stanno in DUE token
 * (`--nav-morph-t/-e` su `.nav`) letti da ogni regola, così il morph resta un
 * solo gesto invece di sfaldarsi in animazioni scoordinate.
 *
 * ⚠ Perché la larghezza di arrivo è un numero misurato in JS e non
 * `fit-content`: quest'ultimo è una parola chiave, non interpolabile, e
 * faceva saltare la larghezza in un frame — il difetto che rendeva il morph
 * invisibile. Vedi la nota su `.nav__bar` e `measure()` in nav.ts.
 *
 * `backdrop-filter` è consentito SOLO qui: l'area è piccola (vedi le misure
 * più sotto) e il raggio di blur non viene mai animato di per sé — cambia
 * insieme al resto in un'unica transizione innescata una volta.
 *
 * Menu mobile: <details>/<summary> nativo, quindi funziona anche senza JS.
 * Il JS aggiunge solo lenis.stop()/start() e la chiusura con Escape.
 */
import { NAV, SITE } from '../../lib/site';
import Button from '../primitives/Button.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href;

/* Sulla barra desktop "Contatti" e il bottone "Scrivimi" portavano allo stesso
   posto — ridondante, e la voce in più toglieva anche eleganza alla pillola.
   Il menu mobile non ha un bottone equivalente, quindi lì la voce resta. */
const DESKTOP_NAV = NAV.filter((item) => item.href !== '/contatti');
---

<header class="nav" data-nav>
  <!-- ===== Desktop: un nodo, due stati ===== -->
  <div class="nav__bar">
    {/* L'accessible name contiene il testo visibile "VC": senza questo,
        aria-label e contenuto visibile non combaciano (errore WCAG 2.5.3). */}
    <a href="/" class="nav__badge" aria-label="VC — Vlad Costin, vai alla home">VC</a>

    <nav class="nav__links" aria-label="Navigazione principale">
      {
        DESKTOP_NAV.map((item) => (
          <a
            href={item.href}
            class="nav__link"
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <Button href="/contatti" variant="outline" class="nav__cta">Scrivimi</Button>
  </div>

  <!-- ===== Menu mobile: nativo, funziona senza JS ===== -->
  <details class="nav__mobile" data-nav-mobile>
    <summary class="nav__toggle">
      <span>Menu</span>
      <span class="nav__toggle-bars" aria-hidden="true"><i></i><i></i></span>
    </summary>

    <div class="nav__panel">
      <nav aria-label="Navigazione principale">
        {
          NAV.map((item, i) => (
            <a
              href={item.href}
              class="nav__panel-link"
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              <span class="nav__panel-n" aria-hidden="true">
                {String((i + 1) * 10).padStart(2, '0')}
              </span>
              {item.label}
            </a>
          ))
        }
      </nav>
      <a href={`mailto:${SITE.author.email}`} class="nav__panel-mail">{SITE.author.email}</a>
    </div>
  </details>
</header>

<style>
  /* ⚠ NESSUN `position: fixed` QUI, e non è una svista: il fisso è salito sul
     wrapper `.chrome` in BaseLayout, che contiene navbar E avviso come
     fratelli in flusso. È così che l'avviso spinge giù la navbar — perché le
     sta sopra in un flusso vero, non perché qualcuno sincronizza due
     transform. Rimettere `position: fixed` qui staccherebbe la navbar da quel
     flusso e la spinta smetterebbe di esistere, in silenzio. */
  .nav {
    width: 100%;

    /* UNA durata e UNA curva per tutto il morph, dichiarate una volta qui e
       lette da ogni discendente: il morph deve leggere come UN gesto solo, e
       se durata e curva sono ripetute a mano su ogni regola prima o poi una
       resta indietro e il gesto si sfalda in più animazioni scoordinate.

       1200ms è deliberatamente lungo: la richiesta è vedere la pillola
       rimpicciolirsi a occhio nudo, non accorgersi che è rimpicciolita.
       Ma la durata da sola non basta, e questo è il punto meno ovvio:
       `--ease-fluid` (la ease-out usata prima) a metà durata è già al 90% del
       movimento, quindi allungarla non rendeva il morph più leggibile —
       lasciava lo stesso scatto iniziale e ci aggiungeva un lungo strisciare
       finale. Serve una curva a velocità quasi costante: `--ease-morph`
       esiste per questo (vedi la nota in global.css). */
    --nav-morph-t: 1200ms;
    --nav-morph-e: var(--ease-morph);
  }

  /* Misura invisibile: vedi `measure()` in src/scripts/nav.ts. Per un istante
     la barra riceve le metriche compatte per essere misurata, e NIENTE di
     quel passaggio si deve vedere. */
  :global(html.nav-measuring) .nav__bar,
  :global(html.nav-measuring) .nav__bar * {
    transition: none !important;
  }

  /* -- Desktop ------------------------------------------------------------ */
  .nav__bar {
    display: none;
  }

  @media (min-width: 56.25rem) {
    .nav__bar {
      display: flex;
      align-items: center;
      gap: 2rem;
      /* Stato A */
      width: 100%;
      max-width: none;
      height: var(--nav-h);
      margin-inline: auto;
      margin-top: 0;
      padding-inline: var(--spacing-gutter);
      border: 1px solid transparent;
      border-radius: 0;
      background-color: transparent;
      transition: width var(--nav-morph-t) var(--nav-morph-e),
        height var(--nav-morph-t) var(--nav-morph-e),
        margin-top var(--nav-morph-t) var(--nav-morph-e),
        padding-inline var(--nav-morph-t) var(--nav-morph-e),
        gap var(--nav-morph-t) var(--nav-morph-e),
        border-radius var(--nav-morph-t) var(--nav-morph-e),
        border-color var(--nav-morph-t) var(--nav-morph-e),
        background-color var(--nav-morph-t) var(--nav-morph-e),
        backdrop-filter var(--nav-morph-t) var(--nav-morph-e);
    }

    /* Stato B: pillola raccolta ma non minuscola.
       ⚠ `var(--nav-compact-w)` e NON `fit-content`, che è ciò che si vorrebbe
       scrivere qui: `fit-content` è una parola chiave, CSS non sa interpolare
       `100%` → parola chiave, e la larghezza saltava al valore finale in un
       frame solo mentre tutto il resto animava — il morph si vedeva a metà.
       Il numero lo misura nav.ts (vedi lì la nota lunga). Il fallback 26rem
       serve solo al frame prima della prima misura, e a chi arriva senza JS
       (dove però la classe non viene mai accesa, quindi non si vede mai).

       Nessun `max-width` accanto: `none` → `36rem` non è interpolabile per lo
       stesso motivo, e non serve più — la larghezza di arrivo è già esatta.

       `gap: 1.75rem` qui è la distanza badge↔link e link↔bottone: leggermente
       più larga di quella FRA i link (1.5rem in `.nav__links` più sotto) di
       proposito — il logo resta un po' più staccato dal gruppo di link. */
    :global(html.nav-compact) .nav__bar {
      width: var(--nav-compact-w, 26rem);
      height: 3rem;
      margin-top: 0.75rem;
      padding-inline: 0.5rem;
      gap: 1.75rem;
      border-radius: var(--radius-pill);
      border-color: var(--color-hairline);
      /* 92% e non 82%: la navbar passa SOPRA le due sezioni full-bleed chiare, e
         a 82% la carta traspare abbastanza da portare il pill a un grigio medio
         (#343434). Restava conforme — 4.9:1 coi link — ma leggeva come slavato
         invece che come scelto. A 92% resta near-black su qualunque fondo: la
         chrome appartiene alla stanza scura, e le sezioni chiare sono finestre
         che le passano dietro. */
      background-color: color-mix(in oklab, var(--color-canvas) 92%, transparent);
      backdrop-filter: blur(14px);
    }
  }

  .nav__badge {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 1px solid var(--color-hairline);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 500;
    color: var(--color-text-1);
    text-decoration: none;
    transition:
      border-color 240ms var(--ease-snappy),
      width var(--nav-morph-t) var(--nav-morph-e),
      height var(--nav-morph-t) var(--nav-morph-e);
  }
  .nav__badge:hover {
    border-color: var(--color-accent);
  }
  :global(html.nav-compact) .nav__badge {
    width: 2rem;
    height: 2rem;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    /* Nessun `margin-left: 0` nello stato compatto: `auto` → `0` non è
       interpolabile (stessa famiglia di problemi di `fit-content`), e non
       serve — mentre la barra si restringe verso la larghezza del contenuto
       lo spazio libero si esaurisce, quindi questo margine si annulla DA SÉ,
       in modo continuo. È anche ciò che fa "avvicinare" logo e link durante
       il morph invece di farli scattare. */
    margin-left: auto;
    transition: gap var(--nav-morph-t) var(--nav-morph-e);
  }
  /* Un po' più larghi fra loro rispetto a prima, ma comunque meno del gap
     badge↔link in `.nav__bar` qui sopra: il logo resta il più staccato. */
  :global(html.nav-compact) .nav__links {
    gap: 1.5rem;
  }

  .nav__link {
    position: relative;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-text-2);
    text-decoration: none;
    transition: color 240ms var(--ease-snappy);
  }
  .nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -0.4em;
    width: 100%;
    height: 1px;
    background-color: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 320ms var(--ease-out-expo);
  }
  .nav__link:hover,
  .nav__link[aria-current='page'] {
    color: var(--color-text-1);
  }
  .nav__link:hover::after,
  .nav__link[aria-current='page']::after {
    transform: scaleX(1);
  }

  .nav__cta {
    flex-shrink: 0;
    transition:
      height var(--nav-morph-t) var(--nav-morph-e),
      padding-inline var(--nav-morph-t) var(--nav-morph-e);
  }
  :global(html.nav-compact) .nav__cta {
    height: 2.25rem;
    padding-inline: 1rem;
  }

  /* -- Menu mobile ------------------------------------------------------- */
  .nav__mobile {
    width: 100%;
    background-color: color-mix(in oklab, var(--color-canvas) 94%, transparent);
    backdrop-filter: blur(14px);
  }
  @media (min-width: 56.25rem) {
    .nav__mobile {
      display: none;
    }
  }

  .nav__toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-h);
    padding-inline: var(--spacing-gutter);
    list-style: none;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-text-1);
  }
  .nav__toggle::-webkit-details-marker {
    display: none;
  }

  .nav__toggle-bars {
    display: grid;
    gap: 5px;
  }
  .nav__toggle-bars i {
    display: block;
    width: 24px;
    height: 1px;
    background-color: currentColor;
    transition: transform 260ms var(--ease-out-expo);
  }
  .nav__mobile[open] .nav__toggle-bars i:first-child {
    transform: translateY(3px) rotate(45deg);
  }
  .nav__mobile[open] .nav__toggle-bars i:last-child {
    transform: translateY(-3px) rotate(-45deg);
  }

  .nav__panel {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: calc(100svh - var(--nav-h));
    padding: 2rem var(--spacing-gutter) 3rem;
    background-color: var(--color-canvas);
    border-top: 1px solid var(--color-hairline);
  }

  .nav__panel nav {
    display: flex;
    flex-direction: column;
  }

  .nav__panel-link {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--color-hairline);
    font-size: var(--text-h2);
    letter-spacing: -0.025em;
    color: var(--color-text-1);
    text-decoration: none;
  }
  .nav__panel-link[aria-current='page'] {
    color: var(--color-accent);
  }
  .nav__panel-n {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    color: var(--color-text-3);
  }

  .nav__panel-mail {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-2);
  }

  /* Senza JS resta un mostra/nascondi nativo: nessuna dipendenza dal movimento. */
  :global(html.js-anim) .nav__panel {
    animation: nav-panel-in 380ms var(--ease-out-expo) both;
  }
  @keyframes nav-panel-in {
    from {
      opacity: 0;
      transform: translate3d(0, -1rem, 0);
    }
  }
</style>