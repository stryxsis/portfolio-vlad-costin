---
/**
 * Il footer è lo stesso su tutte le pagine, senza varianti: è il pavimento
 * della stanza.
 *
 * Il wordmark colossale è tagliato dal bordo inferiore (~35% del glifo fuori
 * dalla viewport) e colorato `surface-2`: è TEXTURE, non testo. Il contrasto
 * basso (1.24:1) è legittimo proprio perché l'informazione vive altrove —
 * per questo è `aria-hidden`.
 */
import { NAV, SITE } from '../../lib/site';
import CvButton from '../primitives/CvButton.astro';

const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="foot__inner">
    <div class="foot__cols">
      <div class="foot__col">
        <p class="foot__label">Dove sono</p>
        <p class="foot__place">{SITE.author.locationLabel}</p>
        <a href={`mailto:${SITE.author.email}`} class="foot__mail">{SITE.author.email}</a>
      </div>

      <nav class="foot__col" aria-label="Navigazione secondaria">
        <p class="foot__label">Pagine</p>
        <a href="/" class="foot__link">Home</a>
        {NAV.map((item) => <a href={item.href} class="foot__link">{item.label}</a>)}
      </nav>

      <div class="foot__col foot__col--cv">
        <p class="foot__label">Curriculum</p>
        <CvButton />
      </div>
    </div>

    <!-- Wordmark-texture: tagliato dal bordo, escluso dallo screen reader -->
    <p class="foot__wordmark" aria-hidden="true">VLAD COSTIN</p>

    <div class="foot__base">
      <p>© {year} {SITE.author.name}</p>
      <p>Costruito con Astro. Niente framework inutili.</p>
      <p class="foot__note">[placeholder — verificare: nessun cookie, nessun tracker]</p>
      <a href="#contenuto" class="foot__top">Torna su ↑</a>
    </div>
  </div>
</footer>

<style>
  .foot {
    /* Il footer è sempre fuori dalla viewport iniziale: si può togliere dal
       lavoro di rendering finché non serve. Mai su una sezione sticky. */
    content-visibility: auto;
    contain-intrinsic-size: auto 700px;
    position: relative;
    overflow: clip;
    border-top: 1px solid var(--color-hairline);
    padding-top: var(--spacing-section);
  }

  .foot__inner {
    max-width: 90rem;
    margin-inline: auto;
    padding-inline: var(--spacing-gutter);
  }

  .foot__cols {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 56.25rem) {
    .foot__cols {
      grid-template-columns: repeat(12, 1fr);
    }
    .foot__col:nth-child(1) {
      grid-column: 1 / span 4;
    }
    .foot__col:nth-child(2) {
      grid-column: 6 / span 3;
    }
    .foot__col--cv {
      grid-column: 10 / span 3;
    }
  }

  .foot__col {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 0.5rem;
  }

  .foot__label {
    margin-bottom: 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-3);
  }

  .foot__place {
    font-size: var(--text-base);
    color: var(--color-text-2);
  }

  .foot__mail,
  .foot__link {
    position: relative;
    font-size: var(--text-base);
    color: var(--color-text-1);
    text-decoration: none;
    width: fit-content;
  }
  .foot__mail::after,
  .foot__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: 1px;
    background-color: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 320ms var(--ease-out-expo);
  }
  .foot__mail:hover::after,
  .foot__link:hover::after {
    transform: scaleX(1);
  }

  /* Il gesto di chiusura: il wordmark sale a incastrarsi nell'ultima
     schermata. Il taglio è ottenuto con margin-bottom negativo + overflow:clip
     sul footer, non con position absolute. */
  .foot__wordmark {
    margin-top: clamp(4rem, 10vw, 9rem);
    margin-bottom: -0.28em;
    font-size: var(--text-colossal);
    line-height: 0.78;
    letter-spacing: -0.05em;
    font-weight: 500;
    color: var(--color-surface-2);
    white-space: nowrap;
    user-select: none;
  }

  .foot__base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 2rem;
    padding-block: 2rem;
    border-top: 1px solid var(--color-hairline);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-3);
  }

  .foot__note {
    color: var(--color-text-3);
  }

  .foot__top {
    margin-left: auto;
    color: var(--color-text-2);
    text-decoration: none;
  }
  .foot__top:hover {
    color: var(--color-accent);
  }
</style>