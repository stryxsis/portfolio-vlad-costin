---
/**
 * Il footer: lo stesso su tutte le pagine, senza varianti. È il pavimento della
 * stanza.
 *
 * ═══ RIFATTO IL 2026-10-05 ════════════════════════════════════════════════
 * Vlad: «rifallo meglio, carino, di design, conciso, con tutte le informazioni
 * che servono». Più un vincolo esplicito: NIENTE partita IVA, nemmeno come
 * segnaposto, finché non ce l'ha. Privacy e cookie policy sì (le pagine
 * esistono da questa stessa data).
 *
 * Tre fasce, dall'alto:
 *   1. CHI SONO, IN UNA RIGA, più due segnali vivi: la disponibilità (la stessa
 *      pill verde di /chi-sono e /contatti) e l'ora locale di Colorno — per chi
 *      scrive da un altro fuso è un'informazione vera, e dice «c'è qualcuno».
 *      Accanto, tre colonne: Pagine, Contatti, Curriculum.
 *   2. LA BARRA LEGALE: ©, privacy, cookie, torna su.
 *   3. LA FIRMA: il nome gigante tagliato dal bordo pagina (texture, non testo).
 *
 * ⚠ NIENTE CTA GRANDE QUI DENTRO, ed è una scelta: la Home, /portfolio e
 * /contatti finiscono già con un invito a scrivere, subito sopra il footer.
 * Ripeterlo un centimetro più sotto lo indebolirebbe in tutte e tre.
 *
 * Restano dal footer precedente, perché funzionavano: il bagliore che continua
 * la luce della CTA della Home (solo lì, vedi il CSS), il bottone del CV (Vlad
 * lo vuole bottone, non link), e il wordmark in `::before`.
 */
import { NAV, SITE } from '../../lib/site';
import CvButton from '../primitives/CvButton.astro';

const year = new Date().getFullYear();
/* La pagina corrente, come nella navbar: la voce si accende d'accento. */
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
const LEGALI = [
  { href: '/privacy', label: 'Privacy' },
  { href: '/cookie', label: 'Cookie' },
];
---

<footer class="foot">
  <div class="foot__glow" aria-hidden="true"></div>

  <div class="foot__inner">
    <div class="foot__grid">
      <div class="foot__id">
        <p class="foot__name">{SITE.author.name}</p>
        <p class="foot__who">
          Sviluppatore web e studente di Ingegneria Informatica a Parma. Siti e applicazioni su misura,
          dal primo schizzo alla messa online.
        </p>
        <div class="foot__live">
          {
            SITE.availability && (
              <span class="foot__badge">
                <span class="foot__dot" aria-hidden="true" />
                {SITE.availability}
              </span>
            )
          }
          {/* L'ora la scrive orologio.ts; senza JS la riga resta il solo luogo,
              che è comunque vero. */}
          <p class="foot__clock">
            {SITE.author.location.locality}
            <span class="foot__clock-time" data-ora hidden>
              <span aria-hidden="true"> · </span><span data-ora-val></span> ora locale
            </span>
          </p>
        </div>
      </div>

      <nav class="foot__col foot__col--pages" aria-label="Pagine del sito">
        <p class="foot__label">Pagine</p>
        <ul>
          {NAV.map((item) => (
            <li>
              <a href={item.href} class="foot__link" aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="foot__col foot__col--contact">
        <p class="foot__label">Contatti</p>
        <ul>
          <li>
            <a href={`mailto:${SITE.author.email}`} class="foot__link foot__link--mail">{SITE.author.email}</a>
          </li>
          {/* `target="_blank"` solo sui canali che lasciano il sito, mai su
              `mailto:` (aprirebbe una scheda vuota). */}
          <li>
            <a href={SITE.author.whatsapp.url} class="foot__link" target="_blank" rel="noopener noreferrer">
              WhatsApp<span class="foot__ext" aria-hidden="true">↗</span>
            </a>
          </li>
          <li>
            <a href={SITE.author.linkedin} class="foot__link" target="_blank" rel="noopener noreferrer">
              LinkedIn<span class="foot__ext" aria-hidden="true">↗</span>
            </a>
          </li>
        </ul>
      </div>

      <div class="foot__col foot__col--cv">
        <p class="foot__label">Curriculum</p>
        <CvButton />
      </div>
    </div>

    {/* ⚠ Nessuna partita IVA né dati d'impresa: Vlad non li ha ancora
        (2026-10-05). Quando arriveranno, vanno qui, nella barra. */}
    <div class="foot__base">
      <p>© {year} {SITE.author.name}</p>
      <nav class="foot__legal" aria-label="Note legali">
        {LEGALI.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
      <a href="#contenuto" class="foot__top">
        Torna su
        <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
          <path d="M5 9V1M1.5 4.5L5 1l3.5 3.5"></path>
        </svg>
      </a>
    </div>

    {/* La firma: testo in `::before` (vedi il CSS), escluso dallo screen
        reader. Il nome resta un dato di site.ts. */}
    <p
      class="foot__wordmark"
      aria-hidden="true"
      style={`--wordmark: "${SITE.author.name.toUpperCase()}"`}
    >
    </p>
  </div>
</footer>

<style>
  .foot {
    /* Sempre fuori dalla viewport iniziale: fuori dal rendering finché non
       serve. Mai su una sezione sticky. */
    content-visibility: auto;
    contain-intrinsic-size: auto 640px;
    position: relative;
    overflow: clip;
    border-top: 1px solid var(--color-hairline);
    padding-top: clamp(4.5rem, 9vw, 8rem);
  }

  /* ═══ IL BAGLIORE ════════════════════════════════════════════════════════
     La CODA della luce della CTA della Home, che ha la sorgente 5svh sotto il
     proprio bordo — cioè qui dentro (geometria e storia nella versione
     precedente di questo file, in git). Spento di default: su ogni altra
     pagina un gradiente tagliato dal bordo alto si leggerebbe come una riga
     dritta che comincia dal nulla. Lo accende `body:has(.cta)`, che è vero
     solo in Home. */
  .foot__glow {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(
      90% 38svh at 92% 2svh,
      var(--color-accent) 0%,
      var(--color-accent-deep) 26%,
      color-mix(in oklab, var(--color-accent-deep) 40%, transparent) 44%,
      transparent 78%
    );
    opacity: 0;
  }
  /* ⚠ In Home il bordo si TOGLIE, non si rende trasparente. Trasparente
     lasciava passare il nero della pagina in quel pixel, e il bagliore non può
     coprirlo: `overflow: clip` taglia al bordo interno. Risultato: una riga
     scura proprio sulla giuntura con la CTA, che c'era anche nel footer
     precedente (misurata il 2026-10-05: #050505 fra due righe viola). */
  :global(body:has(.cta)) .foot {
    border-top-width: 0;
  }
  :global(body:has(.cta)) .foot__glow {
    opacity: 0.72;
  }

  .foot__inner {
    position: relative;
    z-index: 1;
    max-width: 90rem;
    margin-inline: auto;
    padding-inline: var(--spacing-gutter);
  }

  /* ---- La griglia --------------------------------------------------------- */
  /* Telefono: una colonna (l'email non sta in mezza riga). Da 560px: pagine e
     contatti affiancati, identità e CV a tutta riga. */
  .foot__grid {
    display: grid;
    gap: 3rem 2rem;
  }
  @media (min-width: 35rem) {
    .foot__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .foot__id,
    .foot__col--cv {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 56.25rem) {
    .foot__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 0 clamp(1rem, 1.5vw, 2rem);
    }
    /* 4 + 2 + 3 + 3. Contatti e CV hanno tre colonne perché l'email e il
       bottone del CV sono larghi ~230px: in due (~200px a 1440) l'email andava
       a capo a metà e il bottone su due righe (visto a schermo). */
    .foot__id {
      grid-column: 1 / span 4;
    }
    .foot__col--pages {
      grid-column: 5 / span 2;
      justify-self: center;
    }
    .foot__col--contact {
      grid-column: 7 / span 3;
    }
    .foot__col--cv {
      grid-column: 10 / span 3;
      justify-self: end;
    }
  }
  /* Fra 900 e 1200 quattro blocchi in fila stanno stretti: l'identità sale a
     tutta riga e le tre colonne le si mettono sotto. */
  @media (min-width: 56.25rem) and (max-width: 74.99rem) {
    .foot__grid {
      row-gap: 3.5rem;
    }
    .foot__id {
      grid-column: 1 / span 9;
    }
    .foot__col--pages {
      grid-column: 1 / span 3;
      justify-self: start;
    }
    .foot__col--contact {
      grid-column: 5 / span 4;
    }
    .foot__col--cv {
      grid-column: 9 / span 4;
      justify-self: start;
    }
  }

  /* ---- Chi sono ----------------------------------------------------------- */
  .foot__name {
    font-size: var(--text-h3);
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-weight: 500;
  }
  .foot__who {
    margin-top: 0.85rem;
    max-width: 36ch;
    font-size: var(--text-base);
    line-height: 1.55;
    color: var(--color-text-2);
  }
  .foot__live {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: 1.75rem;
  }
  .foot__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.35rem 0.85rem 0.35rem 0.7rem;
    border: 1px solid var(--color-hairline-strong);
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
    font-weight: 500;
  }
  .foot__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-ok);
    animation: foot-breathe 3.2s ease-in-out infinite;
  }
  @keyframes foot-breathe {
    50% {
      opacity: 0.4;
    }
  }
  .foot__clock {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-2);
  }

  /* ---- Le colonne --------------------------------------------------------- */
  .foot__col {
    min-width: 0;
  }
  .foot__col ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  /* ⚠ `--color-text-2` e mai `text-3`: mono da 12px, dove il pavimento è
     4.5:1, e `text-3` sul nero fa 4.19:1 (difetto noto in CLAUDE.md). */
  .foot__label {
    margin-bottom: 1rem;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-2);
  }
  .foot__link {
    position: relative;
    display: inline-block;
    max-width: 100%;
    font-size: var(--text-base);
    color: var(--color-text-1);
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color 200ms var(--ease-snappy);
  }
  .foot__link--mail {
    font-size: var(--text-sm);
  }
  .foot__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: 1px;
    background-color: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 320ms var(--ease-out-expo);
  }
  .foot__link:hover::after {
    transform: scaleX(1);
  }
  .foot__link[aria-current='page'] {
    color: var(--color-accent-hi);
  }
  .foot__ext {
    display: inline-block;
    margin-left: 0.3em;
    font-size: 0.8em;
    color: var(--color-text-2);
    transition: transform 250ms var(--ease-out-expo), color 200ms var(--ease-snappy);
  }
  .foot__link:hover .foot__ext {
    color: var(--color-accent-hi);
    transform: translate(2px, -2px);
  }

  /* ---- La barra ------------------------------------------------------------ */
  .foot__base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 2rem;
    margin-top: clamp(3.5rem, 8vw, 6.5rem);
    padding-block: 1.75rem;
    border-top: 1px solid var(--color-hairline);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-2);
  }
  .foot__legal {
    display: flex;
    gap: 1.5rem;
  }
  .foot__legal a,
  .foot__top {
    color: var(--color-text-2);
    text-decoration: none;
    transition: color 200ms var(--ease-snappy);
  }
  .foot__legal a:hover {
    color: var(--color-text-1);
  }
  .foot__top {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
    color: var(--color-text-1);
  }
  .foot__top svg {
    transition: transform 300ms var(--ease-out-expo);
  }
  .foot__top:hover {
    color: var(--color-accent-hi);
  }
  .foot__top:hover svg {
    transform: translateY(-2px);
  }

  /* ---- La firma -------------------------------------------------------------
     Testo in `::before` e non nel markup: a 1.14:1 sarebbe un audit di
     contrasto fallito, e un falso positivo lasciato lì nasconde quelli veri.
     Il taglio col bordo pagina è il margine negativo + `overflow: clip`. */
  .foot__wordmark::before {
    content: var(--wordmark, '');
  }
  .foot__wordmark {
    margin-top: clamp(1.5rem, 3vw, 3rem);
    margin-bottom: -0.28em;
    font-size: var(--text-colossal);
    line-height: 0.78;
    letter-spacing: -0.05em;
    font-weight: 500;
    color: var(--color-surface-2);
    white-space: nowrap;
    user-select: none;
  }
</style>
