---
/**
 * Il campo di stelle della 404: SVG generato a build time, zero JS.
 *
 * ⚠ ORIGINE: uno snippet React + `ogl` portato da Vlad (`Particles.tsx`,
 * particelle WebGL con shader propri). **`ogl` NON è stato installato**, e
 * qui la ragione è DIVERSA da quella solita: non è "è una libreria" — il
 * criterio fissato con `cobe` (vanilla, zero dipendenze, una funzione) lo
 * ammetterebbe. È che **per questo effetto WebGL non serve**, e sulla 404
 * costerebbe un SECONDO contesto GL accanto a quello del globo, cioè
 * memoria e un altro ciclo di rendering per frame, per disegnare duecento
 * puntini che devono stare quasi fermi. Qui non c'è nemmeno un ciclo: le
 * stelle sono markup statico e la deriva è una transizione composita.
 *
 * Cosa del riferimento è stato scartato di proposito, oltre a React:
 *   - **la reazione al mouse** (`moveParticlesOnHover`): esclusa da Vlad, e
 *     comunque contro la regola "niente hover come trigger" del repo;
 *   - **le particelle grandi** (`particleBaseSize: 100`, `sizeRandomness`):
 *     Vlad le vuole tutte piccole, "che sembrano lontane". Il raggio più
 *     grande qui è 1,7 unità su un viewBox da 1600 — un punto, non un disco;
 *   - **il colore che oscilla nel fragment shader** (`0.2 * sin(uv.yxx +
 *     uTime …)`, che fa virare ogni particella su tinte a caso): questo sito
 *     ha UN accento solo, e le stelle non sono il posto dove introdurne di
 *     nuovi. Sono bianche, e a cambiare è solo la loro opacità;
 *   - **la rotazione dell'intero campo**: un campo di stelle che ruota si
 *     legge come un oggetto che gira, non come lo spazio in cui si sta.
 *
 * ⚠ TRE STRATI, E NON UNO PIÙ FITTO: la profondità la fa la PARALLASSE, non
 * il numero di punti. Lo strato lontano è il più fitto, il più piccolo, il
 * più smorzato e il più lento; quello vicino il contrario. Con un solo
 * strato che deriva, per quanto popolato, si vedrebbe un piano che scivola.
 *
 * ⚠ LE COORDINATE SONO GENERATE CON UN SEME FISSO, non con `Math.random()`
 * nudo: così due build dello stesso commit producono lo stesso cielo, e un
 * diff di `dist/` non si riempie di rumore ad ogni rebuild.
 */

/* Il viewBox è più largo che alto perché la sezione lo è quasi sempre. Con
   `preserveAspectRatio="slice"` l'SVG COPRE il riquadro e viene ritagliato:
   la densità per area resta quindi costante a qualunque proporzione — su
   telefono si vede una fetta stretta dello stesso cielo, non lo stesso
   cielo schiacciato. */
const VB_W = 1600;
const VB_H = 900;

interface Strato {
  /** Quante stelle. Il piano lontano è il più fitto: è ciò che dà il fondo. */
  quante: number;
  /** Raggio in unità di viewBox (a schermo si scala col `slice`). */
  rMin: number;
  rMax: number;
  /** Opacità: il lontano è smorzato, il vicino quasi pieno. */
  oMin: number;
  oMax: number;
}

const STRATI: Strato[] = [
  { quante: 130, rMin: 0.5, rMax: 0.95, oMin: 0.2, oMax: 0.42 },
  { quante: 82, rMin: 0.8, rMax: 1.25, oMin: 0.36, oMax: 0.62 },
  { quante: 46, rMin: 1.05, rMax: 1.7, oMin: 0.55, oMax: 0.85 },
];

/** mulberry32: generatore deterministico, minuscolo e senza dipendenze.
 *  Serve solo a distribuire dei punti, non a fare crittografia. */
function generatore(seme: number): () => number {
  let s = seme;
  return (): number => {
    s = (s + 0x6d2b79f5) | 0;
    let t = Math.imul(s ^ (s >>> 15), 1 | s);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rand = generatore(20260813);
const arrotonda = (n: number, cifre = 1): number => Number(n.toFixed(cifre));

const cieli = STRATI.map((strato) =>
  Array.from({ length: strato.quante }, () => ({
    x: arrotonda(rand() * VB_W),
    y: arrotonda(rand() * VB_H),
    r: arrotonda(strato.rMin + rand() * (strato.rMax - strato.rMin), 2),
    o: arrotonda(strato.oMin + rand() * (strato.oMax - strato.oMin), 2),
  }))
);
---

{/* `aria-hidden`: è un fondo. Non porta nessuna informazione, e annunciarlo
    vorrebbe dire far leggere "immagine" a chi sta cercando la via d'uscita. */}
<div class="sky" aria-hidden="true">
  {
    cieli.map((stelle, i) => (
      <svg
        class={`sky__l sky__l--${i + 1}`}
        viewBox={`0 0 ${VB_W} ${VB_H}`}
        preserveAspectRatio="xMidYMid slice"
        focusable="false"
      >
        {stelle.map((s) => (
          <circle cx={s.x} cy={s.y} r={s.r} opacity={s.o} />
        ))}
      </svg>
    ))
  }
</div>

<style>
  .sky {
    position: absolute;
    /* ⚠ Più grande della sezione, non a filo: la deriva sposta ogni strato di
       qualche pixel, e a filo si aprirebbe una fascia senza stelle sul bordo
       proprio nel momento in cui lo strato si allontana da quel lato.
       Il ritaglio lo fa `overflow: clip` sulla sezione ospite. */
    inset: -2%;
    z-index: 0;
    /* Non deve mai rubare un click al contenuto che gli sta sopra, né al
       trascinamento del globo. */
    pointer-events: none;
  }

  .sky__l {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Bianco dal token, non un `#fff` scritto a mano: è lo stesso bianco del
     testo della pagina, e se un giorno cambia cambiano insieme. Il variare
     è tutto nell'`opacity` di ogni cerchio, scritta nel markup. */
  .sky__l circle {
    fill: var(--color-text-1);
  }

  /* ---- La deriva ----------------------------------------------------------
     ⚠ ECCEZIONE DICHIARATA alla regola "ogni animazione si esegue una volta
     sola" (vedi CLAUDE.md): come il word-carousel della hero, l'anello di
     scroll e le onde della CTA, questo loop non annuncia un ingresso —
     descrive uno stato che resta vero finché si guarda la pagina.
     ⚠ E le durate sono ENORMI di proposito (80-150s per un'andata): Vlad ha
     chiesto stelle "quasi ferme, che si muovono pochissimo". A questa
     velocità lo spostamento è sotto il decimo di pixel al secondo — non lo
     si vede accadere, ci si accorge dopo un po' che qualcosa è cambiato.
     ⚠ `alternate` invece di un ciclo continuo: un campo che scorre sempre
     nella stessa direzione, prima o poi, mostra il bordo da cui è partito.
     Andata e ritorno non ha giunture da nascondere.
     ⚠ `translate3d` e non `translate`: promuove lo strato a livello
     composito, così i 258 cerchi non vengono ridisegnati ad ogni fotogramma.
     La parallasse è nei numeri: lo strato lontano si muove MENO e più
     lentamente di quello vicino, che è come si comporta la distanza vera. */
  @keyframes sky-1 {
    from {
      transform: translate3d(-4px, 2px, 0);
    }
    to {
      transform: translate3d(4px, -2px, 0);
    }
  }
  @keyframes sky-2 {
    from {
      transform: translate3d(5px, -3px, 0);
    }
    to {
      transform: translate3d(-5px, 3px, 0);
    }
  }
  @keyframes sky-3 {
    from {
      transform: translate3d(-7px, -4px, 0);
    }
    to {
      transform: translate3d(7px, 4px, 0);
    }
  }

  .sky__l--1 {
    animation: sky-1 150s ease-in-out infinite alternate;
  }
  .sky__l--2 {
    animation: sky-2 112s ease-in-out infinite alternate;
  }
  .sky__l--3 {
    animation: sky-3 84s ease-in-out infinite alternate;
  }

  /* ⚠ Serve un blocco dedicato, e non basta la regola globale di
     `global.css` (`animation-iteration-count: 1`): per una deriva
     `alternate` "un'iterazione sola" significa comunque due minuti e mezzo
     di movimento. Chi chiede meno movimento chiede fermo. Le stelle
     restano, perché sono il fondo e non l'animazione. */
  @media (prefers-reduced-motion: reduce) {
    .sky__l--1,
    .sky__l--2,
    .sky__l--3 {
      animation: none;
    }
  }
</style>
