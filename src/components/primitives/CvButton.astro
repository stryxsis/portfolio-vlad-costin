---
/**
 * Il download del CV. `download` è un attributo nativo: zero JS.
 * La riga mono sotto dichiara data e peso — è la differenza tra un link e
 * un'informazione.
 */
import { SITE } from '../../lib/site';
import Button from './Button.astro';

interface Props {
  tone?: 'dark' | 'paper' | 'accent';
}
const { tone = 'dark' } = Astro.props;
---

<div class="cv">
  <Button href={SITE.cv.path} variant="outline" tone={tone} download>
    {SITE.cv.label}
    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
      <path d="M6 1v9m0 0L2.5 6.5M6 10l3.5-3.5" stroke="currentColor" stroke-width="1.25" />
    </svg>
  </Button>
  <p class="cv__meta">
    Aggiornato a {SITE.cv.updated} · {SITE.cv.sizeLabel}
  </p>
</div>

<style>
  .cv {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 0.75rem;
  }

  /* ⚠ `--color-text-2` e NON `text-3` (2026-08-07). Questo componente ha UN solo
     utente, il footer, e da quando il footer ha un bagliore viola in alto a
     destra questa riga cade proprio sotto il centro del gradiente: `text-3` ci
     misurava 3.38:1, sotto il pavimento di 4.5:1 che vale per del mono da 12px
     (e già faceva 4.19:1 sul nero nudo — difetto noto, vedi CLAUDE.md).
     Se un domani questo bottone finisce su una superficie diversa, il colore va
     riverificato lì: `text-2` è tarato sul buio. */
  .cv__meta {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-2);
  }
</style>