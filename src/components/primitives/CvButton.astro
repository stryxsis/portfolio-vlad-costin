---
/**
 * Il download del CV. `download` è un attributo nativo: zero JS.
 * La riga mono sotto dichiara data e peso — è la differenza tra un link e
 * un'informazione.
 */
import { SITE } from '../../lib/site';
import Button from './Button.astro';

interface Props {
  tone?: 'dark' | 'paper' | 'accent';
}
const { tone = 'dark' } = Astro.props;
---

<div class="cv">
  <Button href={SITE.cv.path} variant="outline" tone={tone} download>
    {SITE.cv.label}
    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
      <path d="M6 1v9m0 0L2.5 6.5M6 10l3.5-3.5" stroke="currentColor" stroke-width="1.25" />
    </svg>
  </Button>
  <p class="cv__meta">
    Aggiornato a {SITE.cv.updated} · {SITE.cv.sizeLabel}
  </p>
</div>

<style>
  .cv {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 0.75rem;
  }

  .cv__meta {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-3);
  }
</style>