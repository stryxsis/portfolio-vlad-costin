---
/**
 * Il dispositivo di numerazione delle sezioni ("00 — INIZIO", "10 — COSA FACCIO").
 *
 * È `position: sticky` DENTRO la sezione: accompagna la lettura e si sgancia al
 * confine della sezione. Due righe di CSS, zero JS — il dettaglio della
 * reference ottenuto senza costo.
 *
 * Le sezioni statement NON hanno numero: è la numerazione stessa a dichiararle
 * come aside tipografico. Per questo il componente semplicemente non si usa lì.
 */
interface Props {
  /** Passi di 10. L'hero è '00'. */
  n: string;
  label: string;
  /** Su fondo paper i token canvas (`text-3`/`accent`) sono sotto contrasto:
   *  vedi lo stesso ragionamento in Statement.astro (`--color-accent-deep`).
   *  `| undefined` esplicito: con `exactOptionalPropertyTypes` (tsconfig
   *  strictest) un `tone={variabileForsePriva}` non passerebbe senza. */
  tone?: 'paper' | undefined;
}
const { n, label, tone } = Astro.props;
---

<div class:list={['idx', tone === 'paper' && 'idx--paper']} data-section-index>
  <div class="idx__line"></div>
  <div class="idx__content">
    <span class="idx__n">{n}</span>
    <span class="idx__dot" aria-hidden="true">•</span>
    <span class="idx__label">{label}</span>
  </div>
  <div class="idx__line"></div>
</div>

<style>
  .idx {
    position: sticky;
    /* ⚠ `--chrome-shift` è di quanto la chrome fissa è cresciuta in cima
       (oggi: l'avviso "cantiere aperto" che spinge giù la navbar — lo dichiara
       AnnouncementBanner.astro). Qui somma all'ancora dello STICKY, quindi
       agisce solo quando l'indice è davvero agganciato sotto la chrome: è
       esattamente il caso in cui la navbar spinta giù gli finirebbe sopra.

       ⚠ E SOLO SU `top`, MAI un `transform` su questo elemento. Un transform
       avrebbe spostato l'indice anche quando NON è agganciato — e sotto i
       900px l'indice della hero non è ancorato affatto, sta in flusso normale
       fra la foto e il testo (vedi `.hero__idx` in HeroHome). Provato e
       misurato a 390px: i 120px di banda lo spingevano dritto sopra il titolo
       "Ciao. Sono Vlad". Il caso non-agganciato che serviva davvero era uno
       solo — l'indice ASSOLUTO della hero desktop — ed è risolto lì, dove il
       contesto è noto, invece che da qui per tutti. */
    top: calc(var(--nav-h) + var(--chrome-shift, 0px) + 1.5rem);
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--color-text-3);
    /* Il numero passa ad accento quando la sezione è attiva: UN paint su
       toggle di classe, non un'animazione di colore per frame. */
    transition:
      color 260ms var(--ease-snappy),
      top var(--chrome-t, 0ms) var(--chrome-e, linear);
  }

  .idx__content {
    display: flex;
    align-items: baseline;
    gap: 0.5em;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    flex-shrink: 0;
  }

  :global([data-section].is-active) .idx {
    color: var(--color-accent);
  }

  /* Stessa coppia di token di `.st--paper .st__text`/`.st__label`: il pavimento
     di contrasto sul paper è diverso da quello sul canvas, non un'estetica a
     parte. Dopo le regole base per specificità pari e ordine nel foglio. */
  .idx--paper {
    color: var(--color-paper-text-2);
  }
  :global([data-section].is-active) .idx--paper {
    color: var(--color-accent-deep);
  }

  .idx__line {
    height: 1px;
    width: 64px;
    background-color: currentColor;
    opacity: 0.25;
  }
</style>