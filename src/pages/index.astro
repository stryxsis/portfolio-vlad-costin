---
/**
 * TEMPORANEO (milestone 2) — prova visiva dei design token.
 * Questa pagina viene sostituita dalla Home reale nel milestone 3.
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const TYPE = [
  ['text-colossal', 'LAVORI', 'wordmark, 80 → 280px'],
  ['text-mega', 'Statement mega', '72 → 176px'],
  ['text-display', 'Titolo display', '52 → 132px'],
  ['text-h1', 'Titolo h1', '40 → 88px'],
  ['text-h2', 'Titolo h2', '30 → 56px'],
  ['text-h3', 'Titolo h3', '22 → 32px'],
  ['text-lede', 'Lede introduttiva', '19 → 26px'],
  ['text-base', 'Body di base', '16 → 19px'],
  ['text-sm', 'Body piccolo', '14 → 16px'],
] as const;

const COLORS = [
  ['canvas', '#0B0B0C', '—'],
  ['surface-1', '#131316', '1.11:1'],
  ['surface-2', '#1B1B1F', '1.24:1'],
  ['hairline', '#26262B', '1.31:1'],
  ['hairline-strong', '#63636B', '3.31:1'],
  ['text-3', '#7A7A77', '4.57:1'],
  ['text-2', '#A3A3A0', '7.78:1'],
  ['text-1', '#F5F5F3', '18.0:1'],
  ['accent', '#5B84FF', '5.80:1'],
  ['accent-hi', '#8AA5FF', '8.35:1'],
  ['accent-deep', '#2B5CFF', '4.56:1 su paper'],
  ['paper', '#F2F1ED', '17.4:1'],
] as const;
---

<BaseLayout title="Design token" noindex>
  <div class="mx-auto max-w-[90rem] px-gutter py-section">
    <p class="font-mono text-micro text-text-3 uppercase">Milestone 2 — verifica token</p>

    <!-- Scala tipografica -->
    <section class="mt-16">
      <h2 class="font-mono text-label text-accent uppercase">Scala tipografica — Geist 500/400</h2>
      <div class="mt-8 flex flex-col gap-8">
        {
          TYPE.map(([cls, sample, range]) => (
            <div class="border-t border-hairline pt-4">
              <p class="font-mono text-micro text-text-3 uppercase">{cls} · {range}</p>
              <p class={`${cls} opt-flat mt-2 max-w-mega`}>{sample}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Misure di riga: la leva che fa "pesare" la tipografia -->
    <section class="mt-32">
      <h2 class="font-mono text-label text-accent uppercase">
        Misura corta = lo statement pesa
      </h2>
      <div class="mt-8 grid gap-16 md:grid-cols-2">
        <div>
          <p class="font-mono text-micro text-text-3 uppercase">max-w-statement (22ch) — corretto</p>
          <p class="text-h1 opt-flat mt-3 max-w-statement">
            Hai un problema. Io scrivo la <span class="text-accent">soluzione</span>.
          </p>
        </div>
        <div>
          <p class="font-mono text-micro text-text-3 uppercase">senza limite — sbagliato</p>
          <p class="text-h1 opt-flat mt-3">
            Hai un problema. Io scrivo la <span class="text-accent">soluzione</span>.
          </p>
        </div>
      </div>
    </section>

    <!-- Palette -->
    <section class="mt-32">
      <h2 class="font-mono text-label text-accent uppercase">Palette e contrasti su canvas</h2>
      <div class="mt-8 grid gap-px border border-hairline sm:grid-cols-2 lg:grid-cols-3">
        {
          COLORS.map(([name, hex, ratio]) => (
            <div class="flex items-center gap-4 bg-canvas p-4">
              <span
                class="size-12 shrink-0 border border-hairline"
                style={`background-color: var(--color-${name})`}
              ></span>
              <span class="font-mono text-micro uppercase">
                <span class="text-text-1">{name}</span><br />
                <span class="text-text-3">{hex} · {ratio}</span>
              </span>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Sezione full-bleed PAPER: l'inversione senza overflow orizzontale -->
    <section class="full-bleed on-paper mt-32 bg-paper py-statement">
      <div class="mx-auto max-w-[90rem] px-gutter">
        <p class="font-mono text-micro text-paper-text-2 uppercase">Inversione full-bleed — paper</p>
        <p class="text-mega opt-flat mt-6 max-w-mega text-paper-text-1">
          Il buio è la stanza. Questa è una <span class="text-accent-deep">finestra</span>.
        </p>
      </div>
    </section>

    <!-- Sezione full-bleed ACCENTO -->
    <section class="full-bleed on-accent bg-accent py-statement">
      <div class="mx-auto max-w-[90rem] px-gutter">
        <p class="font-mono text-micro uppercase" style="color: rgb(11 11 12 / 0.7)">
          Inversione full-bleed — accento
        </p>
        <p class="text-mega opt-flat mt-6 max-w-cta text-canvas">Parliamone.</p>
      </div>
    </section>
  </div>
</BaseLayout>