---
/**
 * /chi-sono
 *
 * Milestone 6: la pagina esiste per davvero (il link in navbar non è più rotto)
 * e rende i dati reali del CV attraverso Timeline e SkillsGrid.
 *
 * §00 è stata rifatta il 2026-08-23 su richiesta di Vlad («non mi piace molto
 * la hero, non ha l'effetto wow che vorrei»): stesse identiche scritte —
 * titolo grande, titolo piccolo, descrizione, informazioni rapide, tutte
 * confermate da lui — dentro una composizione e una coreografia nuove. Vedi
 * il blocco di note sopra `.ab` più sotto.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionIndex from '../components/primitives/SectionIndex.astro';
import BinaryField from '../components/primitives/BinaryField.astro';
import Timeline from '../components/primitives/Timeline.astro';
import NowPanel from '../components/primitives/NowPanel.astro';
import Approach from '../components/sections/Approach.astro';
import SkillsGrid from '../components/sections/SkillsGrid.astro';
import Portale from '../components/sections/Portale.astro';
import { TIMELINE } from '../data/timeline';
import { SITE } from '../lib/site';
---

<BaseLayout
  title="Chi sono"
  description="Vlad Costin: sviluppatore e studente di Ingegneria Informatica a Parma. Il percorso, gli strumenti, e cosa sta studiando adesso."
  ogType="profile"
>
  {/* §00 — L'h1 è candidato LCP: nessun data-split, nessun fade. Si mette a
      fuoco con `transform` + `filter`, che non escludono dal calcolo (stessa
      riga della regola LCP che governa il ritratto della Home e il titolone
      di /portfolio). */}
  <section class="ab" data-section id="chi-sono">
    {/* Il fondale. Sta PRIMA del contenuto nel markup e non dopo: è dietro, e
        l'ordine del DOM è il modo più economico di dirlo — nessuno z-index da
        rincorrere se un domani si aggiunge un elemento. */}
    <BinaryField />

    <div class="ab__wrap">
      <div class="ab__top">
        <SectionIndex n="00" label="Chi sono" />
        {/* ⚠ DUE REGISTRI, e la divisione NON è arbitraria: è la punteggiatura
            del testo di Vlad (2026-08-13). Sono due frasi con due lavori
            diversi — la prima è una DOMANDA rivolta a chi legge, la seconda è
            un inciso che la commenta ("Ti avviso: …"). Al corpo pieno la
            seconda è larga ~4000px contro i 1310 della colonna: andrebbe a
            capo tre volte e la domanda si perderebbe dentro il paragrafo che
            la segue. Scesa di corpo e smorzata di colore, la domanda resta il
            gesto e l'inciso resta un inciso — che è come si legge ad alta voce.
            ⚠ Resta un solo <h1>: l'inciso è parte del titolo, non un
            sottotitolo separato, quindi sta dentro e non in un <p> accanto. */}
        <h1 class="ab__title">
          Curioso di sapere<br />chi sono?<span class="ab__coda"
            >Ti avviso: faccio un sacco di cose, spesso nello stesso pomeriggio.</span
          >
        </h1>
        {/* ⚠ `bioIo` e NON `bio`: la seconda è la stringa in terza persona
            destinata alle macchine (JSON-LD, llms.txt, meta description) e
            leggerla qui significherebbe far parlare Vlad di sé al "lui".
            Vedi la nota accanto ai due campi in `lib/site.ts`.
            ⚠ NIENTE PIÙ `data-split="lines"` (tolto il 2026-08-23): questo
            paragrafo nasce SOPRA LA PIEGA, ed è precisamente l'elemento che
            l'11-08 era rimasto invisibile per sempre perché uno ScrollTrigger
            nato oltre la propria soglia veniva reclamato prima di giocare
            (vedi `settleSplits` in reveal.ts). La rete di sicurezza resta e
            copre gli altri utenti di M1, ma qui non serve più correre il
            rischio: la lede è ora una battuta della coreografia CSS della
            hero, come il pannello Adesso e per la stessa ragione — sopra la
            piega il sito usa animazioni CSS a tempo, non trigger di scroll. */}
        <p class="ab__lede">{SITE.bioIo}</p>
      </div>

      {/* Le informazioni rapide: non più una colonna a destra della bio, ma la
          fascia di strumenti a piede dello schermo. Il perché sta in testa a
          NowPanel.astro. */}
      <NowPanel />
    </div>
  </section>

  {/* La pausa fra la hero e il percorso: una frase sola, su una superficie
      diversa. Senza numero d'indice di proposito — vedi Approach.astro. */}
  <Approach />

  {/* §20 — Il percorso. Il filetto verticale della timeline sborda in basso di
      proposito: questa sezione non deve avere overflow clippato. */}
  <section class="jr" data-section id="percorso">
    <div class="jr__wrap">
      <div class="jr__idx">
        <SectionIndex n="02" label="Percorso" />
      </div>
      {/* `data-activate` sul contenitore e `data-split` sul titolo: mai sullo
          stesso elemento (vedi reveal.ts). Da qui le classi governano in CSS
          l'ingresso della lede e l'accensione delle sue parole chiave. */}
      <div class="jr__head" data-activate>
        <h2 class="jr__title" data-split="lines">
          Niente curriculum impolverati in formato europeo, te lo prometto.
        </h2>
        {/* Testo dettato da Vlad (2026-08-14), parola per parola.
            ⚠ Le parole d'accento NON sono "nottate": quella parola è già
            accesa nella fascia del metodo poco sopra, sulla stessa pagina, e
            vederla in viola due volte a mezzo schermo di distanza legge come
            una ripetizione involontaria. Marcate invece le due che dicono di
            cosa parla l'elenco. */}
        <p class="jr__lede">
          Ecco le <strong class="jr__key" style="--i: 0">tappe fondamentali</strong> – tra
          nottate passate a studiare e prime vere <strong class="jr__key" style="--i: 1"
            >vittorie sul campo</strong
          > – che mi hanno portato a essere chi sono oggi:
        </p>
      </div>
      {/* Wrapper e non `class` sul componente: vedi la nota in Timeline.astro. */}
      <div class="jr__tl">
        <Timeline entries={TIMELINE} closing />
      </div>
    </div>
  </section>

  <SkillsGrid n="03" />

  {/* La chiusura: una finestra sullo spazio che si apre scorrendo, e dentro
      le due destinazioni. Senza numero d'indice come la fascia del metodo —
      vedi Portale.astro per il perché, e per il motivo per cui NON può
      chiamarsi `.cta` (il footer legge quella classe per accendersi). */}
  <Portale />
</BaseLayout>

<style>
  /* ==========================================================================
     §00 — LA HERO
     ==========================================================================
     RIFATTA IL 2026-08-23. Vlad: «non mi piace molto la hero, non ha l'effetto
     wow che vorrei — non fraintendere, le scritte le voglio queste», più due
     richieste precise: un fondale di 0 e 1 in cui «solo alcune e alcune
     sequenze» commutano, e un ingresso in cui «prima compaiono i 0 e 1 con
     un bell'effetto (esempio con la propagazione), subito dopo le scritte».
     Il resto — impaginazione e collocazione delle informazioni rapide — è
     stato lasciato a me («scegli tu come fare»).

     LA COMPOSIZIONE, e perché è cambiata:
       - Il fondale (`BinaryField.astro`) è ora il gesto della pagina, quindi
         gli si è LIBERATA la metà destra dello schermo. Prima lì c'era il
         pannello "Adesso", che copriva esattamente la parte di campo con più
         respiro.
       - Le informazioni rapide sono scese a fondo hero, in una fascia
         orizzontale con un filetto che le fa da pavimento. La ragione per
         esteso sta in testa a `NowPanel.astro`; in breve: affiancate alla bio
         competevano con lei e perdevano, in fascia hanno il registro giusto
         (una lettura di strumenti) e chiudono lo schermo.
       - La lede è passata da 44ch a 52ch. Non è un ripensamento tipografico:
         senza il pannello accanto la colonna è libera, e a 44ch la bio cadeva
         su sei righe. A 52ch ne fa cinque, cioè i ~37px che servivano a far
         stare la fascia dentro lo schermo.

     LA COREOGRAFIA è una sola sequenza a tempo, tutta in CSS, e i numeri
     vivono in DUE file: qui e in `NowPanel.astro` (l'ultima battuta).
     Toccandone uno, va toccato l'altro.
        80 →  1830ms   il campo si propaga dall'origine dell'onda
      1550ms           l'indice 00
      1750ms           il titolo si mette a fuoco
      1950ms           l'inciso
      2100ms           la lede
      2230ms           il filetto della fascia si tira
      2370 → 2740ms    "Adesso" e le quattro celle

     ⚠ RITARDI RISCRITTI IL 2026-08-24, e non è una taratura fine: Vlad ha
     segnalato che il titolo, l'inciso e la lede si vedevano SFOCATI fin dal
     primissimo fotogramma («io vorrei che non si vedessero proprio, e quando
     l'animazione del background sta per finire appaiano queste scritte
     sfuocate»). La versione precedente li faceva partire a 680/900/1050ms,
     cioè A METÀ dei 1830ms che il campo impiega a propagarsi per intero (33
     bande × 40ms + 80ms di partenza + 430ms di ingresso dell'ultima cella —
     vedi `BinaryField.astro`): il fronte passava sotto il titolo nei primi
     200ms e la scelta era di iniziare LÌ per un passaggio di mano invece di
     due eventi in fila. ⚠ MA `both` come fill-mode tradiva quell'intento: con
     `both`, il fotogramma di PARTENZA dell'animazione (sfocato, ma tutt'altro
     che invisibile) vale anche DURANTE il ritardo — quindi il titolo era
     visibile, sfocato, fin dal fotogramma zero, non da 680ms. Non bastava
     spostare il numero più in là: qualunque ritardo con `both` mostra lo
     stesso fotogramma sfocato da t=0.
     Oggi i tre elementi candidati LCP (titolo, inciso — l'indice e la lede
     no, vedi sotto) partono da uno stato REALMENTE invisibile
     (`transform: scale(0)`, zero area dipinta) con `forwards` e non `both`:
     durante il ritardo non c'è NULLA da vedere, e nell'istante in cui il
     ritardo scade l'animazione salta di colpo al proprio fotogramma "from"
     (sfocato, quasi a fuoco) — cioè esattamente "appaiono sfuocate" — e
     prosegue con la stessa messa a fuoco di sempre. Il salto non è un
     difetto: è la materializzazione richiesta, non una dissolvenza.
     ⚠ Il ritardo (1750ms) cade **poco prima** che il campo finisca di
     propagarsi (1830ms), non dopo: è la lettura letterale di «quando
     l'animazione del background STA PER finire», e mantiene comunque un
     istante di sovrapposizione — l'ultima manciata di celle sta ancora
     arrivando quando il titolo compare, che è il "passaggio di mano" invece
     di due eventi separati da un vuoto.
     ⚠ Indice e lede NON hanno bisogno di questo trattamento: non sono
     candidati LCP (il titolo lo è), quindi il loro `opacity: 0` di riposo li
     rende già realmente invisibili — sono stati semplicemente RITARDATI in
     coda al gruppo invece di anticipare il titolo, per arrivare tutti insieme
     nella stessa finestra («prima i 0 e 1, subito dopo le scritte», la
     richiesta originale del 2026-08-23).

     ⚠⚠ NIENTE `--chrome-shift` QUI DENTRO, ED È UNA REGOLA, NON UNA TARATURA
     (2026-08-14, richiesta esplicita e ripetuta di Vlad: «l'avviso non deve
     essere un elemento che influenza il sito»). L'avviso "cantiere aperto" è
     chrome `position: fixed`: sovrapporsi al contenuto è ciò che fa un banner,
     spingerlo giù no. Sommando `--chrome-shift` al padding, la hero si
     allungava di 97px alla sua comparsa e il corpo della pagina scendeva con
     lei. ⚠ IL TENTATIVO INTERMEDIO — tenere lo spostamento e AMMORBIDIRLO con
     una `transition` — È STATO BOCCIATO DA VLAD, giustamente: il difetto non
     era la brutalità del salto, era il salto. Non riproporla. */
  .ab {
    /* ⚠ `min-` e non `height` secca: se il contenuto (titolo + lede + le
       quattro celle della fascia) diventasse più alto di una viewport corta,
       la sezione deve poter crescere invece di tagliarlo. Questa NON è la
       sezione uscente di un handoff M12: ciò che sfora resta raggiungibile
       scorrendo, quindi crescere è sicuro. */
    min-height: 100svh;
    display: grid;
    /* Il fondale è un assoluto a `inset: 0`: senza questo, si aggancerebbe
       alla viewport. */
    position: relative;
    /* Ritaglia il campo binario, che sborda di proposito dai bordi della
       sezione (vedi `.bf__grid`). ⚠ `clip` e non `hidden`: `hidden` creerebbe
       un contenitore di scorrimento — stessa nota già in CTASection e
       Statement. */
    overflow: clip;
    /* Riserva lo spazio della navbar fissa, che sta FUORI dal flusso e quindi
       non lo farebbe da sola. */
    padding-top: calc(var(--nav-h) + clamp(1.25rem, 3.5vh, 2.5rem));
    padding-bottom: clamp(1.25rem, 3vh, 2.25rem);
  }

  /* ⚠ SECONDA METÀ DEL FIX DELL'AVVISO, identica a quella già in `404.astro` e
     nella hero di /portfolio, e per la ragione identica. `SectionIndex` è
     sticky perché serve ad accompagnare la lettura di sezioni ALTE, che si
     attraversano scorrendo; questa hero è alta uno schermo e non si
     attraversa, quindi non c'è niente da accompagnare. Ma il suo ancoraggio
     (`--nav-h` + `--chrome-shift` + 1.5rem) con l'avviso aperto cade PIÙ IN
     BASSO della sua posizione naturale in griglia, e lo sticky lo spinge giù
     addosso al titolo. Statico, l'avviso non lo tocca più. */
  .ab :global([data-section-index]) {
    position: static;
  }

  .ab__wrap,
  .jr__wrap {
    max-width: 90rem;
    margin-inline: auto;
    padding-inline: var(--spacing-gutter);
  }

  .ab__wrap {
    /* Sopra il fondale. Un contesto di impilamento sul contenuto e non uno
       z-index alto sparso sui figli. */
    position: relative;
    z-index: 1;
    width: 100%;
    display: grid;
    /* Il blocco tipografico si prende tutto lo spazio libero e si centra
       dentro; la fascia resta appoggiata al fondo dello schermo. È questa
       riga a fare della fascia un PAVIMENTO invece di un quarto paragrafo. */
    grid-template-rows: minmax(0, 1fr) auto;
    gap: clamp(1.5rem, 3.5vh, 2.75rem);
  }

  .ab__top {
    display: grid;
    align-content: center;
  }

  .ab__title {
    margin-top: 1.5rem;
    /* I <br /> sono manuali perché la spezzatura è parte del testo, non un
       accidente della larghezza. */
    font-size: var(--text-display);
    line-height: 0.9;
    letter-spacing: -0.04em;
  }

  /* Il secondo registro: l'inciso.
     ⚠ Il corpo NON è una frazione in `em` del titolo: `--text-display` si
     ferma a 132px oltre i 1440px mentre la colonna continua a crescere fino
     a 90rem, quindi un rapporto fisso starebbe largo in un punto e stretto
     in un altro. È una misura ricavata dal vincolo vero — la frase è larga
     ~29,8 volte il proprio corpo, la colonna vale circa (viewport − due
     gutter) — da cui ~2,9vw, con un tetto a 40px che a 1440 la fa stare su
     UNA riga con ~120px di margine.
     ⚠ `block` e non `inline-block`: qui non è più la terza riga di una
     strofa (dove serviva un blocco inline per non spezzarsi a metà), è un
     capoverso suo, con la propria interlinea — a 0,9 di titolo due righe di
     inciso si toccherebbero.
     ⚠ `text-2`: è ciò che lo rende un inciso invece di una seconda
     affermazione. 8,9:1 sul canvas, e comunque a 40px. */
  .ab__coda {
    display: block;
    margin-top: 0.55em;
    font-size: clamp(1.375rem, 2.9vw, 2.5rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    text-wrap: balance;
    color: var(--color-text-2);
  }

  .ab__lede {
    margin-top: clamp(1.75rem, 3.5vh, 2.75rem);
    /* 52ch e non 44: vedi la nota sulla composizione in cima. */
    max-width: 52ch;
    font-size: var(--text-lede);
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--color-text-2);
  }

  /* ---- La coreografia d'ingresso -----------------------------------------
     Tutta gated su `html.js-anim`: senza JS, con JS rotto o per un crawler la
     hero è semplicemente lì, completa e ferma. Il campo binario invece NON è
     gated (è fondale puro) — vedi la nota in BinaryField.astro. */
  :global(html.js-anim) .ab :global([data-section-index]) {
    opacity: 0;
    animation: ab-rise 700ms var(--ease-out-expo) 1550ms forwards;
  }

  /* ⚠ IL TITOLO NON ANIMA `opacity`, MAI: è il candidato LCP di questa pagina,
     e Chrome esclude dal calcolo un elemento che sia stato a opacità zero
     anche solo per un istante. `transform` e `filter: blur()` non escludono —
     è la stessa riga che permette l'ingresso del ritratto in Home e la messa a
     fuoco del titolone di /portfolio.
     ⚠ `transform: scale(0)` QUI FUORI dalla `animation`, e `forwards` e non
     `both` dentro di essa: è il fix del 2026-08-24 (vedi la nota sopra `.ab`).
     `scale(0)` è lo stato di riposo REALE — zero area dipinta, non "sfocato
     ma presente" — e vale per tutto il ritardo perché `forwards` non lo
     sovrascrive finché l'animazione non parte davvero. Nell'istante in cui il
     ritardo scade, l'animazione salta al proprio fotogramma "from"
     (`ab-focus`: sfocato, quasi a fuoco) e prosegue: un taglio netto da
     "niente" a "sfocato", non una dissolvenza — è la materializzazione che
     Vlad ha chiesto, non un difetto di sincronizzazione.
     ⚠ Il salto usa SOLO `transform`, mai `opacity`: `scale(0)` nasconde
     esattamente come farebbe `opacity: 0`, ma senza far scattare l'esclusione
     dall'LCP che quella proprietà porta con sé. */
  :global(html.js-anim) .ab__title {
    transform: scale(0);
    animation: ab-focus 1000ms var(--ease-out-expo) 1750ms forwards;
  }

  /* L'inciso arriva staccato dalla domanda: stesso gesto, più corto e più
     tardi, così si legge come una seconda voce e non come la coda della
     prima. Niente `opacity` nemmeno qui — sta DENTRO l'h1, quindi i suoi
     pixel fanno parte del rettangolo che Chrome misura per l'LCP.
     ⚠ Stesso trattamento del titolo, e per lo stesso motivo: `scale(0)` di
     riposo, `forwards`. Il ritardo (1950ms) resta 200ms dopo quello del
     titolo — la cascata dentro il gruppo "scritte" non è cambiata, si è
     spostato solo il momento in cui il gruppo comincia. */
  :global(html.js-anim) .ab__coda {
    transform: scale(0);
    animation: ab-focus-min 850ms var(--ease-out-expo) 1950ms forwards;
  }

  :global(html.js-anim) .ab__lede {
    opacity: 0;
    animation: ab-rise 800ms var(--ease-out-expo) 2100ms forwards;
  }

  @keyframes ab-focus {
    from {
      transform: translateY(1.75rem) scale(0.985);
      filter: blur(18px);
    }
    to {
      transform: none;
      filter: blur(0);
    }
  }

  @keyframes ab-focus-min {
    from {
      transform: translateY(0.9rem);
      filter: blur(10px);
    }
    to {
      transform: none;
      filter: blur(0);
    }
  }

  @keyframes ab-rise {
    from {
      opacity: 0;
      transform: translateY(0.9rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* La regola globale di reduced-motion azzera le durate ma non garantisce lo
     stato finale di un'animazione `forwards`/`both` che non parte: qui si
     dichiara esplicitamente che la hero è tutta visibile, nitida e ferma. */
  @media (prefers-reduced-motion: reduce) {
    :global(html.js-anim) .ab :global([data-section-index]),
    :global(html.js-anim) .ab__lede {
      opacity: 1;
      animation: none;
    }
    :global(html.js-anim) .ab__title,
    :global(html.js-anim) .ab__coda {
      filter: none;
      transform: none;
      animation: none;
    }
  }

  /* ---- Viewport basse -----------------------------------------------------
     ⚠ `--text-display` è tarato sulla LARGHEZZA (7,4vw), quindi su una
     finestra larga e bassa il titolo resta a 132px e insieme alla fascia non
     ci sta in altezza. Stessa famiglia di fix già applicata a
     `FeaturedProjects.astro` e alla hero di /portfolio: si prende l'altezza
     dal TESTO, mai dalla fascia — quella porta i quattro fatti, ed è la parte
     che questa hero esiste per far leggere. */
  @media (max-height: 46.875rem) and (min-width: 56.25rem) {
    .ab__title {
      font-size: clamp(2.75rem, 5.2vw, 5.5rem);
    }
    .ab__coda {
      font-size: clamp(1.25rem, 2.1vw, 1.75rem);
    }
    .ab__lede {
      font-size: var(--text-base);
      max-width: 60ch;
    }
  }

  .jr {
    padding-block: var(--spacing-section);
  }

  /* Stessa griglia a 12 colonne di WhatIDo e SkillsGrid, col numero d'indice
     nella colonna destra: nel sito le sezioni di CONTENUTO hanno l'indice a
     destra, gli hero lo hanno sopra il titolo. Tenere le due regole distinte è
     ciò che rende il dispositivo un sistema invece di una decorazione. */
  @media (min-width: 56.25rem) {
    .jr__wrap {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      gap: 0 clamp(1rem, 1.5vw, 2rem);
    }
    /* La cella dell'indice attraversa entrambe le righe: `position: sticky` ha
       come corsa l'altezza della propria cella, quindi limitandola alla riga
       della testata l'indice si sgancerebbe subito invece di accompagnare tutta
       la timeline. */
    .jr__idx {
      grid-column: 11 / span 2;
      grid-row: 1 / span 2;
      justify-self: end;
    }
    .jr__head {
      grid-column: 2 / span 8;
      grid-row: 1;
      margin-top: 0;
    }
    /* La timeline prende più colonne della testata: le serve larghezza per la
       colonna dell'anno più il corpo. */
    .jr__tl {
      grid-column: 2 / span 10;
      grid-row: 2;
    }
  }

  /* Su mobile indice e titolo stanno impilati: serve lo stacco. Su desktop sono
     in colonne diverse e il margine viene azzerato sopra. */
  .jr__head {
    margin-top: 1.5rem;
  }

  .jr__title {
    /* 28ch e non 22: il titolo nuovo è di 64 caratteri contro i 58 del
       precedente, e a 22ch cadeva su quattro righe con "prometto." orfana
       sull'ultima — lo stesso difetto già misurato e corretto sull'h1 della
       hero. A 28ch sta su tre righe piene a 1440. */
    max-width: 28ch;
    font-size: var(--text-h2);
    line-height: 1.05;
    letter-spacing: -0.025em;
  }

  /* La lede sotto il titolo: dice di cosa parla l'elenco che segue. */
  .jr__lede {
    margin-top: clamp(1.25rem, 2.5vw, 1.75rem);
    max-width: 52ch;
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--color-text-2);
  }
  :global(html.js-anim) .jr__lede {
    opacity: 0;
    transform: translateY(0.5rem);
    /* Entra DOPO il titolo: M1 spacca l'h2 in righe e le fa salire in ~1s
       (0,9s + stagger). Un ritardo di 0,55s la fa arrivare mentre le ultime
       righe si stanno posando, senza aspettare che finiscano del tutto —
       che sarebbe una pausa, non una sequenza. */
    transition:
      opacity 700ms var(--ease-out-expo) 550ms,
      transform 700ms var(--ease-out-expo) 550ms;
  }
  :global(html.js-anim) .jr__head.is-in .jr__lede {
    opacity: 1;
    transform: none;
  }

  /* ---- Le parole chiave della lede ---------------------------------------
     ⚠ GESTO DIVERSO da quello della fascia del metodo (`.ap__key`), che sta
     sulla STESSA pagina poco sopra: lì le parole si ACCENDONO con un alone
     che scavalca il colore finale, qui si accendono e ricevono un FILETTO
     che si tira sotto. Ripetere lo stesso effetto due volte in una pagina lo
     avrebbe fatto leggere come un tic invece che come un dispositivo.
     ⚠ E non è solo gusto: l'alone di `.ap__key` vive su un testo da 42px,
     dove un `text-shadow` sfumato si legge come luce. Qui il corpo è 16-19px
     e lo stesso alone sarebbe solo una sbavatura — a questa taglia serve un
     segno netto, non una diffusione. */
  .jr__key {
    position: relative;
    font-weight: 500;
    /* Stato finale: è anche quello del ramo senza JS e di reduced-motion. */
    color: var(--color-accent);
  }
  .jr__key::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.15em;
    height: 1px;
    background-color: var(--color-accent);
    transform-origin: left;
  }

  /* Nel ramo animato partono spente — dello stesso grigio del testo intorno,
     mai invisibili: è l'invariante di M14 (la pausa trattiene colore, non
     informazione). */
  :global(html.js-anim) .jr__key {
    color: var(--color-text-2);
    transition: color 500ms var(--ease-out-expo);
  }
  :global(html.js-anim) .jr__key::after {
    transform: scaleX(0);
    transition: transform 600ms var(--ease-out-expo);
  }
  /* ⚠ Ancorate a `is-in` con un RITARDO, non a `is-on`: è la stessa lezione
     costata un giro sulla fascia del metodo (vedi Approach.astro). Due
     soglie di scroll vicine si sovrappongono per chi scorre veloce e restano
     separate per sempre per chi si ferma; qui l'ordine deve valere sempre.
     1,35s = il reveal del titolo (~1s) più la lede che entra a 0,55s, così
     le parole si accendono su una frase già arrivata e ferma. */
  :global(html.js-anim) .jr__head.is-in .jr__key {
    color: var(--color-accent);
    transition-delay: calc(1350ms + var(--i, 0) * 180ms);
  }
  :global(html.js-anim) .jr__head.is-in .jr__key::after {
    transform: scaleX(1);
    transition-delay: calc(1350ms + var(--i, 0) * 180ms);
  }

  /* Salto d'ancora o tasto Fine: stato finale senza attesa. Deve restare DOPO
     le regole di `is-in`, che hanno la stessa specificità. */
  :global(html.js-anim) .jr__head.is-instant .jr__lede,
  :global(html.js-anim) .jr__head.is-instant .jr__key,
  :global(html.js-anim) .jr__head.is-instant .jr__key::after {
    transition-duration: 0s;
    transition-delay: 0s;
  }

  .jr__tl {
    margin-top: clamp(4rem, 8vw, 7rem);
  }
