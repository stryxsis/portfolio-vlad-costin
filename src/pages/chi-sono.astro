---
/**
 * /chi-sono
 *
 * Milestone 6: la pagina esiste per davvero (il link in navbar non è più rotto)
 * e rende i dati reali del CV attraverso Timeline e SkillsGrid.
 *
 * Arrivano nel milestone 8: l'hero a tre frame tipografici sovrapposti (§00),
 * la sezione filosofia full-bleed su fondo paper (§10) e il backstage (§40).
 * I numeri d'indice sono già distanziati per lasciare quei posti liberi.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionIndex from '../components/primitives/SectionIndex.astro';
import Timeline from '../components/primitives/Timeline.astro';
import NowPanel from '../components/primitives/NowPanel.astro';
import Approach from '../components/sections/Approach.astro';
import SkillsGrid from '../components/sections/SkillsGrid.astro';
import Portale from '../components/sections/Portale.astro';
import { TIMELINE } from '../data/timeline';
import { SITE } from '../lib/site';
---

<BaseLayout
  title="Chi sono"
  description="Vlad Costin: sviluppatore e studente di Ingegneria Informatica a Parma. Il percorso, gli strumenti, e cosa sta studiando adesso."
  ogType="profile"
>
  {/* §00 — L'h1 è candidato LCP: nessun data-split, nessun fade. Si anima solo
      la lede, che sta più in basso e non entra nel calcolo. */}
  <section class="ab" data-section id="chi-sono">
    <div class="ab__wrap">
      <SectionIndex n="00" label="Chi sono" />
      {/* ⚠ DUE REGISTRI, e la divisione NON è arbitraria: è la punteggiatura
          del testo di Vlad (2026-08-13). Sono due frasi con due lavori
          diversi — la prima è una DOMANDA rivolta a chi legge, la seconda è
          un inciso che la commenta ("Ti avviso: …"). Al corpo pieno la
          seconda è larga ~4000px contro i 1310 della colonna: andrebbe a
          capo tre volte e la domanda si perderebbe dentro il paragrafo che
          la segue. Scesa di corpo e smorzata di colore, la domanda resta il
          gesto e l'inciso resta un inciso — che è come si legge ad alta voce.
          ⚠ Resta un solo <h1>: l'inciso è parte del titolo, non un
          sottotitolo separato, quindi sta dentro e non in un <p> accanto. */}
      <h1 class="ab__title">
        Curioso di sapere<br />chi sono?<span class="ab__coda"
          >Ti avviso: faccio un sacco di cose, spesso nello stesso pomeriggio.</span
        >
      </h1>
      {/* Secondo registro della hero: a sinistra chi è (la bio in prima
          persona), a destra cosa sta facendo ADESSO. Le due cose sono
          complementari — una è il ritratto, stabile, l'altra è corrente e
          cambia spesso — quindi stanno affiancate e non impilate. */}
      <div class="ab__row">
        {/* ⚠ `bioIo` e NON `bio`: la seconda è la stringa in terza persona
            destinata alle macchine (JSON-LD, llms.txt, meta description) e
            leggerla qui significherebbe far parlare Vlad di sé al "lui".
            Vedi la nota accanto ai due campi in `lib/site.ts`. */}
        <p class="ab__lede" data-split="lines">{SITE.bioIo}</p>
        <NowPanel />
      </div>
    </div>
  </section>

  {/* La pausa fra la hero e il percorso: una frase sola, su una superficie
      diversa. Senza numero d'indice di proposito — vedi Approach.astro. */}
  <Approach />

  {/* §20 — Il percorso. Il filetto verticale della timeline sborda in basso di
      proposito: questa sezione non deve avere overflow clippato. */}
  <section class="jr" data-section id="percorso">
    <div class="jr__wrap">
      <div class="jr__idx">
        <SectionIndex n="02" label="Percorso" />
      </div>
      {/* `data-activate` sul contenitore e `data-split` sul titolo: mai sullo
          stesso elemento (vedi reveal.ts). Da qui le classi governano in CSS
          l'ingresso della lede e l'accensione delle sue parole chiave. */}
      <div class="jr__head" data-activate>
        <h2 class="jr__title" data-split="lines">
          Niente curriculum impolverati in formato europeo, te lo prometto.
        </h2>
        {/* Testo dettato da Vlad (2026-08-14), parola per parola.
            ⚠ Le parole d'accento NON sono "nottate": quella parola è già
            accesa nella fascia del metodo poco sopra, sulla stessa pagina, e
            vederla in viola due volte a mezzo schermo di distanza legge come
            una ripetizione involontaria. Marcate invece le due che dicono di
            cosa parla l'elenco. */}
        <p class="jr__lede">
          Ecco le <strong class="jr__key" style="--i: 0">tappe fondamentali</strong> – tra
          nottate passate a studiare e prime vere <strong class="jr__key" style="--i: 1"
            >vittorie sul campo</strong
          > – che mi hanno portato a essere chi sono oggi:
        </p>
      </div>
      {/* Wrapper e non `class` sul componente: vedi la nota in Timeline.astro. */}
      <div class="jr__tl">
        <Timeline entries={TIMELINE} closing />
      </div>
    </div>
  </section>

  <SkillsGrid n="03" />

  {/* La chiusura: una finestra sullo spazio che si apre scorrendo, e dentro
      le due destinazioni. Senza numero d'indice come la fascia del metodo —
      vedi Portale.astro per il perché, e per il motivo per cui NON può
      chiamarsi `.cta` (il footer legge quella classe per accendersi). */}
  <Portale />
</BaseLayout>

<style>
  .ab {
    /* ⚠ ALTA UN SCHERMO, richiesta esplicita di Vlad (2026-08-13). `min-`
       e non `height` secca: se un domani il contenuto (title + riga + i
       quattro fatti di NowPanel) diventasse più alto di una viewport corta,
       la sezione deve poter crescere invece di tagliarlo — stessa scelta
       già fatta per la fascia del globo in 404.astro.
       `grid` + `align-content: center` è la convenzione già in uso in tutto
       il sito per centrare il contenuto di una sezione a schermo intero
       (Statement, WhatIDo, JourneyTeaser, CTASection…), qui applicata a una
       pagina che non passa per un Handoff M12.
       Il padding-top riserva lo spazio della navbar fissa, che sta FUORI dal
       flusso e quindi non lo farebbe da sola.

       ⚠⚠ NIENTE `--chrome-shift` QUI DENTRO, ED È UNA REGOLA, NON UNA
       TARATURA (2026-08-14, richiesta esplicita e ripetuta di Vlad:
       «l'avviso non deve essere un elemento che influenza il sito»).
       L'avviso "cantiere aperto" è chrome `position: fixed`: sovrapporsi al
       contenuto è ciò che fa un banner, spingerlo giù no. Sommando
       `--chrome-shift` al padding, la hero si allungava di 97px alla sua
       comparsa e il corpo della pagina scendeva con lei.

       ⚠ IL TENTATIVO INTERMEDIO — tenere lo spostamento e AMMORBIDIRLO con
       una `transition` — È STATO BOCCIATO DA VLAD, giustamente: il difetto
       non era la brutalità del salto, era il salto. Una transizione lo
       rendeva solo più lento da guardare. Non riproporla.

       ⚠ E TOGLIERE IL PADDING NON BASTA DA SOLO: `.idx` è `position: sticky`
       e si àncora a `--chrome-shift` per conto proprio dentro
       SectionIndex.astro, quindi con l'avviso aperto continuava a scendere
       finché non scavalcava il titolo (misurato: `idx.bottom` 216px contro
       `h1.top` 166px). Il fix è in DUE punti — questo, e lo sticky
       disattivato qui sotto. */
    min-height: 100svh;
    display: grid;
    align-content: center;
    padding-top: calc(var(--nav-h) + clamp(1.5rem, 4vh, 3rem));
    padding-bottom: clamp(1.5rem, 4vh, 3rem);
  }

  /* ⚠ SECONDA METÀ DEL FIX QUI SOPRA, identica a quella già in `404.astro` e
     per la ragione identica. `SectionIndex` è sticky perché serve ad
     accompagnare la lettura di sezioni ALTE, che si attraversano scorrendo;
     questa hero è alta uno schermo e non si attraversa, quindi non c'è
     niente da accompagnare. Ma il suo ancoraggio (`--nav-h` +
     `--chrome-shift` + 1.5rem) con l'avviso aperto cade PIÙ IN BASSO della
     sua posizione naturale in griglia, e lo sticky lo spinge giù addosso al
     titolo. Statico, l'avviso non lo tocca più. */
  .ab :global([data-section-index]) {
    position: static;
  }

  .ab__wrap,
  .jr__wrap {
    max-width: 90rem;
    margin-inline: auto;
    padding-inline: var(--spacing-gutter);
  }

  .ab__title {
    margin-top: 1.5rem;
    /* I <br /> sono manuali perché la spezzatura è parte del testo, non un
       accidente della larghezza.
       ⚠ Qui c'era `max-width: 18ch`, tolta perché non ha MAI morso: a 132px
       di corpo 18ch valgono ~1599px, cioè più della colonna disponibile
       (1310px), quindi dichiarava un vincolo che il browser non poteva
       applicare. A tenere le righe entro misura è ora il corpo della coda,
       qui sotto — che è una lunghezza vera e verificabile. */
    font-size: var(--text-display);
    line-height: 0.9;
    letter-spacing: -0.04em;
  }

  /* Il secondo registro: l'inciso.
     ⚠ Il corpo NON è una frazione in `em` del titolo: `--text-display` si
     ferma a 132px oltre i 1440px mentre la colonna continua a crescere fino
     a 90rem, quindi un rapporto fisso starebbe largo in un punto e stretto
     in un altro. È una misura ricavata dal vincolo vero — la frase è larga
     ~29,8 volte il proprio corpo, la colonna vale circa (viewport − due
     gutter) — da cui ~2,9vw, con un tetto a 40px che a 1440 la fa stare su
     UNA riga con ~120px di margine.
     ⚠ `block` e non `inline-block`: qui non è più la terza riga di una
     strofa (dove serviva un blocco inline per non spezzarsi a metà), è un
     capoverso suo, con la propria interlinea — a 0,9 di titolo due righe di
     inciso si toccherebbero.
     ⚠ `text-2`: è ciò che lo rende un inciso invece di una seconda
     affermazione. 8,9:1 sul canvas, e comunque a 40px. */
  .ab__coda {
    display: block;
    margin-top: 0.55em;
    font-size: clamp(1.375rem, 2.9vw, 2.5rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    text-wrap: balance;
    color: var(--color-text-2);
  }

  /* La riga bio + "Adesso". Il margine che era sulla lede sta qui: è la riga
     intera a staccarsi dal titolo, non uno dei suoi due elementi. */
  .ab__row {
    margin-top: clamp(2rem, 4vw, 3rem);
    display: grid;
    gap: clamp(2.25rem, 4vw, 3.5rem);
  }

  @media (min-width: 56.25rem) {
    .ab__row {
      /* `minmax(0, …)` su entrambe: senza, una parola lunga nel pannello
         (o la misura in `ch` della lede) allargherebbe la traccia oltre la
         griglia invece di andare a capo. */
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.58fr);
      align-items: start;
    }
  }

  .ab__lede {
    max-width: 44ch;
    font-size: var(--text-lede);
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--color-text-2);
  }

  .jr {
    padding-block: var(--spacing-section);
  }

  /* Stessa griglia a 12 colonne di WhatIDo e SkillsGrid, col numero d'indice
     nella colonna destra: nel sito le sezioni di CONTENUTO hanno l'indice a
     destra, gli hero lo hanno sopra il titolo. Tenere le due regole distinte è
     ciò che rende il dispositivo un sistema invece di una decorazione. */
  @media (min-width: 56.25rem) {
    .jr__wrap {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      gap: 0 clamp(1rem, 1.5vw, 2rem);
    }
    /* La cella dell'indice attraversa entrambe le righe: `position: sticky` ha
       come corsa l'altezza della propria cella, quindi limitandola alla riga
       della testata l'indice si sgancerebbe subito invece di accompagnare tutta
       la timeline. */
    .jr__idx {
      grid-column: 11 / span 2;
      grid-row: 1 / span 2;
      justify-self: end;
    }
    .jr__head {
      grid-column: 2 / span 8;
      grid-row: 1;
      margin-top: 0;
    }
    /* La timeline prende più colonne della testata: le serve larghezza per la
       colonna dell'anno più il corpo. */
    .jr__tl {
      grid-column: 2 / span 10;
      grid-row: 2;
    }
  }

  /* Su mobile indice e titolo stanno impilati: serve lo stacco. Su desktop sono
     in colonne diverse e il margine viene azzerato sopra. */
  .jr__head {
    margin-top: 1.5rem;
  }

  .jr__title {
    /* 28ch e non 22: il titolo nuovo è di 64 caratteri contro i 58 del
       precedente, e a 22ch cadeva su quattro righe con "prometto." orfana
       sull'ultima — lo stesso difetto già misurato e corretto sull'h1 della
       hero. A 28ch sta su tre righe piene a 1440. */
    max-width: 28ch;
    font-size: var(--text-h2);
    line-height: 1.05;
    letter-spacing: -0.025em;
  }

  /* La lede sotto il titolo: dice di cosa parla l'elenco che segue. */
  .jr__lede {
    margin-top: clamp(1.25rem, 2.5vw, 1.75rem);
    max-width: 52ch;
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--color-text-2);
  }
  :global(html.js-anim) .jr__lede {
    opacity: 0;
    transform: translateY(0.5rem);
    /* Entra DOPO il titolo: M1 spacca l'h2 in righe e le fa salire in ~1s
       (0,9s + stagger). Un ritardo di 0,55s la fa arrivare mentre le ultime
       righe si stanno posando, senza aspettare che finiscano del tutto —
       che sarebbe una pausa, non una sequenza. */
    transition:
      opacity 700ms var(--ease-out-expo) 550ms,
      transform 700ms var(--ease-out-expo) 550ms;
  }
  :global(html.js-anim) .jr__head.is-in .jr__lede {
    opacity: 1;
    transform: none;
  }

  /* ---- Le parole chiave della lede ---------------------------------------
     ⚠ GESTO DIVERSO da quello della fascia del metodo (`.ap__key`), che sta
     sulla STESSA pagina poco sopra: lì le parole si ACCENDONO con un alone
     che scavalca il colore finale, qui si accendono e ricevono un FILETTO
     che si tira sotto. Ripetere lo stesso effetto due volte in una pagina lo
     avrebbe fatto leggere come un tic invece che come un dispositivo.
     ⚠ E non è solo gusto: l'alone di `.ap__key` vive su un testo da 42px,
     dove un `text-shadow` sfumato si legge come luce. Qui il corpo è 16-19px
     e lo stesso alone sarebbe solo una sbavatura — a questa taglia serve un
     segno netto, non una diffusione. */
  .jr__key {
    position: relative;
    font-weight: 500;
    /* Stato finale: è anche quello del ramo senza JS e di reduced-motion. */
    color: var(--color-accent);
  }
  .jr__key::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.15em;
    height: 1px;
    background-color: var(--color-accent);
    transform-origin: left;
  }

  /* Nel ramo animato partono spente — dello stesso grigio del testo intorno,
     mai invisibili: è l'invariante di M14 (la pausa trattiene colore, non
     informazione). */
  :global(html.js-anim) .jr__key {
    color: var(--color-text-2);
    transition: color 500ms var(--ease-out-expo);
  }
  :global(html.js-anim) .jr__key::after {
    transform: scaleX(0);
    transition: transform 600ms var(--ease-out-expo);
  }
  /* ⚠ Ancorate a `is-in` con un RITARDO, non a `is-on`: è la stessa lezione
     costata un giro sulla fascia del metodo (vedi Approach.astro). Due
     soglie di scroll vicine si sovrappongono per chi scorre veloce e restano
     separate per sempre per chi si ferma; qui l'ordine deve valere sempre.
     1,35s = il reveal del titolo (~1s) più la lede che entra a 0,55s, così
     le parole si accendono su una frase già arrivata e ferma. */
  :global(html.js-anim) .jr__head.is-in .jr__key {
    color: var(--color-accent);
    transition-delay: calc(1350ms + var(--i, 0) * 180ms);
  }
  :global(html.js-anim) .jr__head.is-in .jr__key::after {
    transform: scaleX(1);
    transition-delay: calc(1350ms + var(--i, 0) * 180ms);
  }

  /* Salto d'ancora o tasto Fine: stato finale senza attesa. Deve restare DOPO
     le regole di `is-in`, che hanno la stessa specificità. */
  :global(html.js-anim) .jr__head.is-instant .jr__lede,
  :global(html.js-anim) .jr__head.is-instant .jr__key,
  :global(html.js-anim) .jr__head.is-instant .jr__key::after {
    transition-duration: 0s;
    transition-delay: 0s;
  }

  .jr__tl {
    margin-top: clamp(4rem, 8vw, 7rem);
  }
</style>