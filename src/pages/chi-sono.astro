---
/**
 * /chi-sono
 *
 * Milestone 6: la pagina esiste per davvero (il link in navbar non è più rotto)
 * e rende i dati reali del CV attraverso Timeline e SkillsGrid.
 *
 * Arrivano nel milestone 8: l'hero a tre frame tipografici sovrapposti (§00),
 * la sezione filosofia full-bleed su fondo paper (§10) e il backstage (§40).
 * I numeri d'indice sono già distanziati per lasciare quei posti liberi.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionIndex from '../components/primitives/SectionIndex.astro';
import Timeline from '../components/primitives/Timeline.astro';
import NowPanel from '../components/primitives/NowPanel.astro';
import Approach from '../components/sections/Approach.astro';
import SkillsGrid from '../components/sections/SkillsGrid.astro';
import { TIMELINE } from '../data/timeline';
import { SITE } from '../lib/site';
---

<BaseLayout
  title="Chi sono"
  description="Vlad Costin: sviluppatore e studente di Ingegneria Informatica a Parma. Il percorso, gli strumenti, e cosa sta studiando adesso."
  ogType="profile"
>
  {/* §00 — L'h1 è candidato LCP: nessun data-split, nessun fade. Si anima solo
      la lede, che sta più in basso e non entra nel calcolo. */}
  <section class="ab" data-section id="chi-sono">
    <div class="ab__wrap">
      <SectionIndex n="00" label="Chi sono" />
      {/* ⚠ DUE REGISTRI, e la divisione NON è arbitraria: è la punteggiatura
          del testo di Vlad (2026-08-13). Sono due frasi con due lavori
          diversi — la prima è una DOMANDA rivolta a chi legge, la seconda è
          un inciso che la commenta ("Ti avviso: …"). Al corpo pieno la
          seconda è larga ~4000px contro i 1310 della colonna: andrebbe a
          capo tre volte e la domanda si perderebbe dentro il paragrafo che
          la segue. Scesa di corpo e smorzata di colore, la domanda resta il
          gesto e l'inciso resta un inciso — che è come si legge ad alta voce.
          ⚠ Resta un solo <h1>: l'inciso è parte del titolo, non un
          sottotitolo separato, quindi sta dentro e non in un <p> accanto. */}
      <h1 class="ab__title">
        Curioso di sapere<br />chi sono?<span class="ab__coda"
          >Ti avviso: faccio un sacco di cose, spesso nello stesso pomeriggio.</span
        >
      </h1>
      {/* Secondo registro della hero: a sinistra chi è (la bio in prima
          persona), a destra cosa sta facendo ADESSO. Le due cose sono
          complementari — una è il ritratto, stabile, l'altra è corrente e
          cambia spesso — quindi stanno affiancate e non impilate. */}
      <div class="ab__row">
        {/* ⚠ `bioIo` e NON `bio`: la seconda è la stringa in terza persona
            destinata alle macchine (JSON-LD, llms.txt, meta description) e
            leggerla qui significherebbe far parlare Vlad di sé al "lui".
            Vedi la nota accanto ai due campi in `lib/site.ts`. */}
        <p class="ab__lede" data-split="lines">{SITE.bioIo}</p>
        <NowPanel />
      </div>
    </div>
  </section>

  {/* La pausa fra la hero e il percorso: una frase sola, su una superficie
      diversa. Senza numero d'indice di proposito — vedi Approach.astro. */}
  <Approach />

  {/* §20 — Il percorso. Il filetto verticale della timeline sborda in basso di
      proposito: questa sezione non deve avere overflow clippato. */}
  <section class="jr" data-section id="percorso">
    <div class="jr__wrap">
      <div class="jr__idx">
        <SectionIndex n="02" label="Percorso" />
      </div>
      <div class="jr__head">
        <h2 class="jr__title" data-split="lines">
          In ordine, ma non in fila: studio e lavoro si sovrappongono.
        </h2>
      </div>
      {/* Wrapper e non `class` sul componente: vedi la nota in Timeline.astro. */}
      <div class="jr__tl">
        <Timeline entries={TIMELINE} />
      </div>
    </div>
  </section>

  <SkillsGrid n="03" />
</BaseLayout>

<style>
  .ab {
    /* ⚠ ALTA UN SCHERMO, richiesta esplicita di Vlad (2026-08-13). `min-`
       e non `height` secca: se un domani il contenuto (title + riga + i
       quattro fatti di NowPanel) diventasse più alto di una viewport corta,
       la sezione deve poter crescere invece di tagliarlo — stessa scelta
       già fatta per la fascia del globo in 404.astro.
       `grid` + `align-content: center` è la convenzione già in uso in tutto
       il sito per centrare il contenuto di una sezione a schermo intero
       (Statement, WhatIDo, JourneyTeaser, CTASection…), qui applicata a una
       pagina che non passa per un Handoff M12.
       Il padding-top resta: riserva lo spazio della navbar fissa, che sta
       FUORI dal flusso e quindi non lo farebbe da sola.

       ⚠ `--chrome-shift` VA TENUTO, e toglierlo È STATO PROVATO E SCARTATO
       (2026-08-14): senza, quando compare l'avviso "cantiere aperto" il
       padding non cresce ma `.idx` (sticky, si àncora a `--chrome-shift` per
       conto suo in SectionIndex.astro) sì — verificato via CDP: l'indice
       scivola giù fino a scavalcare il titolo, `idx.bottom` (216px) oltre
       `h1.top` (166px), overlap VERO e PERSISTENTE per tutta la durata in
       cui l'avviso resta a schermo, non un istante di transizione. Serve
       che il padding cresca CON lui.

       ⚠ QUELLO CHE MANCAVA NON ERA IL RIADATTAMENTO, ERA LA TRANSIZIONE.
       Segnalato da Vlad («quando spunta l'avviso la hero si riadatta»):
       misurato via CDP a campioni di 200ms, `padding-top` passava da 108px
       a 205px in un frame solo — zero fotogrammi intermedi, uno scatto.
       `SectionIndex.astro` anima lo stesso `--chrome-shift` con una
       `transition` sugli stessi token (`--chrome-t`/`--chrome-e`, 520ms,
       gli stessi dell'avviso che spinge la navbar): qui mancava quella
       riga, quindi la sezione saltava mentre tutto il resto — navbar,
       indice — scivolava. Aggiunta, il corpo ora si sposta in UN gesto
       coordinato con la spinta della chrome, non in uno scatto seguito da
       uno scivolamento. */
    min-height: 100svh;
    display: grid;
    align-content: center;
    padding-top: calc(var(--nav-h) + var(--chrome-shift, 0px) + clamp(1.5rem, 4vh, 3rem));
    padding-bottom: clamp(1.5rem, 4vh, 3rem);
    transition: padding-top var(--chrome-t, 0ms) var(--chrome-e, linear);
  }

  .ab__wrap,
  .jr__wrap {
    max-width: 90rem;
    margin-inline: auto;
    padding-inline: var(--spacing-gutter);
  }

  .ab__title {
    margin-top: 1.5rem;
    /* I <br /> sono manuali perché la spezzatura è parte del testo, non un
       accidente della larghezza.
       ⚠ Qui c'era `max-width: 18ch`, tolta perché non ha MAI morso: a 132px
       di corpo 18ch valgono ~1599px, cioè più della colonna disponibile
       (1310px), quindi dichiarava un vincolo che il browser non poteva
       applicare. A tenere le righe entro misura è ora il corpo della coda,
       qui sotto — che è una lunghezza vera e verificabile. */
    font-size: var(--text-display);
    line-height: 0.9;
    letter-spacing: -0.04em;
  }

  /* Il secondo registro: l'inciso.
     ⚠ Il corpo NON è una frazione in `em` del titolo: `--text-display` si
     ferma a 132px oltre i 1440px mentre la colonna continua a crescere fino
     a 90rem, quindi un rapporto fisso starebbe largo in un punto e stretto
     in un altro. È una misura ricavata dal vincolo vero — la frase è larga
     ~29,8 volte il proprio corpo, la colonna vale circa (viewport − due
     gutter) — da cui ~2,9vw, con un tetto a 40px che a 1440 la fa stare su
     UNA riga con ~120px di margine.
     ⚠ `block` e non `inline-block`: qui non è più la terza riga di una
     strofa (dove serviva un blocco inline per non spezzarsi a metà), è un
     capoverso suo, con la propria interlinea — a 0,9 di titolo due righe di
     inciso si toccherebbero.
     ⚠ `text-2`: è ciò che lo rende un inciso invece di una seconda
     affermazione. 8,9:1 sul canvas, e comunque a 40px. */
  .ab__coda {
    display: block;
    margin-top: 0.55em;
    font-size: clamp(1.375rem, 2.9vw, 2.5rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    text-wrap: balance;
    color: var(--color-text-2);
  }

  /* La riga bio + "Adesso". Il margine che era sulla lede sta qui: è la riga
     intera a staccarsi dal titolo, non uno dei suoi due elementi. */
  .ab__row {
    margin-top: clamp(2rem, 4vw, 3rem);
    display: grid;
    gap: clamp(2.25rem, 4vw, 3.5rem);
  }

  @media (min-width: 56.25rem) {
    .ab__row {
      /* `minmax(0, …)` su entrambe: senza, una parola lunga nel pannello
         (o la misura in `ch` della lede) allargherebbe la traccia oltre la
         griglia invece di andare a capo. */
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.58fr);
      align-items: start;
    }
  }

  .ab__lede {
    max-width: 44ch;
    font-size: var(--text-lede);
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--color-text-2);
  }

  .jr {
    padding-block: var(--spacing-section);
  }

  /* Stessa griglia a 12 colonne di WhatIDo e SkillsGrid, col numero d'indice
     nella colonna destra: nel sito le sezioni di CONTENUTO hanno l'indice a
     destra, gli hero lo hanno sopra il titolo. Tenere le due regole distinte è
     ciò che rende il dispositivo un sistema invece di una decorazione. */
  @media (min-width: 56.25rem) {
    .jr__wrap {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      gap: 0 clamp(1rem, 1.5vw, 2rem);
    }
    /* La cella dell'indice attraversa entrambe le righe: `position: sticky` ha
       come corsa l'altezza della propria cella, quindi limitandola alla riga
       della testata l'indice si sgancerebbe subito invece di accompagnare tutta
       la timeline. */
    .jr__idx {
      grid-column: 11 / span 2;
      grid-row: 1 / span 2;
      justify-self: end;
    }
    .jr__head {
      grid-column: 2 / span 8;
      grid-row: 1;
      margin-top: 0;
    }
    /* La timeline prende più colonne della testata: le serve larghezza per la
       colonna dell'anno più il corpo. */
    .jr__tl {
      grid-column: 2 / span 10;
      grid-row: 2;
    }
  }

  /* Su mobile indice e titolo stanno impilati: serve lo stacco. Su desktop sono
     in colonne diverse e il margine viene azzerato sopra. */
  .jr__head {
    margin-top: 1.5rem;
  }

  .jr__title {
    max-width: 22ch;
    font-size: var(--text-h2);
    line-height: 1.05;
    letter-spacing: -0.025em;
  }

  .jr__tl {
    margin-top: clamp(4rem, 8vw, 7rem);
  }
</style>