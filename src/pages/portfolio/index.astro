---
/**
 * Indice del portfolio.
 *
 * ⚠ LA PAGINA È UN HANDOFF M12, e non un elenco di sezioni impilate: Vlad ha
 * chiesto (2026-08-14) che scorrendo verso i progetti «la hero si rimpicciolisca
 * e in tanto si blurri tutto progressivamente, e la sezione sotto venga SOPRA
 * la hero — non voglio un effetto di scorrimento, voglio che sembri che la
 * sezione sotto stia andando sopra».
 *
 * Quello è esattamente il meccanismo centrale del sito: l'uscente resta
 * `position: sticky` e l'entrante, con fondo opaco, le scorre sopra
 * occludendola (vedi Handoff.astro). Il rimpicciolimento e lo spegnimento sono
 * già nel rientro M12 di stage.ts; la SFOCATURA è stata aggiunta lì come
 * opt-in (`blurOut`) proprio per questa richiesta — vedi il perché del
 * default-off accanto alla prop.
 *
 * ⚠ NIENTE `travel`: quello serve alle stage che devono svolgersi nel tempo
 * (il mazzo di §30). Qui non c'è niente da far succedere fra la hero e la
 * griglia, quindi sarebbe solo scroll morto.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Handoff from '../../components/sections/Handoff.astro';
import PortfolioHero from '../../components/sections/PortfolioHero.astro';
import SectionIndex from '../../components/primitives/SectionIndex.astro';
import ProjectCard from '../../components/primitives/ProjectCard.astro';
import { allProjects } from '../../lib/collections';

const projects = await allProjects();
---

<BaseLayout
  title="Portfolio"
  description="I lavori di Vlad Costin: case study con contesto, sfida, processo e risultato."
>
  <Handoff name="lavori" tone="canvas" blurOut>
    <PortfolioHero slot="out" href="#lavori" />

    {/* ⚠ L'entrante DEVE essere più alta di uno schermo perché l'occlusione
        avvenga mentre l'uscente è ancora incollata (il vincolo geometrico è
        scritto per esteso in Handoff.astro, e `.ho__in` lo impone con un
        `min-height: 104svh`). Con tre progetti in griglia lo è ampiamente. */}
    <section class="pf" data-section id="lavori" slot="in">
      <div class="pf__wrap">
        <div class="pf__head">
          <SectionIndex n="01" label={`Lavori · ${projects.length}`} />
          {/* h2 e non h1: l'h1 della pagina è il titolo della hero. Prima
              questa sezione portava l'h1 perché la hero non esisteva. */}
          <h2 class="pf__title">Lavori</h2>
          <p class="pf__lede" data-split="lines">
            Ogni progetto qui sotto ha una pagina che spiega il contesto, il problema,
            come l'ho affrontato e cosa è cambiato dopo. Niente slide, niente mockup finti.
          </p>
        </div>

        <ul class="pf__grid">
          {
            projects.map((p, i) => (
              <li class="pf__item" data-span={p.data.span} data-reveal>
                {/* level=3: sopra c'è l'h1 della hero e l'h2 "Lavori", quindi
                    h3 è il livello corretto e non salta nulla. */}
                <ProjectCard
                  project={p}
                  index={i + 1}
                  level={3}
                  eager={i < 2}
                  sizes="(min-width: 56.25rem) 44vw, 92vw"
                />
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </Handoff>
</BaseLayout>

<style>
  .pf {
    padding-top: calc(var(--nav-h) + clamp(3rem, 8vh, 6rem));
    padding-bottom: var(--spacing-section);
  }

  .pf__wrap {
    max-width: 90rem;
    margin-inline: auto;
    padding-inline: var(--spacing-gutter);
  }

  .pf__title {
    margin-top: 1.5rem;
    font-size: var(--text-mega);
    line-height: 0.84;
    letter-spacing: -0.045em;
  }

  .pf__lede {
    margin-top: 1.5rem;
    max-width: min(44ch, 100%);
    font-size: var(--text-lede);
    color: var(--color-text-2);
  }

  .pf__grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    margin-top: clamp(4rem, 8vw, 7rem);
    list-style: none;
    padding: 0;
  }
  @media (min-width: 56.25rem) {
    .pf__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* La geometria della cella sta qui, l'interno della card sta in
     ProjectCard.astro. `data-span` è già sul <li> ma non è ancora usato: la
     griglia non ortogonale che lo legge arriva nel milestone 8. */
  .pf__item {
    display: grid;
  }
</style>
